; All assertions are existential counterexample searches in signed 64-bit BV.
; UNSAT proves the stated property for all 2^64 argument values in this
; abstract model. "int" width/signedness and source correspondence are
; assumptions, checked separately by the source-identity gate.
(set-logic QF_BV)
(declare-const x (_ BitVec 64))
(declare-const y (_ BitVec 64))
(declare-const v (_ BitVec 64))
(declare-const lo (_ BitVec 64))
(declare-const hi (_ BitVec 64))
(declare-const w (_ BitVec 64))
(define-fun omin ((a (_ BitVec 64)) (b (_ BitVec 64))) (_ BitVec 64)
  (ite (bvslt a b) a b))
(define-fun omax ((a (_ BitVec 64)) (b (_ BitVec 64))) (_ BitVec 64)
  (ite (bvsgt a b) a b))
(define-fun oclamp ((a (_ BitVec 64)) (low (_ BitVec 64)) (high (_ BitVec 64))) (_ BitVec 64)
  (ite (bvsgt low high) low
    (ite (bvslt a low) low (ite (bvsgt a high) high a))))

; min <= each input
(push 1)
(assert (not (bvsle (omin x y) x)))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsle (omin x y) y)))
(check-sat)
(pop 1)
; min always selects one input, is commutative
(push 1)
(assert (and (distinct (omin x y) x) (distinct (omin x y) y)))
(check-sat)
(pop 1)
(push 1)
(assert (distinct (omin x y) (omin y x)))
(check-sat)
(pop 1)

; max >= each input, selects an input, is commutative
(push 1)
(assert (not (bvsge (omax x y) x)))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsge (omax x y) y)))
(check-sat)
(pop 1)
(push 1)
(assert (and (distinct (omax x y) x) (distinct (omax x y) y)))
(check-sat)
(pop 1)
(push 1)
(assert (distinct (omax x y) (omax y x)))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsle (omin x y) (omax x y))))
(check-sat)
(pop 1)

; Contract deliberately preserves the current reversed-bound policy:
; if low > high, return low (do not silently sort bounds).
(push 1)
(assert (and (bvsgt lo hi) (distinct (oclamp v lo hi) lo)))
(check-sat)
(pop 1)
; For ordered bounds, clamp returns an in-range value.
(push 1)
(assert (and (bvsle lo hi)
  (or (bvslt (oclamp v lo hi) lo) (bvsgt (oclamp v lo hi) hi))))
(check-sat)
(pop 1)
; Below, above, and inside the interval select the correct arm.
(push 1)
(assert (and (bvsle lo hi) (bvslt v lo) (distinct (oclamp v lo hi) lo)))
(check-sat)
(pop 1)
(push 1)
(assert (and (bvsle lo hi) (bvsgt v hi) (distinct (oclamp v lo hi) hi)))
(check-sat)
(pop 1)
(push 1)
(assert (and (bvsle lo hi) (bvsle lo v) (bvsle v hi)
  (distinct (oclamp v lo hi) v)))
(check-sat)
(pop 1)
; Idempotence and monotonicity (ordered bounds).
(push 1)
(assert (and (bvsle lo hi)
  (distinct (oclamp (oclamp v lo hi) lo hi) (oclamp v lo hi))))
(check-sat)
(pop 1)
(push 1)
(assert (and (bvsle lo hi) (bvsle v w)
  (bvsgt (oclamp v lo hi) (oclamp w lo hi))))
(check-sat)
(pop 1)

; Mandatory SAT negative controls: swapping min's comparison and removing
; the upper clamp must yield counterexamples.
(push 1)
(assert (distinct (ite (bvsgt x y) x y) (omin x y)))
(check-sat)
(pop 1)
(push 1)
(assert (distinct
  (ite (bvsgt lo hi) lo (ite (bvslt v lo) lo v))
  (oclamp v lo hi)))
(check-sat)
(pop 1)
