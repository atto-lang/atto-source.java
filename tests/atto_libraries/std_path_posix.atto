// flags: --target-os=linux
// expect-exit: 47
// expect-stdout-json: "usr/lib"
import module path from "atto.std/path";
import module io from "atto.std/io";
pub fnc main(): int {
  if path.join("", "leaf") != "leaf"; do return 2; fi
  if path.join("leaf", "") != "leaf"; do return 3; fi
  if path.join("", "") != ""; do return 4; fi
  io.write_str(path.join("usr", "lib"));
  if path.is_windows() || path.list_separator_code() != 58 || path.is_separator_code(92) then
    return 1;
  fi
  return path.separator_code();
}
