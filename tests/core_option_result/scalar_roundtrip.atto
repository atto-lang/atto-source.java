// Source-level guest conformance candidate (NOT YET ADMITTED BY CI).
// Import paths are relative and require the project's source module linker.
import module option from "../../core/option.atto";
import module result from "../../core/result.atto";

pub fnc main(): void {
  val Option<Option<int>> nested_some = Some(Some(40));
  val Option<int> flattened = option.flatten<int>(nested_some);
  val Result<int, int> converted = option.to_result<int, int>(flattened, 99);

  val Result<Result<int, int>, int> nested_ok = Ok(converted);
  val Result<int, int> outer = result.flatten<int, int>(nested_ok);

  val Option<Result<int, int>> transposed =
    result.transpose<int, int>(Ok(Some(2)));
  val Result<Option<int>, int> round_trip =
    option.transpose<int, int>(transposed);

  val int answer = match outer over
    on Err(_) -> 1,
    on Ok(left) -> match round_trip over
      on Err(_) -> 2,
      on Ok(None) -> 3,
      on Ok(Some(right)) -> left + right,
    end,
  end;
  stdio.println(answer);
  return;
}
