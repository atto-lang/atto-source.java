// Linked read-only native core API contract: borrowed calls must not move
// the owner, cannot manufacture an owned affine payload, and are scoped.
// Compiled Java/Truffle guest execution is REQUIRED but NOT YET VERIFIED.
import module option from "../../core/option.atto";
import module result from "../../core/result.atto";

pub fnc main(): void {
  val Option<int> some = Some(42);
  val Option<int> none = None;
  val Result<int, int> ok = Ok(7);
  val Result<int, int> err = Err(9);

  if option.is_some_borrowed<int>(borrow! some) then
    if option.is_none_borrowed<int>(borrow! none) then
      if result.is_ok_borrowed<int, int>(borrow! ok) then
        if result.is_err_borrowed<int, int>(borrow! err) then
          // The owner is still valid after the shared loan returns.
          stdio.println(some.unwrap());
          return;
        fi
      fi
    fi
  fi
  stdio.println(0);
  return;
}
