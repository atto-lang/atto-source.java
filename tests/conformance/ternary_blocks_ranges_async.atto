// Suspension-aware AttoLang value block guest conformance.
async fnc answer(): int {
  rt cooperate;
  return 42;
}

pub async fnc main(): void {
  val result: int = true ? {
    val value = await answer();
    return value
  } : {
    stdio.stdout.write("WRONG");
    return 0
  };
  // A ternary-arm return must never terminate the surrounding async fnc.
  stdio.stdout.write(result);
}
