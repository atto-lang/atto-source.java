// AttoLang guest conformance: expression-valued blocks and checked integer ranges.
pub routine main(): void {
  for id in 1..4 {
    stdio.stdout.write(id);
  }
  stdio.stdout.write("|");

  for const id in 1..=3 {
    stdio.stdout.write(id);
  }
  stdio.stdout.write("|");

  // Implicit-tail and explicit-return forms have the same branch-local
  // result; both arms are typechecked, but only the selected arm executes.
  for id in 1..4 {
    val implicit: Array<int> = id eq 3 ? {
      []
    } : {
      [id + 1]
    };
    val explicit: Array<int> = id eq 3 ? {
      return []
    } : {
      return [id + 1]
    };
  }

  val result: int = true ? {
    val base = 40;
    base + 2
  } : {
    0
  };
  stdio.stdout.write(result);
  stdio.stdout.write("|");

  val selected: int = false ? {
    stdio.stdout.write("UNSELECTED");
    0
  } : {
    val factor = 6;
    factor * 7
  };
  stdio.stdout.write(selected);
  stdio.stdout.write("|");

  val scoped: int = true ? {
    val x = 20;
    val y = 22;
    return x + y
  } : {
    return 0
  };
  stdio.stdout.write(scoped);
}
