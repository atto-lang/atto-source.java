define actor Counter as
    state { count: int = 0; }

    pub increment(): int with state.read, state.write {
        return self.handle_state(critical write |s| -> {
            s.count = s.count + 1;
            return s.count;
        });
    }

    pub read(): int with state.read {
        return self.handle_state(critical read |s| -> s.count);
    }
end
