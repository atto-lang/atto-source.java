// JVM compiler-owned Atto allocation policy state machines.
// A real guest must exercise source-owned classes; not a physical allocator.
import module heap from "atto.alloc/heap";
import module arena from "atto.alloc/arena";
import module region from "atto.alloc/region";

pub fnc main(): int {
  let mut b = heap.budget(16);
  if !b.try_reserve(6) then return 1; fi
  if !b.commit(6) then return 2; fi
  if b.used_bytes() != 6 then return 3; fi
  if b.try_reserve(11) then return 4; fi
  if !b.try_reserve(10) then return 5; fi
  if b.try_reserve(1) then return 6; fi
  if !b.cancel(10) then return 7; fi
  if !b.account_release(6) then return 8; fi
  if b.account_release(6) then return 9; fi
  if !b.seal() then return 10; fi
  if b.seal() then return 11; fi
  if !b.is_drained() then return 12; fi
  if b.try_reserve(1) then return 13; fi

  let mut a = arena.cursor(32);
  if a.try_reserve(3, 1) != 0 then return 14; fi
  if a.try_reserve(2, 8) != 8 then return 15; fi
  if a.used_bytes() != 10 then return 16; fi
  if a.try_rewind(2, 0, 0, 0) then return 17; fi
  if a.try_rewind(1, 0, 1, 0) then return 18; fi
  if !a.try_rewind(1, 0, 0, 0) then return 19; fi
  if !a.try_reset(0, 0) then return 20; fi
  if a.epoch() != 2 then return 21; fi
  if a.try_rewind(1, 0, 0, 0) then return 22; fi
  if !a.seal() then return 23; fi
  if a.try_reserve(1, 1) != -1 then return 24; fi

  let mut r = region.lifecycle(7, 1);
  if !r.belongs_to(7, 1) then return 25; fi
  if r.belongs_to(7, 2) then return 26; fi
  if r.mark_drops_complete() then return 27; fi
  if !r.request_retire() then return 28; fi
  if r.request_retire() then return 29; fi
  if !r.mark_drops_complete() then return 30; fi
  if r.try_mark_reclaimed(0, 1, 0, 0, 0, 0) then return 31; fi
  if !r.try_mark_reclaimed(0, 0, 0, 0, 0, 0) then return 32; fi
  if r.try_mark_reclaimed(0, 0, 0, 0, 0, 0) then return 33; fi
  if !r.is_reclaimed() then return 34; fi
  return 42;
}
