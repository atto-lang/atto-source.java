// Canonical Bytes guest type, independent of HTTP and host microbenchmarks.
pub fnc main(): void {
  let int checksum = 0;
  for (let int i = 0; i < 1000; i = i + 1) {
    val first = Bytes.from_string("aé");
    val second = Bytes.from_string("😀z");
    val combined = first.concat(second);
    if combined.to_utf8().unwrap() == "aé😀z"; then
      checksum = checksum + combined.size();
    fi
    first.close();
    second.close();
    combined.close();
  }
  stdio.println(checksum);
  return;
}
