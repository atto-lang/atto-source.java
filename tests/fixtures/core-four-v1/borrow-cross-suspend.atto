// Active lexical borrow cannot cross an unpinned async suspension.
import module cell from "core/cell";
define class Box as
  pub let int value = 7;
end
async fnc answer(): int { return 42; }
async fnc unsafe_hold(): int {
  val Box owner = new Box();
  val borrow Box view = rt borrow owner;
  val int result = await answer();
  return view.value + result;
}
pub fnc main(): int { return 0; }
