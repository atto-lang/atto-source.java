// expect-exit: 42
import module linked_list from "atto.alloc/linked_list.atto";

pub fnc main(): int {
  let mut list = linked_list.new_linked_list();
  if list.len() != 0; do return 1; fi
  list.push_back(10);
  list.push_front(5);
  list.push_back(10);
  list.push_back(20);
  if list.len() != 4 || list.allocated_slots() != 4; do return 2; fi
  if list.remove_first(10) == false; do return 3; fi
  if list.len() != 3 || list.contains(10) == false; do return 4; fi
  let Array<int> values = list.to_array();
  if values.size != 3; do return 5; fi
  if values.get(0) != 5 || values.get(1) != 10 || values.get(2) != 20; do return 6; fi
  list.pop_front();
  list.pop_back();
  if list.len() != 1 || list.contains(10) == false; do return 7; fi
  list.push_back(99);
  if list.allocated_slots() != 4 || list.len() != 2; do return 8; fi
  list.clear();
  if list.is_empty() == false; do return 9; fi
  list.pop_front();
  list.pop_back();
  if list.len() != 0 || list.remove_first(1) != false; do return 10; fi
  return 42;
}
