// expect-exit: 42
// Independent keyed predicate regression; baseline map guest stays unchanged.
import module map from "atto.alloc/map";

pub fnc main(): int {
  // Differing capacities, collision chains, tombstones, zero and absence.
  let mut left = map.new_map(4);
  let mut right = map.new_map(7);
  if !left.same_keys(rt borrow right) || left.has_overlap(rt borrow right) ||
     !left.overlapping_values_equal(rt borrow right); do return 12; fi
  left.try_insert(-1, 0);
  if left.overlapping_values_equal(rt borrow right); do return 13; fi
  right.try_insert(9, 0);
  if left.has_overlap(rt borrow right) || left.overlapping_values_equal(rt borrow right);
    do return 14; fi
  right.try_insert(-1, 0);
  left.try_insert(3, 20);
  if left.same_keys(rt borrow right) || !left.has_overlap(rt borrow right) ||
     !left.overlapping_values_equal(rt borrow right) ||
     !right.overlapping_values_equal(rt borrow left); do return 15; fi
  right.try_insert(-1, 1);
  if left.overlapping_values_equal(rt borrow right); do return 16; fi
  right.try_insert(3, 20);
  right.remove(9);
  if !left.same_keys(rt borrow right) || left.overlapping_values_equal(rt borrow right);
    do return 17; fi
  right.try_insert(-1, 0);
  if !left.same_keys(rt borrow right) || !left.overlapping_values_equal(rt borrow right) ||
     left.len() neq 2 || right.len() neq 2 ||
     !right.contains_entry(-1, 0) || right.contains_entry(9, 0);
    do return 18; fi
  return 42;
}
