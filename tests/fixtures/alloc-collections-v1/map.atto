// expect-exit: 42
import module map from "./map.atto";

pub fnc main(): int {
  let mut table = map.new_map(4);
  if table.len() != 0 || table.capacity() != 4; do return 1; fi
  table.try_insert(-1, 10);
  table.try_insert(3, 20);
  table.try_insert(7, 30);
  if table.len() != 3; do return 2; fi
  if table.get_or(-1, -99) != 10 || table.get_or(3, -99) != 20; do return 3; fi
  table.try_insert(3, 21);
  if table.len() != 3 || table.get_or(3, -99) != 21; do return 4; fi
  table.remove(-1);
  if table.contains_key(-1) || table.get_or(7, -99) != 30; do return 5; fi
  table.try_insert(11, 40);
  if table.get_or(11, -99) != 40 || table.len() != 3; do return 6; fi
  table.try_insert(15, 50);
  if table.len() != 4; do return 7; fi
  table.try_insert(19, 60);
  if table.len() != 4 || table.contains_key(19); do return 8; fi
  table.remove(7);
  table.try_insert(19, 60);
  if table.len() != 4 || table.get_or(19, -99) != 60; do return 9; fi
  table.clear();
  if table.len() != 0 || table.contains_key(3); do return 10; fi
  table.try_insert(-9223372036854775807, 42);
  if table.get_or(-9223372036854775807, 0) != 42; do return 11; fi
  // Differing capacities, collision chains, tombstones, zero and absence.
  let mut left = map.new_map(4);
  let mut right = map.new_map(7);
  if !left.same_keys(rt borrow right) || left.has_overlap(rt borrow right) ||
     !left.overlapping_values_equal(rt borrow right); do return 12; fi
  left.try_insert(-1, 0);
  if left.overlapping_values_equal(rt borrow right); do return 13; fi
  right.try_insert(9, 0);
  if left.has_overlap(rt borrow right) || left.overlapping_values_equal(rt borrow right);
    do return 14; fi
  right.try_insert(-1, 0);
  left.try_insert(3, 20);
  if left.same_keys(rt borrow right) || !left.has_overlap(rt borrow right) ||
     !left.overlapping_values_equal(rt borrow right) ||
     !right.overlapping_values_equal(rt borrow left); do return 15; fi
  right.try_insert(-1, 1);
  if left.overlapping_values_equal(rt borrow right); do return 16; fi
  right.try_insert(3, 20);
  right.remove(9);
  if !left.same_keys(rt borrow right) || left.overlapping_values_equal(rt borrow right);
    do return 17; fi
  right.try_insert(-1, 0);
  if !left.same_keys(rt borrow right) || !left.overlapping_values_equal(rt borrow right) ||
     left.len() neq 2 || right.len() neq 2 ||
     !right.contains_entry(-1, 0) || right.contains_entry(9, 0);
    do return 18; fi
  return 42;
}
