// Future atto test TestOutcome assertion checks. NOT_EXECUTED.
import class TestOutcome from 'ores.std/testing';
import fnc expect_equal_int, expect_in_range_int from 'ores.std/std/test_assert';

pub routine main(): void {
  val TestOutcome passed = expect_equal_int(7, 7, "equal");
  if !passed.passed; do
    rt fail("expected successful check");
  fi
  val TestOutcome failed = expect_in_range_int(9, 1, 8, "outside inclusive range");
  if failed.passed; do
    rt fail("expected failed check");
  fi
  return;
}
