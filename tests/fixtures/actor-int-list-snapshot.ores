// Compiled-source no-alias proof for the bounded List[int] state boundary.
define actor Snapshot as
    state { items: List[int] = [1, 2]; }

    pub sample(): int with state.read {
        val detached = self.handle_state(|s| -> { return s.items; });
        detached[0] = 99;
        val current = self.handle_state(|s| -> { return s.items; });
        return detached[0] * 10 + current[0];
    }

    receive(ActorMail<String> mail): void {
        stdio.println(self.sample());
        self.end();
        return;
    }
end

pub async routine main(): void {
    val worker = spawn Snapshot();
    await worker.ready;
    worker.send("read");
    await worker.done;
    return;
}
