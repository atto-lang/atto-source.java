// Source-level guest integration fixture: this is NOT an executed result.
// The host supplies an explicitly authorized absolute executable, argv, cwd.
// The public async methods deliberately omit "_async".
pub async fnc run_child_process(
    String executable, Array<String> argv, String cwd): int {
  let started = await process.spawn(executable, argv, cwd);
  if started.is_err() then return -1; fi
  let child = started.unwrap();
  let output = await child.collect_output();
  let status = await child.wait();
  if output.is_err() || status.is_err() then return -2; fi
  return status.unwrap().code;
}
