// Reject non-power-of-two, zero, and excessive alignment.
import fnc valid_alignment from "atto.alloc/allocator";
import fnc valid_layout from "atto.alloc/allocator";

pub fnc main(): int {
  return !imports::valid_alignment(0) && !imports::valid_alignment(3) &&
         !imports::valid_alignment(2097152) && !imports::valid_layout(4, 3) &&
         imports::valid_layout(4, 8) ? 42 : 1;
}
