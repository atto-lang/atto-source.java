// Reject non-power-of-two, zero, and excessive alignment.
import fnc valid_alignment from "atto.alloc/allocator";
import fnc valid_layout from "atto.alloc/allocator";

pub fnc main(): int {
  return !valid_alignment(0) && !valid_alignment(3) &&
         !valid_alignment(2097152) && !valid_layout(4, 3) &&
         valid_layout(4, 8) ? 42 : 1;
}
