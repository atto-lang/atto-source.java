// Compiled guest must consume the Atto-owned signed-key hash set.
import class IntHashSet from "atto.alloc/set";

pub fnc main(): int {
  let mut IntHashSet keys = new IntHashSet(4);
  if !keys.insert(-1) || !keys.insert(3) ||
     keys.insert(-1) || !keys.contains(3) ||
     !keys.remove(-1) || keys.contains(-1) ||
     !keys.insert(7) || !keys.contains(7) ||
     keys.len() != 2; do
    return 1;
  fi
  let mut IntHashSet other = new IntHashSet(7);
  if keys.same_members(rt borrow other) || keys.has_overlap(rt borrow other) ||
     keys.is_subset_of(rt borrow other); do return 3; fi
  other.insert(7);
  if !keys.has_overlap(rt borrow other) || keys.same_members(rt borrow other) ||
     !other.is_subset_of(rt borrow keys) || keys.is_subset_of(rt borrow other);
    do return 4; fi
  other.insert(3);
  other.insert(-1);
  other.remove(-1);
  if !keys.same_members(rt borrow other) || !other.same_members(rt borrow keys) ||
     !keys.is_subset_of(rt borrow other) || keys.len() neq 2 || other.len() neq 2;
    do return 5; fi
  if keys.intersection_size(rt borrow other) neq 2 ||
     keys.symmetric_difference_size(rt borrow other) neq 0; do return 6; fi
  other.insert(0);
  keys.insert(-9);
  if keys.intersection_size(rt borrow other) neq 2 ||
     keys.symmetric_difference_size(rt borrow other) neq 2 ||
     other.symmetric_difference_size(rt borrow keys) neq 2 ||
     keys.len() neq 3 || other.len() neq 3; do return 7; fi
  let mut IntHashSet empty = new IntHashSet(1);
  if keys.symmetric_difference_size(rt borrow empty) neq 3 ||
     empty.symmetric_difference_size(rt borrow empty) neq 0; do return 8; fi
  keys.clear();
  return keys.is_empty() && !keys.contains(7) ? 42 : 2;
}
