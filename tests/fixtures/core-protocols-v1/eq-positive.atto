import trait Eq from "ores.core/protocols";

define pub class Counter implements Eq<int> as
  pub val int value;
  pub constructor(int initial) { self.value = initial; }
  pub equals(int other): bool { return self.value == other; }
end

pub fnc main(): int {
  val Counter counter = new Counter(42);
  return counter.equals(42) ? 42 : 7;
}
