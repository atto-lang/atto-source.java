// Real Atto guest candidate: std/path, std/sync and std/telemetry.
// A source fixture is not a CI PASS; run with a linked compiler and exact SHA.
import module path from "std/path";
import module sync from "std/sync";
import module Telemetry from "std/telemetry";

pub routine main(): void {
  stdio.println(path.normalized_depth("a/./b/../c", false));
  stdio.println(path.normalized_depth("../escape", false));
  stdio.println(path.normalized_depth("a//b", false));
  stdio.println(path.normalized_depth("CON.txt", true));
  stdio.println(path.normalized_depth("C:/a", true));
  stdio.println(path.is_canonical_relative("a/b", false));
  stdio.println(path.is_canonical_relative("a/../b", false));
  stdio.println(path.is_portable_relative("safe_file/sub.dir"));
  stdio.println(sync.mutex_acquire_admissible(false, false, 0, 8));
  stdio.println(sync.mutex_acquire_admissible(true, false, 0, 8));
  stdio.println(sync.rw_read_admissible(2, false, 0, 8));
  stdio.println(sync.rw_read_admissible(2, false, 1, 8));
  stdio.println(sync.semaphore_acquire_admissible(3, 2, 5, false));
  stdio.println(sync.semaphore_release_admissible(4, 2, 5, false));
  stdio.println(sync.barrier_is_last(3, 4, false));
  stdio.println(sync.generation_successor_admissible(2147483647, 0));
  stdio.println(Telemetry.traceparent_v00_header_valid("00-0123456789abcdef0123456789abcdef-0123456789abcdef-01"));
  stdio.println(Telemetry.traceparent_v00_header_valid("00-0123456789ABCDEF0123456789abcdef-0123456789abcdef-01"));
  stdio.println(Telemetry.traceparent_v00_header_valid("00-00000000000000000000000000000000-0123456789abcdef-01"));
  stdio.println(Telemetry.traceparent_v00_header_valid("00-0123456789abcdef0123456789abcdef-0000000000000000-01"));
  // Cross-OS separator ambiguity and closed-semaphore cleanup.
  stdio.println(path.is_portable_relative("safe\\\\child"));
  stdio.println(sync.semaphore_release_admissible(3, 2, 5, true));
  // Normalized surviving component view into the original Unicode scalars.
  stdio.println(path.normalized_component_start("a/./b/../c", false, 1));
  stdio.println(path.normalized_component_length("a/./b/../c", false, 1));
  stdio.println(path.normalized_component_scalar("a/./b/../c", false, 1, 0));
  stdio.println(path.normalized_component_start("a/..", false, 0));
  stdio.println(path.file_name_start("a/./b/../c", false));
  stdio.println(path.file_name_length("archive.tar.gz", false));
  stdio.println(path.extension_start("archive.tar.gz", false));
  stdio.println(path.file_stem_length("archive.tar.gz", false));
  stdio.println(path.extension_start("files/.env", false));
  stdio.println(path.file_stem_length("files/.env", false));
  stdio.println(path.parent_depth("a/./b/../c", false));
  stdio.println(path.file_name_start("a/..", false));
  stdio.println(path.join_admissible("logs", "2026/events.json", false));
  stdio.println(path.join_admissible("logs", "../escape", false));
  stdio.println(path.join_admissible("CON", "file", true));
  stdio.println(path.normalized_component_scalar("a/./b/../c", false, 1, 1));
  stdio.println(path.is_portable_relative("a/.."));
  stdio.println(path.join_admissible("a", "b", true));
  stdio.println(sync.mutex_release_receipt_admissible(true, 8, 8, 3, 3, false));
  stdio.println(sync.mutex_release_receipt_admissible(true, 8, 9, 3, 3, false));
  stdio.println(sync.mutex_release_receipt_admissible(true, 8, 8, 3, 2, false));
  stdio.println(sync.mutex_release_receipt_admissible(true, 8, 8, 3, 3, true));
  stdio.println(sync.rw_upgrade_admissible(1, false, 0, true));
  stdio.println(sync.rw_upgrade_admissible(2, false, 0, true));
   stdio.println(path.normalized_depth("ñ/café", false));
  stdio.println(path.normalized_depth("ñ/café", true));
  stdio.println(path.is_portable_relative("ñ"));
  stdio.println(path.normalized_component_scalar("ñ/café", false, 1, 3));
  stdio.println(path.normalized_component_length("ñ/café", false, 1));
  // Immutable native Atto Path instance, no host filesystem I/O.
  val item = path.relative_path("a/./b/../c", false);
  stdio.println(item.component_count());
  stdio.println(item.component_start(1));
  stdio.println(item.component_length(1));
  stdio.println(item.component_scalar(1, 0));
  stdio.println(item.file_name_offset());
  stdio.println(item.file_name_size());
  stdio.println(item.extension_offset());
  stdio.println(item.stem_length());
  stdio.println(item.parent_component_count());
  stdio.println(item.is_canonical());
  stdio.println(item.is_portable());
  stdio.println(item.can_join("deep/file.txt"));
  val clean = path.relative_path("archive.tar.gz", true);
  stdio.println(clean.extension_offset());
  stdio.println(clean.stem_length());
  stdio.println(clean.is_canonical());
  stdio.println(clean.can_join("parts"));
  return;
}
