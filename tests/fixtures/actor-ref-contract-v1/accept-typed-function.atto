define actor Cart as
  receive(ActorMail<int> mail): void {
    self.end();
    return;
  }
end

pub fnc queue_item(ActorRef<Cart> cart): void {
  cart.send(1);
  return;
}

pub async routine main(): void {
  val cart = spawn Cart();
  await cart.get_ready();
  queue_item(cart);
  await cart.get_done();
  stdio.stdout.write("actorref-ok");
  return;
}
