// Proposed executable gate for Java/Graal actor state; NOT proven as a guest
// execution on this exact tree. Uses int scalars to avoid pretending Tensor<f64>
// or GPU-backed parameter storage is implemented.
// Golden stdout lives in tests/golden/actor_state_scalar.stdout; includes
// rejected out-of-range inputs and a rejected oversized optimizer candidate.
//
// This is a single actor performing a scalar differentiable step. Gradient
// contribution is x * upstream_gradient. Two microbatches are admitted at
// weight version 1; SGD with integer learning_rate 1 publishes weight 5,
// version 2. Gradients carry a unique microbatch identifier and step.
// It is NOT tensor autograd nor a multi-stage training proof.
//
// The only persistent guest-owned instance data is the sole state schema.
// State is NEVER accessed through self.state or an ordinary instance field.
define actor VersionedScalarStage as
    state {
        weight: int = 10;
        version: int = 1;
        accumulated_gradient: int = 0;
        pending_gradients: int = 0;
        step: int = 1;
        issued_first: bool = false;
        issued_second: bool = false;
        input_first: int = 0;
        input_second: int = 0;
        seen_first: bool = false;
        seen_second: bool = false;
    }

    // Reserve the (step, weight version, microbatch) forward context in the
    // sole actor state. This *scalar* reference computes in the short state
    // transaction; real tensor kernels must compute from a frozen pinned
    // storage snapshot OUTSIDE the loan.
    private eval_affine(int expected_step, int expected_version, int microbatch, int x): int
        with state.read, state.write
    {
        return using state.write(critical |s| -> {
            if s.version != expected_version; do
                return -1;
            fi
            if s.step != expected_step; do
                return -5;
            fi
            // Conservative 32-bit-safe domain: |weight| and |x| <= 10000.
            // Forward multiplication is therefore <= 1e8, with no mutation
            // on invalid input. The future typed Result API can replace -8.
            if x < -10000 || x > 10000 || s.weight < -10000 || s.weight > 10000; do
                return -8;
            fi
            if microbatch == 1; do
                if s.issued_first; do
                    return -7;
                fi
                s.issued_first = true;
                s.input_first = x;
                return s.weight * x;
            fi
            if microbatch == 2; do
                if s.issued_second; do
                    return -7;
                fi
                s.issued_second = true;
                s.input_second = x;
                return s.weight * x;
            fi
            return -3;
        });
    }

    // The input comes from the *saved forward context*, never the untrusted
    // backward message. No gradient can be accepted without a prior matching
    // forward, and no microbatch can contribute twice.
    private accumulate(int expected_step, int expected_version, int microbatch, int upstream): int
        with state.read, state.write
    {
        return using state.write(critical |s| -> {
            if s.version != expected_version; do
                return -1;
            fi
            if s.step != expected_step; do
                return -5;
            fi
            if microbatch != 1 && microbatch != 2; do
                return -3;
            fi
            // Both inputs were bounded during forward. Each contribution is
            // <= 1e8; two contributions cannot overflow a signed 32-bit int.
            // Reject first so neither seen bit nor gradient is consumed.
            if upstream < -10000 || upstream > 10000; do
                return -8;
            fi
            if microbatch == 1; do
                if !s.issued_first; do
                    return -6;
                fi
                if s.seen_first; do
                    return -4;
                fi
                s.seen_first = true;
                s.accumulated_gradient = s.accumulated_gradient
                    + (s.input_first * upstream);
            fi
            if microbatch == 2; do
                if !s.issued_second; do
                    return -6;
                fi
                if s.seen_second; do
                    return -4;
                fi
                s.seen_second = true;
                s.accumulated_gradient = s.accumulated_gradient
                    + (s.input_second * upstream);
            fi
            s.pending_gradients = s.pending_gradients + 1;
            return s.accumulated_gradient;
        });
    }

    // Single local state publication: compare expected version, require all
    // two uniquely identified backward contributions, update weight and version together.
    // Real tensor-backed ML must prepare independent frozen parameter buffers
    // before entering this critical write scope.
    private commit(int expected_step, int expected_version): int with state.read, state.write {
        return self.handle_state(critical write |s| -> {
            if s.version != expected_version; do
                return -1;
            fi
            if s.step != expected_step; do
                return -5;
            fi
            if s.pending_gradients != 2 || !s.issued_first || !s.issued_second || !s.seen_first || !s.seen_second; do
                return -2;
            fi
            // Version/step cannot wrap and create a stale-message ABA.
            // Bound them before the write. Both gradients sum to <= 2e8,
            // making candidate arithmetic safe for signed 32-bit int.
            if s.step >= 1000000 || s.version >= 1000000; do
                return -9;
            fi
            val int candidate_weight = s.weight - s.accumulated_gradient;
            if candidate_weight < -10000 || candidate_weight > 10000; do
                return -8;
            fi
            // All checks complete: one exclusive state transaction publishes
            // candidate weight, version, step, and cleared gradient receipts.
            s.weight = candidate_weight;
            s.accumulated_gradient = 0;
            s.pending_gradients = 0;
            s.issued_first = false;
            s.issued_second = false;
            s.input_first = 0;
            s.input_second = 0;
            s.seen_first = false;
            s.seen_second = false;
            s.step = s.step + 1;
            s.version = s.version + 1;
            return s.weight;
        });
    }

    private weight_snapshot(): int with state.read {
        return using state.read(|s| -> s.weight);
    }

    private version(): int with state.read {
        return self.handle_state(critical read |s| -> s.version);
    }

    // ActorRef callers ONLY send messages; they never invoke actor user methods.
    receive(ActorMail<String> mail): void {
        if mail.value == "orphan"; do
            stdio.println(self.accumulate(1, 1, 2, 1));
            return;
        fi
        if mail.value == "unsafe_forward"; do
            stdio.println(self.eval_affine(1, 1, 1, 10001));
            return;
        fi
        if mail.value == "forward1"; do
            stdio.println(self.eval_affine(1, 1, 1, 2));
            return;
        fi
        if mail.value == "forward_duplicate"; do
            stdio.println(self.eval_affine(1, 1, 1, 2));
            return;
        fi
        if mail.value == "forward2"; do
            stdio.println(self.eval_affine(1, 1, 2, 3));
            return;
        fi
        if mail.value == "unsafe_upstream"; do
            stdio.println(self.accumulate(1, 1, 1, 10001));
            return;
        fi
        if mail.value == "grad1"; do
            stdio.println(self.accumulate(1, 1, 1, 1));
            return;
        fi
        if mail.value == "duplicate"; do
            stdio.println(self.accumulate(1, 1, 1, 1));
            return;
        fi
        if mail.value == "early"; do
            stdio.println(self.commit(1, 1));
            return;
        fi
        if mail.value == "grad2"; do
            stdio.println(self.accumulate(1, 1, 2, 1));
            return;
        fi
        if mail.value == "commit"; do
            stdio.println(self.commit(1, 1));
            stdio.println(self.version());
            return;
        fi
        if mail.value == "stale"; do
            stdio.println(self.accumulate(1, 1, 1, 1));
            return;
        fi
        // A second step has mathematically valid individual contributions,
        // but its candidate weight would exceed the bounded safe domain.
        // Rejection must leave weight/version unchanged.
        if mail.value == "high_forward1"; do
            stdio.println(self.eval_affine(2, 2, 1, 10000));
            return;
        fi
        if mail.value == "high_forward2"; do
            stdio.println(self.eval_affine(2, 2, 2, 10000));
            return;
        fi
        if mail.value == "high_grad1"; do
            stdio.println(self.accumulate(2, 2, 1, 10000));
            return;
        fi
        if mail.value == "high_grad2"; do
            stdio.println(self.accumulate(2, 2, 2, 10000));
            return;
        fi
        if mail.value == "high_commit"; do
            stdio.println(self.commit(2, 2));
            stdio.println(self.version());
            return;
        fi
        if mail.value == "after"; do
            stdio.println(self.weight_snapshot() * 2);
            self.end();
            return;
        fi
        return;
    }
end

pub async routine main(): void {
    val worker = spawn VersionedScalarStage();
    await worker.get_ready();
    worker.send("orphan");
    worker.send("unsafe_forward");
    worker.send("forward1");
    worker.send("forward_duplicate");
    worker.send("forward2");
    worker.send("unsafe_upstream");
    worker.send("grad1");
    worker.send("duplicate");
    worker.send("early");
    worker.send("grad2");
    worker.send("commit");
    worker.send("stale");
    worker.send("high_forward1");
    worker.send("high_forward2");
    worker.send("high_grad1");
    worker.send("high_grad2");
    worker.send("high_commit");
    worker.send("after");
    await worker.get_done();
    return;
}
