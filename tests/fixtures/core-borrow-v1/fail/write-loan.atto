// atto-ownership: borrow-default-v1
// BCV1-008 write_loan fail: live read loan conflicts with exclusive call loan, NOT_EXECUTED at this head.
// expect-error: E_BORROW
define class Counter as pub mut int value = 1; end
fnc update(borrow mut Counter p): void { p.value = 42; }
pub fnc main(): int {
  val counter = new Counter();
  val view = borrow! counter;
  update(borrow! mut counter);
  return view.value;
}
