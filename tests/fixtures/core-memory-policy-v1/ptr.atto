// Real linked Atto guest: original boundary vectors, independent failure exits.
import fnc checked_span_end from "atto.core/ptr";
import fnc checked_index_offset from "atto.core/ptr";
import fnc can_split_span from "atto.core/ptr";
pub fnc main(): int {
  if imports::checked_span_end(10, 4, 6) != 10 then return 1; fi
  if imports::checked_span_end(10, 4, 7) != -1 then return 2; fi
  if imports::checked_span_end(9223372036854775807, 9223372036854775807, 0) != 9223372036854775807 then return 3; fi
  if imports::checked_span_end(-1, 0, 0) != -1 then return 4; fi
  if imports::checked_index_offset(64, 0, 8, 7, 8, 8, 8) != 56 then return 5; fi
  if imports::checked_index_offset(64, 0, 8, 8, 8, 8, 8) != -1 then return 6; fi
  if imports::checked_index_offset(64, 8, 4, 3, 8, 8, 8) != 32 then return 7; fi
  if imports::checked_index_offset(64, 1, 4, 0, 8, 8, 8) != -1 then return 8; fi
  if imports::checked_index_offset(64, 0, 4, 0, 6, 8, 4) != -1 then return 9; fi
  if imports::checked_index_offset(64, 0, 4, 0, 8, 0, 8) != -1 then return 10; fi
  if imports::checked_index_offset(64, 0, 4, 3, 32, 8, 8) != -1 then return 11; fi
  if imports::checked_index_offset(0, 0, 1, 0, 1, 1, 1) != -1 then return 12; fi
  if !imports::can_split_span(10, 4, 6, 6) then return 13; fi
  if imports::can_split_span(10, 4, 6, 7) then return 14; fi
  if imports::can_split_span(10, 6, 6, 0) then return 15; fi
  return 42;
}
