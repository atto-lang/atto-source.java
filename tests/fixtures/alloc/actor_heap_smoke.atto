import module actor_heap from "atto.alloc/actor_heap";
// Logical word-heap checks only; not proof of physical arena isolation.
pub fnc main(): int {
  let mut actor_heap.ActorHeap h = actor_heap.new_actor_heap(19, 8, 3);
  let actor_heap.HeapHandle a = h.allocate(3).unwrap();
  let actor_heap.HeapHandle b = h.allocate(4).unwrap();
  if !h.write(rt borrow a, 2, -99) || h.read(rt borrow a, 2).unwrap() != -99 ||
     h.write(rt borrow a, 3, 4); do return 1; fi
  if h.allocate(2).is_ok() || h.in_use_words() != 7; do return 2; fi
  if !h.release(rt borrow a) || h.release(rt borrow a) || h.contains(rt borrow a); do return 3; fi
  let actor_heap.HeapHandle c = h.allocate(2).unwrap();
  if c.block_index != a.block_index || c.generation == a.generation ||
     h.read(rt borrow c, 0).unwrap() != 0 || h.in_use_words() != 7; do return 4; fi
  if !h.contains(rt borrow b) || h.contains(rt borrow a); do return 5; fi
  // Equal caller-supplied incarnation and block coordinates are insufficient.
  let mut actor_heap.ActorHeap shadow = actor_heap.new_actor_heap(19, 8, 3);
  let actor_heap.HeapHandle shadow_a = shadow.allocate(3).unwrap();
  let actor_heap.HeapHandle shadow_b = shadow.allocate(4).unwrap();
  if h.contains(rt borrow shadow_b) || shadow.contains(rt borrow b) ||
     h.write(rt borrow shadow_b, 0, 42) || shadow.release(rt borrow b); do return 7; fi
  let actor_heap.HeapHandle fabricated = new actor_heap.HeapHandle(
      new actor_heap.OwnerToken(), 19, b.block_index, b.generation);
  if h.contains(rt borrow fabricated) || h.read(rt borrow fabricated, 0).is_ok() ||
     shadow.contains(rt borrow fabricated); do return 8; fi
  if !shadow.contains(rt borrow shadow_a) || !h.contains(rt borrow c); do return 9; fi
  h.close();
  if h.allocate(1).is_ok() || h.release(rt borrow b) ||
     h.in_use_words() != 0; do return 6; fi
  return 0;
}
