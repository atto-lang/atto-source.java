import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "../stdlib/testing";
import fnc expect_true, expect_false, expect_equal_bool, expect_equal_int, expect_not_equal_int, expect_equal_string, expect_not_equal_string, expect_near_float, check_int_cases, escape_machine_field, run_suite, require_success, fail from "../stdlib/testing";
fnc property_nonnegative(int value): TestOutcome {
  return expect_true(value >= 0, "unexpected negative property case");
}
fnc deterministic_property_cases_pass(): TestOutcome {
  let TestOutcome nonempty = check_int_cases("nonnegative", arr[0, 1, 2, 100], property_nonnegative);
  let TestOutcome empty = check_int_cases("empty-must-reject", arr[], property_nonnegative);
  return expect_true(nonempty.passed && !empty.passed,
    "nonempty property must pass and empty property must fail closed");
}
fnc negative_property_case_is_failure(): TestOutcome {
  val TestOutcome rejected = check_int_cases("negative", arr[-2], property_nonnegative);
  return expect_true(!rejected.passed && rejected.message != "",
    "a failing property must return an informative failing outcome");
}
fnc machine_receipt_fields_escape_delimiters(): TestOutcome {
  val String actual = escape_machine_field("a|b\nc\\d");
  return expect_equal_string(actual, "a\\u007cb\\nc\\\\d",
    "event field must escape separators, line breaks and backslashes unambiguously");
}
fnc negative_float_tolerance_does_not_pass(): TestOutcome {
  val TestOutcome result = expect_near_float(1.0, 1.0, 0.0 - 0.01,
    "negative tolerance cannot pass");
  return expect_true(!result.passed, "negative tolerance was incorrectly accepted");
}
fnc boolean_equal_true_is_a_pass(): TestOutcome {
  return expect_equal_bool(true, true, "equal booleans must pass");
}
fnc boolean_equal_mismatch_is_a_failure(): TestOutcome {
  val TestOutcome mismatch = expect_equal_bool(true, false, "different bools");
  return expect_false(mismatch.passed, "unequal booleans cannot pass");
}
fnc integer_inequality_accepts_distinct_values(): TestOutcome {
  return expect_not_equal_int(-1, 0, "distinct ints must differ");
}
fnc integer_inequality_rejects_equal_values(): TestOutcome {
  val TestOutcome outcome = expect_not_equal_int(7, 7, "same ints");
  return expect_false(outcome.passed, "equal ints cannot satisfy inequality");
}
fnc string_inequality_accepts_distinct_values(): TestOutcome {
  return expect_not_equal_string("a", "b", "distinct strings must differ");
}
fnc string_inequality_rejects_equal_values(): TestOutcome {
  val TestOutcome outcome = expect_not_equal_string("same", "same", "same strings");
  return expect_false(outcome.passed, "equal strings cannot satisfy inequality");
}
fnc float_near_boundary_is_inclusive(): TestOutcome {
  return expect_near_float(1.25, 1.0, 0.25, "tolerance boundary should be included");
}
fnc float_far_outside_tolerance_is_rejected(): TestOutcome {
  val TestOutcome outcome = expect_near_float(1.5, 1.0, 0.25, "too far");
  return expect_false(outcome.passed, "tolerance must not widen unexpectedly");
}
fnc machine_escape_distinguishes_pipe_and_literal_escape(): TestOutcome {
  return expect_not_equal_string(escape_machine_field("|"), escape_machine_field("\\u007c"),
    "escaped pipe and literal escape must never collide");
}
fnc machine_escape_cr_and_tab(): TestOutcome {
  return expect_equal_string(escape_machine_field("a\rb\tc"), "a\\rb\\tc",
    "CR and tab must not inject machine record boundaries");
}
fnc failing_property_retains_first_error(): TestOutcome {
  val TestOutcome result = check_int_cases("nonnegative", arr[-1, 0], property_nonnegative);
  return expect_equal_string(result.message, "unexpected negative property case",
    "failing property should preserve first diagnostic");
}
fnc repeated_property_inputs_are_not_an_empty_vacuous_pass(): TestOutcome {
  return check_int_cases("duplicates", arr[0, 0, 1, 1], property_nonnegative);
}
fnc negative_i64_boundary_is_exact(): TestOutcome {
  val int minimum = -9223372036854775807 - 1;
  return expect_equal_int(minimum + 1, -9223372036854775807,
    "i64 minimum successor must be exact");
}
fnc i64_above_binary64_mantissa_is_exact(): TestOutcome {
  return expect_equal_int(9007199254740993 - 9007199254740992, 1,
    "native integer arithmetic must not silently round through double");
}

fnc property_fails_without_message(int value): TestOutcome {
  return fail("");
}
fnc empty_property_reports_its_name(): TestOutcome {
  val TestOutcome outcome = check_int_cases("empty-input", arr[], property_nonnegative);
  return expect_equal_string(outcome.message, "property has no cases: empty-input",
    "empty property must produce a named diagnostic");
}
fnc property_empty_diagnostic_has_fallback(): TestOutcome {
  val TestOutcome outcome = check_int_cases("silent-failure", arr[5], property_fails_without_message);
  return expect_equal_string(outcome.message, "property failed: silent-failure",
    "silent property failure must receive a named diagnostic");
}
fnc false_assertion_rejects_true(): TestOutcome {
  val TestOutcome outcome = expect_false(true, "true is not false");
  return expect_false(outcome.passed, "expect_false must reject true");
}
fnc integer_equality_rejects_mismatch(): TestOutcome {
  val TestOutcome outcome = expect_equal_int(0, 1, "different ints");
  return expect_false(outcome.passed, "integer equality must reject different values");
}
fnc string_equality_rejects_mismatch(): TestOutcome {
  val TestOutcome outcome = expect_equal_string("left", "right", "different strings");
  return expect_false(outcome.passed, "string equality must reject different values");
}
fnc machine_newline_differs_from_literal_escape(): TestOutcome {
  return expect_not_equal_string(escape_machine_field("\n"), escape_machine_field("\\n"),
    "raw newline and literal backslash-n must never collapse");
}
fnc machine_escape_repeated_pipes(): TestOutcome {
  return expect_equal_string(escape_machine_field("a||b"), "a\\u007c\\u007cb",
    "adjacent separators must each be escaped");
}
fnc float_exact_zero_tolerance_passes(): TestOutcome {
  return expect_near_float(-3.25, -3.25, 0.0,
    "exactly equal finite floats must pass zero tolerance");
}
fnc boolean_false_equality_passes(): TestOutcome {
  return expect_equal_bool(false, false, "false equals false");
}
fnc machine_empty_field_stays_empty(): TestOutcome {
  return expect_equal_string(escape_machine_field(""), "",
    "empty receipt field must not gain bytes");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("native-testing-core", arr[
    new TestCase("empty_property_reports_its_name", empty_property_reports_its_name, false, ""),
    new TestCase("property_empty_diagnostic_has_fallback", property_empty_diagnostic_has_fallback, false, ""),
    new TestCase("false_assertion_rejects_true", false_assertion_rejects_true, false, ""),
    new TestCase("integer_equality_rejects_mismatch", integer_equality_rejects_mismatch, false, ""),
    new TestCase("string_equality_rejects_mismatch", string_equality_rejects_mismatch, false, ""),
    new TestCase("machine_newline_differs_from_literal_escape", machine_newline_differs_from_literal_escape, false, ""),
    new TestCase("machine_escape_repeated_pipes", machine_escape_repeated_pipes, false, ""),
    new TestCase("float_exact_zero_tolerance_passes", float_exact_zero_tolerance_passes, false, ""),
    new TestCase("boolean_false_equality_passes", boolean_false_equality_passes, false, ""),
    new TestCase("machine_empty_field_stays_empty", machine_empty_field_stays_empty, false, ""),
    new TestCase("deterministic_property_cases_pass", deterministic_property_cases_pass, false, ""),
    new TestCase("negative_property_case_is_failure", negative_property_case_is_failure, false, ""),
    new TestCase("machine_receipt_fields_escape_delimiters", machine_receipt_fields_escape_delimiters, false, ""),
    new TestCase("negative_float_tolerance_does_not_pass", negative_float_tolerance_does_not_pass, false, ""),
    new TestCase("boolean_equal_true_is_a_pass", boolean_equal_true_is_a_pass, false, ""),
    new TestCase("boolean_equal_mismatch_is_a_failure", boolean_equal_mismatch_is_a_failure, false, ""),
    new TestCase("integer_inequality_accepts_distinct_values", integer_inequality_accepts_distinct_values, false, ""),
    new TestCase("integer_inequality_rejects_equal_values", integer_inequality_rejects_equal_values, false, ""),
    new TestCase("string_inequality_accepts_distinct_values", string_inequality_accepts_distinct_values, false, ""),
    new TestCase("string_inequality_rejects_equal_values", string_inequality_rejects_equal_values, false, ""),
    new TestCase("float_near_boundary_is_inclusive", float_near_boundary_is_inclusive, false, ""),
    new TestCase("float_far_outside_tolerance_is_rejected", float_far_outside_tolerance_is_rejected, false, ""),
    new TestCase("machine_escape_distinguishes_pipe_and_literal_escape", machine_escape_distinguishes_pipe_and_literal_escape, false, ""),
    new TestCase("machine_escape_cr_and_tab", machine_escape_cr_and_tab, false, ""),
    new TestCase("failing_property_retains_first_error", failing_property_retains_first_error, false, ""),
    new TestCase("repeated_property_inputs_are_not_an_empty_vacuous_pass", repeated_property_inputs_are_not_an_empty_vacuous_pass, false, ""),
    new TestCase("negative_i64_boundary_is_exact", negative_i64_boundary_is_exact, false, ""),
    new TestCase("i64_above_binary64_mantissa_is_exact", i64_above_binary64_mantissa_is_exact, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
