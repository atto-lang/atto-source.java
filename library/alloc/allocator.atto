// alloc/allocator -- backend-owned, checked allocation layout policy in Atto.
// This module does NOT fabricate pointers, receipts, allocator authority or
// successful physical allocations. The compiler/runtime owns those operations.
// Arithmetic is bounded before additions/multiplications to avoid overflow.
use namespace atto_alloc_allocator;

pub fnc valid_alignment(int alignment): bool {
  return alignment > 0 && alignment <= 1048576 &&
         (alignment & (alignment - 1)) == 0;
}

pub fnc valid_layout(int bytes, int alignment): bool {
  return bytes >= 0 && valid_alignment(alignment);
}

// -1 means invalid, overflowing or out of bounds. The returned offset is
// logical only. Zero-size requests do not advance or align the cursor.
pub fnc aligned_start(int offset, int bytes, int alignment,
                      int limit): int {
  if offset < 0 || bytes < 0 || limit < 0 || offset > limit ||
     !valid_alignment(alignment); do
    return -1;
  fi
  if bytes == 0; do
    return offset;
  fi
  let int remainder = offset - (offset / alignment) * alignment;
  let mut int padding = 0;
  if remainder != 0; do
    padding = alignment - remainder;
  fi
  if padding > limit - offset; do
    return -1;
  fi
  let int start = offset + padding;
  if bytes > limit - start; do
    return -1;
  fi
  return start;
}

pub fnc aligned_end(int offset, int bytes, int alignment,
                    int limit): int {
  let int start = aligned_start(offset, bytes, alignment, limit);
  if start < 0; do
    return -1;
  fi
  return start + bytes;
}

// Total byte length of count densely packed elements; zero-sized elements
// contribute zero physical bytes but still need compiler-owned identity.
pub fnc array_bytes(int element_bytes, int count, int limit): int {
  if element_bytes < 0 || count < 0 || limit < 0; do
    return -1;
  fi
  if element_bytes == 0 || count == 0; do
    return 0;
  fi
  if count > limit / element_bytes; do
    return -1;
  fi
  return count * element_bytes;
}

// Byte stride is size rounded up to the element's alignment, with no
// overflow. A separate provider decides whether to allocate it.
pub fnc aligned_stride(int element_bytes, int alignment,
                       int limit): int {
  if !valid_layout(element_bytes, alignment) || limit < 0; do
    return -1;
  fi
  if element_bytes == 0; do
    return 0;
  fi
  let int remainder = element_bytes -
                        (element_bytes / alignment) * alignment;
  let mut int padding = 0;
  if remainder != 0; do
    padding = alignment - remainder;
  fi
  if element_bytes > limit || padding > limit - element_bytes; do
    return -1;
  fi
  return element_bytes + padding;
}

define pub class Layout as
  pub val int bytes;
  pub val int alignment;

  pub constructor(int bytes, int alignment) {
    if !valid_layout(bytes, alignment); do
      rt fail("alloc/allocator: invalid layout");
    fi
    self.bytes = bytes;
    self.alignment = alignment;
  }

  pub is_empty(): bool { return self.bytes == 0; }

  pub end_after(int cursor, int quota): int {
    return aligned_end(cursor, self.bytes, self.alignment, quota);
  }

  pub stride(int quota): int {
    if quota < 0; do
      return -1;
    fi
    if self.bytes == 0; do
      return 0;
    fi
    let int remainder = self.bytes -
                         (self.bytes / self.alignment) * self.alignment;
    if remainder == 0; do
      if self.bytes > quota; do return -1; fi
      return self.bytes;
    fi
    let int padding = self.alignment - remainder;
    if self.bytes > quota || padding > quota - self.bytes; do
      return -1;
    fi
    return self.bytes + padding;
  }

  pub array_span(int count, int quota): int {
    if count < 0 || quota < 0; do return -1; fi
    if count == 0; do return 0; fi
    let int step = self.stride(quota);
    if step < 0; do return -1; fi
    return array_bytes(step, count, quota);
  }
end

pub fnc layout(int bytes, int alignment): Layout {
  return new Layout(bytes, alignment);
}

// Owner-local allocation bookkeeping. This is NOT physical allocator
// authority: no public integer ticket may cause raw memory access or free.
// The trusted allocator must authenticate its own opaque receipt, then update
// the Atto ledger only AFTER successful allocation/destruction.
define pub class Reservation as
  pub val int slot;
  pub val int generation;
  pub val int bytes;

  pub constructor(int slot, int generation, int bytes) {
    self.slot = slot;
    self.generation = generation;
    self.bytes = bytes;
  }

  pub is_valid(): bool {
    return self.slot >= 0 && self.generation > 0 && self.bytes > 0;
  }
end

// 0=empty, 1=reserved, 2=allocated, 3=retirement pending, 4=exhausted.
// Generation increases on every cancelled/freed slot; no wrapping/reuse at
// INT_MAX. A failed physical allocation must cancel, never report success.
define pub class ReservationLedger as
  let int limit;
  let int quota;
  let mut Array<int> states = new Array<int>();
  let mut Array<int> generations = new Array<int>();
  let mut Array<int> sizes = new Array<int>();
  let mut int pending = 0;
  let mut int live = 0;
  let mut int owners = 0;
  let mut bool sealed = false;

  pub constructor(int capacity, int budget) {
    if capacity < 1 || capacity > 4096 || budget < 0; do
      rt fail("alloc/allocator: invalid reservation capacity or budget");
    fi
    self.limit = capacity;
    self.quota = budget;
    for (let int i = 0; i < capacity; i = i + 1) do
      self.states.add(0);
      self.generations.add(1);
      self.sizes.add(0);
    done
  }

  matches(Reservation ticket, int state): bool {
    if !ticket.is_valid() || ticket.slot >= self.limit; do
      return false;
    fi
    return self.states.get(ticket.slot) == state &&
           self.generations.get(ticket.slot) == ticket.generation &&
           self.sizes.get(ticket.slot) == ticket.bytes;
  }

  retire_slot(mut self)(Reservation ticket): void {
    let int slot = ticket.slot;
    let int generation = self.generations.get(slot);
    self.sizes.set(slot, 0);
    if generation >= 2147483647; do
      self.states.set(slot, 4);
    else
      self.generations.set(slot, generation + 1);
      self.states.set(slot, 0);
    fi
    return;
  }

  // Invalid (-1,0,0) means quota exhausted, no free slot or sealed ledger.
  // Zero-sized layouts need separate trusted identity; never mint one here.
  pub reserve(mut self)(int bytes): Reservation {
    if self.sealed || bytes <= 0 || self.live > self.quota ||
       self.pending > self.quota - self.live ||
       bytes > self.quota - self.live - self.pending; do
      return new Reservation(-1, 0, 0);
    fi
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) == 0; do
        self.states.set(i, 1);
        self.sizes.set(i, bytes);
        self.pending = self.pending + bytes;
        return new Reservation(i, self.generations.get(i), bytes);
      fi
    done
    return new Reservation(-1, 0, 0);
  }

  // Trusted provider only, AFTER a physical allocation succeeded.
  pub record_commit(mut self)(Reservation ticket): bool {
    if !self.matches(ticket, 1); do return false; fi
    self.states.set(ticket.slot, 2);
    self.pending = self.pending - ticket.bytes;
    self.live = self.live + ticket.bytes;
    self.owners = self.owners + 1;
    return true;
  }

  // Trusted provider only, AFTER physical allocation failed.
  pub record_cancel(mut self)(Reservation ticket): bool {
    if !self.matches(ticket, 1); do return false; fi
    self.pending = self.pending - ticket.bytes;
    self.retire_slot(ticket);
    return true;
  }

  // A real provider must separately prove that no borrow or continuation
  // survives before entering destructor/deallocation.
  pub begin_retirement(mut self)(Reservation ticket): bool {
    if !self.matches(ticket, 2); do return false; fi
    self.states.set(ticket.slot, 3);
    return true;
  }

  // Trusted provider only, AFTER T's destructor AND free have completed.
  // Failure must leave state=3 pending; it may not reuse the storage.
  pub finish_retirement(mut self)(Reservation ticket): bool {
    if !self.matches(ticket, 3); do return false; fi
    self.live = self.live - ticket.bytes;
    self.owners = self.owners - 1;
    self.retire_slot(ticket);
    return true;
  }

  pub seal(mut self)(): bool {
    if self.sealed; do return false; fi
    self.sealed = true;
    return true;
  }

  pub pending_bytes(): int { return self.pending; }
  pub used_bytes(): int { return self.live; }
  pub active(): int { return self.owners; }
  pub capacity(): int { return self.limit; }
  pub is_sealed(): bool { return self.sealed; }
  pub is_drained(): bool {
    return self.sealed && self.pending == 0 &&
           self.live == 0 && self.owners == 0;
  }
end

pub fnc reservation_ledger(int capacity, int budget): ReservationLedger {
  return new ReservationLedger(capacity, budget);
}

pub fnc reservation_self_test(): bool {
  let mut ReservationLedger book = new ReservationLedger(2, 12);
  let Reservation first = book.reserve(8);
  if !first.is_valid() || first.slot != 0 || book.pending_bytes() != 8 ||
     book.reserve(5).is_valid() || !book.record_commit(first) ||
     book.record_commit(first) || book.used_bytes() != 8 ||
     book.pending_bytes() != 0; do
    return false;
  fi
  let Reservation temp = book.reserve(4);
  if !temp.is_valid() || book.reserve(1).is_valid() ||
     !book.record_cancel(temp) || book.record_cancel(temp) ||
     book.record_commit(temp) || book.pending_bytes() != 0; do
    return false;
  fi
  let Reservation reused = book.reserve(4);
  if !reused.is_valid() || reused.slot != temp.slot ||
     reused.generation != temp.generation + 1 ||
     book.record_cancel(temp) || !book.record_commit(reused) ||
     book.active() != 2 || book.reserve(1).is_valid(); do
    return false;
  fi
  if !book.begin_retirement(reused) || book.begin_retirement(reused) ||
     book.finish_retirement(first) || book.used_bytes() != 12; do
    return false;
  fi
  if !book.finish_retirement(reused) || book.finish_retirement(reused) ||
     book.used_bytes() != 8 || !book.begin_retirement(first) ||
     !book.seal() || book.reserve(1).is_valid() ||
     book.is_drained() || !book.finish_retirement(first); do
    return false;
  fi
  return book.is_drained() && book.active() == 0 &&
         book.used_bytes() == 0 && book.pending_bytes() == 0;
}

pub fnc self_test(): bool {
  let Layout word = new Layout(3, 4);
  if !valid_alignment(4) || valid_alignment(3) ||
     valid_layout(-1, 8) || word.stride(12) != 4 ||
     word.array_span(3, 12) != 12 ||
     word.array_span(4, 12) != -1 ||
     word.array_span(0, 0) != 0; do
    return false;
  fi
  if aligned_start(3, 4, 4, 8) != 4 ||
     aligned_end(3, 4, 4, 8) != 8 ||
     aligned_start(7, 2, 8, 8) != -1 ||
     aligned_start(3, 0, 8, 8) != 3; do
    return false;
  fi
  return reservation_self_test() && array_bytes(4, 3, 12) == 12 &&
         array_bytes(4, 4, 12) == -1 &&
         array_bytes(0, 100, 0) == 0 &&
         aligned_end(2147483646, 4, 8, 2147483647) == -1;
}
