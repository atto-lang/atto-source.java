// alloc/set -- bounded integer-key set implemented entirely in Atto.
// Explicit dense key domain [0, domain_size); no hashing, host collections,
// fabricated generic Hash/Eq capabilities or uncontrolled resizing.
// Owner-local Array<int> storage; no implicit Send/Sync or actor transfer.
use namespace atto_alloc_set;

define pub class BoundedIntSet as
  let int domain;
  let mut Array<int> flags = new Array<int>();
  let mut int members = 0;

  pub constructor(int domain_size) {
    if domain_size < 1 || domain_size > 65536; do
      rt fail("alloc/set: domain must be 1..65536");
    fi
    self.domain = domain_size;
    for (let int i = 0; i < domain_size; i = i + 1) do
      self.flags.add(0);
    done
  }

  pub capacity(): int { return self.domain; }
  pub len(): int { return self.members; }
  pub is_empty(): bool { return self.members == 0; }

  pub contains(int key): bool {
    if key < 0 || key >= self.domain; do return false; fi
    return self.flags.get(key) == 1;
  }

  // True only on a new insertion. Invalid/out-of-range keys fail closed.
  pub insert(mut self)(int key): bool {
    if key < 0 || key >= self.domain || self.flags.get(key) != 0; do
      return false;
    fi
    self.flags.set(key, 1);
    self.members = self.members + 1;
    return true;
  }

  // True only when an existing member is removed.
  pub remove(mut self)(int key): bool {
    if key < 0 || key >= self.domain || self.flags.get(key) == 0; do
      return false;
    fi
    self.flags.set(key, 0);
    self.members = self.members - 1;
    return true;
  }

  pub clear(mut self)(): void {
    for (let int i = 0; i < self.domain; i = i + 1) do
      self.flags.set(i, 0);
    done
    self.members = 0;
    return;
  }

  // Return the least present key >= start, or -1. Useful for deterministic
  // enumeration without returning mutable aliases into backing storage.
  pub next_from(int start): int {
    if start < 0; do return -1; fi
    for (let int i = start; i < self.domain; i = i + 1) do
      if self.flags.get(i) == 1; do return i; fi
    done
    return -1;
  }

  // Membership predicates ignore unused domain capacity. Keep the existing
  // same-domain contract of the in-place operations below unchanged.
  pub same_members(borrow BoundedIntSet other): bool {
    if self.members neq other.len(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.flags.get(i) eq 1 && !other.contains(i); do return false; fi
    done
    return true;
  }

  pub has_overlap(borrow BoundedIntSet other): bool {
    if self.members eq 0 || other.is_empty(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.flags.get(i) eq 1 && other.contains(i); do return true; fi
    done
    return false;
  }

  // Nonmutating set algebra. The result has fresh owned slots, uses the
  // maximum input domain, and cannot alias either input backing array.
  // 0 union, 1 intersection, 2 difference, 3 symmetric difference.
  combine(borrow BoundedIntSet other, int operation): BoundedIntSet {
    let mut int domain_size = self.domain;
    if other.capacity() > domain_size; do domain_size = other.capacity(); fi
    let mut BoundedIntSet result = new BoundedIntSet(domain_size);
    for (let int i = 0; i < domain_size; i = i + 1) do
      let bool a = self.contains(i);
      let bool b = other.contains(i);
      let bool include = (operation eq 0 && (a || b)) ||
                         (operation eq 1 && a && b) ||
                         (operation eq 2 && a && !b) ||
                         (operation eq 3 && (a ^^ b));
      if include; do result.insert(i); fi
    done
    return result;
  }

  pub union(borrow BoundedIntSet other): BoundedIntSet {
    let BoundedIntSet result = self.combine(rt borrow other, 0);
    return result;
  }

  pub intersection(borrow BoundedIntSet other): BoundedIntSet {
    let BoundedIntSet result = self.combine(rt borrow other, 1);
    return result;
  }

  pub difference(borrow BoundedIntSet other): BoundedIntSet {
    let BoundedIntSet result = self.combine(rt borrow other, 2);
    return result;
  }

  pub symmetric_difference(borrow BoundedIntSet other): BoundedIntSet {
    let BoundedIntSet result = self.combine(rt borrow other, 3);
    return result;
  }

  // All binary operations require identical domains; a mismatch causes no
  // mutation. Callers must not create overlapping mutable/immutable loans.
  pub union_from(mut self)(borrow BoundedIntSet other): bool {
    if self.domain != other.capacity(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if other.contains(i) && self.flags.get(i) == 0; do
        self.flags.set(i, 1);
        self.members = self.members + 1;
      fi
    done
    return true;
  }

  pub intersect_from(mut self)(borrow BoundedIntSet other): bool {
    if self.domain != other.capacity(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.flags.get(i) == 1 && !other.contains(i); do
        self.flags.set(i, 0);
        self.members = self.members - 1;
      fi
    done
    return true;
  }

  pub subtract_from(mut self)(borrow BoundedIntSet other): bool {
    if self.domain != other.capacity(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.flags.get(i) == 1 && other.contains(i); do
        self.flags.set(i, 0);
        self.members = self.members - 1;
      fi
    done
    return true;
  }

  // Explicit in-place set XOR. Incompatible domains leave receiver intact.
  // Logical size is maintained on each transition; no temporary allocation.
  pub symmetric_difference_from(mut self)(borrow BoundedIntSet other): bool {
    if self.domain neq other.capacity(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if other.contains(i); do
        if self.flags.get(i) eq 1; do
          self.flags.set(i, 0);
          self.members = self.members - 1;
        else
          self.flags.set(i, 1);
          self.members = self.members + 1;
        fi
      fi
    done
    return true;
  }

  // Non-mutating XOR: a new bounded owner, never a view into either input.
  // The domain mismatch is rejected before allocation. Physical allocation
  // failure follows the existing alloc provider contract; no partial result.
  pub symmetric_difference(borrow BoundedIntSet other): BoundedIntSet {
    if self.domain neq other.capacity(); do
      rt fail("alloc/set: symmetric difference domain mismatch");
    fi
    let mut BoundedIntSet result = new BoundedIntSet(self.domain);
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.contains(i) neq other.contains(i); do
        if !result.insert(i); do rt fail("alloc/set: inconsistent fresh set"); fi
      fi
    done
    return result;
  }

  pub is_subset_of(borrow BoundedIntSet other): bool {
    if self.domain != other.capacity(); do return false; fi
    for (let int i = 0; i < self.domain; i = i + 1) do
      if self.flags.get(i) == 1 && !other.contains(i); do
        return false;
      fi
    done
    return true;
  }
end

// A real, bounded open-addressed Set of arbitrary *signed integer* keys.
// No generic Hash/Eq or cross-thread sharing is inferred from this class.
// States: 0=empty, 1=live, 2=tombstone.
define pub class IntHashSet as
  let int limit;
  let mut Array<int> states = new Array<int>();
  let mut Array<int> keys = new Array<int>();
  let mut int count = 0;
  let mut int tombs = 0;

  pub constructor(int capacity) {
    if capacity < 1 || capacity > 65536; do
      rt fail("alloc/set: hash capacity must be 1..65536");
    fi
    self.limit = capacity;
    for (let int i = 0; i < capacity; i = i + 1) do
      self.states.add(0);
      self.keys.add(0);
    done
  }

  home(int key): int {
    // Signed remainder is bounded by capacity-1; correction cannot overflow.
    let int remainder = Integer.rem(key, self.limit);
    if remainder < 0; do return remainder + self.limit; fi
    return remainder;
  }

  pub capacity(): int { return self.limit; }
  pub len(): int { return self.count; }
  pub tombstones(): int { return self.tombs; }
  pub is_empty(): bool { return self.count == 0; }

  pub contains(int key): bool {
    let int start = self.home(key);
    for (let int step = 0; step < self.limit; step = step + 1) do
      let mut int pos = start + step;
      if pos >= self.limit; do pos = pos - self.limit; fi
      let int state = self.states.get(pos);
      if state == 0; do return false; fi
      if state == 1 && self.keys.get(pos) == key; do return true; fi
    done
    return false;
  }

  // Read-only membership comparisons, independent of capacity and probe order.
  pub same_members(borrow IntHashSet other): bool {
    if self.count neq other.len(); do return false; fi
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) eq 1 && !other.contains(self.keys.get(i)); do
        return false;
      fi
    done
    return true;
  }

  pub has_overlap(borrow IntHashSet other): bool {
    if self.count eq 0 || other.is_empty(); do return false; fi
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) eq 1 && other.contains(self.keys.get(i)); do return true; fi
    done
    return false;
  }

  pub is_subset_of(borrow IntHashSet other): bool {
    if self.count > other.len(); do return false; fi
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) eq 1 && !other.contains(self.keys.get(i)); do return false; fi
    done
    return true;
  }

  // Count membership XOR without materializing either set. Scan the receiver's
  // bounded capacity; public API never reveals slot layout.
  // Both capacities are <= 65536, so the scalar sum cannot overflow.
  pub intersection_size(borrow IntHashSet other): int {
    let mut int matched = 0;
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) eq 1 && other.contains(self.keys.get(i)); do
        matched = matched + 1;
      fi
    done
    return matched;
  }

  pub symmetric_difference_size(borrow IntHashSet other): int {
    let int shared = self.intersection_size(rt borrow other);
    return self.count + other.len() - 2 * shared;
  }

  // A caller may choose a result capacity within the existing bounded
  // allocation profile. Reject impossible cardinality before creating
  // any result storage. Inputs are borrowed, never modified.
  pub symmetric_difference_with_capacity(borrow IntHashSet other, int capacity): IntHashSet {
    // Reject nonsensical bounds before even scanning the operands.
    if capacity < 1 || capacity > 65536; do
      rt fail("alloc/set: symmetric difference capacity exceeded");
    fi
    let int required = self.symmetric_difference_size(rt borrow other);
    return self.materialize_xor(rt borrow other, capacity, required);
  }

  // Private helper accepts only the cardinality computed by the checked
  // public entry points. Do not repeat the potentially costly intersection.
  materialize_xor(borrow IntHashSet other, int capacity, int required): IntHashSet {
    if capacity < 1 || capacity > 65536 || required < 0 || required > capacity; do
      rt fail("alloc/set: symmetric difference capacity exceeded");
    fi
    let mut IntHashSet result = new IntHashSet(capacity);
    for (let int i = 0; i < self.limit; i = i + 1) do
      if self.states.get(i) eq 1; do
        let int key = self.keys.get(i);
        if !other.contains(key); do
          if !result.insert(key); do rt fail("alloc/set: inconsistent fresh hash set"); fi
        fi
      fi
    done
    for (let int i = 0; i < other.capacity(); i = i + 1) do
      if other.states.get(i) eq 1; do
        let int key = other.keys.get(i);
        if !self.contains(key); do
          if !result.insert(key); do rt fail("alloc/set: inconsistent fresh hash set"); fi
        fi
      fi
    done
    if result.len() neq required; do rt fail("alloc/set: inconsistent hash set cardinality"); fi
    return result;
  }

  // Retain at least the greater input capacity when possible, but never
  // shrink the requested capacity below the actual XOR cardinality.
  pub symmetric_difference(borrow IntHashSet other): IntHashSet {
    let mut int capacity = self.limit;
    if other.capacity() > capacity; do capacity = other.capacity(); fi
    let int required = self.symmetric_difference_size(rt borrow other);
    if required > capacity; do capacity = required; fi
    return self.materialize_xor(rt borrow other, capacity, required);
  }

  // Full probe first: a tombstone can precede a duplicate key.
  pub insert(mut self)(int key): bool {
    if self.count >= self.limit; do return false; fi
    let int start = self.home(key);
    let mut int tomb = -1;
    for (let int step = 0; step < self.limit; step = step + 1) do
      let mut int pos = start + step;
      if pos >= self.limit; do pos = pos - self.limit; fi
      let int state = self.states.get(pos);
      if state == 1; do
        if self.keys.get(pos) == key; do return false; fi
      else
        if state == 2; do
          if tomb < 0; do tomb = pos; fi
        else
          let mut int chosen = pos;
          if tomb >= 0; do chosen = tomb; fi
          self.states.set(chosen, 1);
          self.keys.set(chosen, key);
          self.count = self.count + 1;
          if tomb >= 0; do self.tombs = self.tombs - 1; fi
          return true;
        fi
      fi
    done
    if tomb >= 0; do
      self.states.set(tomb, 1);
      self.keys.set(tomb, key);
      self.count = self.count + 1;
      self.tombs = self.tombs - 1;
      return true;
    fi
    return false;
  }

  pub remove(mut self)(int key): bool {
    let int start = self.home(key);
    for (let int step = 0; step < self.limit; step = step + 1) do
      let mut int pos = start + step;
      if pos >= self.limit; do pos = pos - self.limit; fi
      let int state = self.states.get(pos);
      if state == 0; do return false; fi
      if state == 1 && self.keys.get(pos) == key; do
        self.states.set(pos, 2);
        self.keys.set(pos, 0);
        self.count = self.count - 1;
        self.tombs = self.tombs + 1;
        return true;
      fi
    done
    return false;
  }

  pub clear(mut self)(): void {
    for (let int i = 0; i < self.limit; i = i + 1) do
      self.states.set(i, 0);
      self.keys.set(i, 0);
    done
    self.count = 0;
    self.tombs = 0;
    return;
  }
end

pub fnc int_hash_set(int capacity): IntHashSet {
  return new IntHashSet(capacity);
}

pub fnc hash_set_self_test(): bool {
  let mut IntHashSet table = new IntHashSet(4);
  // Signed -1, 3 and 7 all collide at bucket 3.
  if !table.insert(-1) || !table.insert(3) ||
     !table.insert(7) || table.insert(3) ||
     !table.contains(-1) || !table.contains(7) ||
     table.len() != 3; do return false; fi
  if !table.remove(3) || table.remove(3) ||
     !table.contains(7) || table.tombstones() != 1; do
    return false;
  fi
  if !table.insert(11) || table.tombstones() != 0 ||
     table.contains(3) || !table.contains(11) ||
     !table.insert(15) || table.insert(19); do
    return false;
  fi
  if !table.remove(-1) || !table.remove(7) ||
     !table.remove(11) || !table.remove(15) ||
     !table.is_empty(); do return false; fi
  // Fully tombstoned table still admits new data.
  if !table.insert(0) || !table.contains(0); do
    return false;
  fi
  table.clear();
  return table.is_empty() && table.tombstones() == 0 &&
         !table.contains(0);
}

pub fnc bounded_int_set(int domain_size): BoundedIntSet {
  return new BoundedIntSet(domain_size);
}

pub fnc dense_set_algebra_self_test(): bool {
  let mut BoundedIntSet a = new BoundedIntSet(4);
  let mut BoundedIntSet b = new BoundedIntSet(8);
  a.insert(0); a.insert(3);
  b.insert(3); b.insert(7);
  let BoundedIntSet u = a.union(rt borrow b);
  let BoundedIntSet i = a.intersection(rt borrow b);
  let BoundedIntSet d = a.difference(rt borrow b);
  let BoundedIntSet x = a.symmetric_difference(rt borrow b);
  let BoundedIntSet y = b.symmetric_difference(rt borrow a);
  if u.len() neq 3 || !u.contains(0) || !u.contains(3) || !u.contains(7) ||
     i.len() neq 1 || !i.contains(3) ||
     d.len() neq 1 || !d.contains(0) ||
     x.len() neq 2 || !x.contains(0) || !x.contains(7) || x.contains(3) ||
     !x.same_members(rt borrow y) || !a.has_overlap(rt borrow b); do return false; fi
  if a.len() neq 2 || b.len() neq 2 || a.contains(7) || b.contains(0); do return false; fi
  a.clear();
  b.clear();
  if u.len() neq 3 || x.len() neq 2 || !x.contains(7) ||
     a.has_overlap(rt borrow b) || !a.same_members(rt borrow b); do return false; fi
  let BoundedIntSet empty = a.symmetric_difference(rt borrow b);
  return empty.is_empty() && empty.capacity() eq 8;
}

pub fnc self_test(): bool {
  let mut BoundedIntSet lhs = new BoundedIntSet(8);
  let mut BoundedIntSet rhs = new BoundedIntSet(8);
  let mut BoundedIntSet wrong = new BoundedIntSet(7);
  if !lhs.insert(2) || !lhs.insert(4) || lhs.insert(2) ||
     lhs.insert(-1) || lhs.insert(8) ||
     lhs.len() != 2 || lhs.next_from(0) != 2 ||
     lhs.next_from(3) != 4 || lhs.next_from(5) != -1; do
    return false;
  fi
  rhs.insert(4);
  rhs.insert(7);
  if lhs.union_from(rt borrow wrong) || lhs.len() != 2 ||
     !lhs.union_from(rt borrow rhs) || lhs.len() != 3 ||
     !lhs.contains(7) || !rhs.is_subset_of(rt borrow lhs); do
    return false;
  fi
  if !lhs.intersect_from(rt borrow rhs) || lhs.len() != 2 ||
     lhs.contains(2) || !lhs.subtract_from(rt borrow rhs) ||
     !lhs.is_empty() || lhs.remove(4); do
    return false;
  fi
  lhs.insert(0);
  lhs.insert(4);
  if lhs.symmetric_difference_from(rt borrow wrong) || lhs.len() neq 2 ||
     !lhs.contains(0) || !lhs.contains(4); do return false; fi
  if !lhs.symmetric_difference_from(rt borrow rhs) ||
     lhs.len() neq 2 || !lhs.contains(0) || !lhs.contains(7) ||
     lhs.contains(4) || rhs.len() neq 2 || !rhs.contains(4); do return false; fi
  if !lhs.symmetric_difference_from(rt borrow rhs) ||
     lhs.len() neq 2 || !lhs.contains(0) || !lhs.contains(4) ||
     lhs.contains(7); do return false; fi
  lhs.clear();
  return lhs.len() == 0 && !lhs.contains(0) && hash_set_self_test() && dense_set_algebra_self_test();
}
