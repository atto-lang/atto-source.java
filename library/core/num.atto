// core/num (atto-source.java): freestanding checked/saturating i64 arithmetic.
// Plain `+`/`-`/`*` are checked and trap; these helpers return values.
define module num as
  pub fnc max_value(): int { return 9223372036854775807; }
  pub fnc min_value(): int { return 0 - 9223372036854775807 - 1; }
  pub fnc abs(int x): int {
    if x < 0 then return 0 - x; fi
    return x;
  }
  pub fnc signum(int x): int {
    if x < 0 then return 0 - 1; fi
    if x > 0 then return 1; fi
    return 0;
  }
  pub fnc min(int a, int b): int {
    if a < b then return a; fi
    return b;
  }
  pub fnc max(int a, int b): int {
    if a > b then return a; fi
    return b;
  }
  pub fnc clamp(int value, int lower, int upper): int {
    if value < lower then return lower; fi
    if value > upper then return upper; fi
    return value;
  }
  pub fnc checked_add(int a, int b): Option<int> {
    if b > 0 then
      if a > 9223372036854775807 - b then return None; fi
    fi
    if b < 0 then
      if a < (0 - 9223372036854775807 - 1) - b then return None; fi
    fi
    return Some(a + b);
  }
  pub fnc checked_sub(int a, int b): Option<int> {
    if b < 0 then
      if a > 9223372036854775807 + b then return None; fi
    fi
    if b > 0 then
      if a < (0 - 9223372036854775807 - 1) + b then return None; fi
    fi
    return Some(a - b);
  }
  pub fnc saturating_add(int a, int b): int {
    if b > 0 then
      if a > 9223372036854775807 - b then return 9223372036854775807; fi
    fi
    if b < 0 then
      if a < (0 - 9223372036854775807 - 1) - b then return 0 - 9223372036854775807 - 1; fi
    fi
    return a + b;
  }
  pub fnc saturating_sub(int a, int b): int {
    if b < 0 then
      if a > 9223372036854775807 + b then return 9223372036854775807; fi
    fi
    if b > 0 then
      if a < (0 - 9223372036854775807 - 1) + b then return 0 - 9223372036854775807 - 1; fi
    fi
    return a - b;
  }
  pub fnc pow(int base, int exponent): int {
    let int result = 1;
    let int i = 0;
    loop {
      if i >= exponent then break; fi
      result = result * base;
      i = i + 1;
    }
    return result;
  }

  // Overflow predicates, checked/saturating/wrapping families
  // (from atto-source.java#1769; checked_* return Option like checked_add).
  pub fnc can_add(int left, int right): bool {
    if right > 0 && left > 9223372036854775807 - right then return false; fi
    if right < 0 && left < -9223372036854775808 - right then return false; fi
    return true;
  }

  pub fnc can_sub(int left, int right): bool {
    if right < 0 && left > 9223372036854775807 + right then return false; fi
    if right > 0 && left < -9223372036854775808 + right then return false; fi
    return true;
  }

  pub fnc can_mul(int left, int right): bool {
    if left == 0 || right == 0 then return true; fi
    if left == -1 then return right != -9223372036854775808; fi
    if right == -1 then return left != -9223372036854775808; fi
    if left > 0 then
      if right > 0 then return left <= tdiv(9223372036854775807, right); fi
      return right >= tdiv(-9223372036854775808, left);
    fi
    if right > 0 then return left >= tdiv(-9223372036854775808, right); fi
    return left >= tdiv(9223372036854775807, right);
  }

  pub fnc can_div(int left, int right): bool {
    if right == 0 then return false; fi
    return !(left == -9223372036854775808 && right == -1);
  }

  pub fnc checked_mul(int left, int right): Option<int> {
    if !can_mul(left, right) then return None; fi
    return Some(left * right);
  }

  pub fnc checked_div(int left, int right): Option<int> {
    if !can_div(left, right) then return None; fi
    return Some(tdiv(left, right));
  }

  pub fnc checked_rem(int left, int right): Option<int> {
    if !can_div(left, right) then return None; fi
    return Some(Integer.rem(left, right));
  }

  pub fnc checked_neg(int value): Option<int> {
    if value == -9223372036854775808 then return None; fi
    return Some(0 - value);
  }

  pub fnc checked_abs(int value): Option<int> {
    if value == -9223372036854775808 then return None; fi
    if value < 0 then return Some(0 - value); fi
    return Some(value);
  }

  pub fnc saturating_mul(int left, int right): int {
    if !can_mul(left, right) then
      if (left > 0 && right > 0) || (left < 0 && right < 0) then
        return 9223372036854775807;
      fi
      return -9223372036854775808;
    fi
    return left * right;
  }

  pub fnc saturating_neg(int value): int {
    if value == -9223372036854775808 then return 9223372036854775807; fi
    return 0 - value;
  }

  pub fnc saturating_abs(int value): int {
    if value == -9223372036854775808 then return 9223372036854775807; fi
    if value < 0 then return 0 - value; fi
    return value;
  }

  pub fnc wrapping_add(int left, int right): int {
    if right > 0 && left > 9223372036854775807 - right then
      return -9223372036854775808 + (left - (9223372036854775807 - right) - 1);
    fi
    if right < 0 && left < -9223372036854775808 - right then
      return 9223372036854775807 + right - (-9223372036854775808 - left) + 1;
    fi
    return left + right;
  }

  pub fnc wrapping_sub(int left, int right): int {
    if right < 0 && left > 9223372036854775807 + right then
      return -9223372036854775808 + left - (9223372036854775807 + right) - 1;
    fi
    if right > 0 && left < -9223372036854775808 + right then
      return 9223372036854775807 + left - (-9223372036854775808 + right) + 1;
    fi
    return left - right;
  }

  pub fnc wrapping_mul(int left, int right): int {
    if right == -9223372036854775808 then
      if Integer.rem(left, 2) != 0 then return -9223372036854775808; fi
      return 0;
    fi
    let mut int factor = right;
    let mut bool negative = false;
    if factor < 0 then
      factor = 0 - factor;
      negative = true;
    fi
    let mut int product = 0;
    let mut int term = left;
    for (let int i = 0; i < 63; i = i + 1) {
      if Integer.rem(factor, 2) != 0 then
        product = wrapping_add(product, term);
      fi
      factor = factor >>> 1;
      term = wrapping_add(term, term);
    }
    if negative then return wrapping_sub(0, product); fi
    return product;
  }

  pub fnc wrapping_neg(int value): int {
    return wrapping_sub(0, value);
  }

  // Floor division for a >= 0 and b > 0 (int/int yields float on this backend).
  fnc udiv(int a, int b): int {
    let mut int q = 0;
    let mut int r = a;
    while r >= b do
      let mut int d = b;
      let mut int m = 1;
      while d <= r - d do
        d = d + d;
        m = m + m;
      done
      r = r - d;
      q = q + m;
    done
    return q;
  }

  // Truncating division; callers exclude b == 0 and (MIN, -1).
  fnc tdiv(int a, int b): int {
    if b == -9223372036854775808 then
      if a == -9223372036854775808 then return 1; fi
      return 0;
    fi
    if b == 1 then return a; fi
    if b == -1 then return 0 - a; fi
    let mut int magnitude_b = b;
    if b < 0 then magnitude_b = 0 - b; fi
    if a == -9223372036854775808 then
      // a + |b| no longer overflows on negation; shifting the numerator by
      // |b| changes the exact quotient by sign(b) without crossing zero.
      let int shifted = 0 - (a + magnitude_b);
      let int q0 = udiv(shifted, magnitude_b);
      if b > 0 then return (0 - q0) - 1; fi
      return q0 + 1;
    fi
    let mut int magnitude_a = a;
    if a < 0 then magnitude_a = 0 - a; fi
    let int q = udiv(magnitude_a, magnitude_b);
    if (a < 0) != (b < 0) then return 0 - q; fi
    return q;
  }
end
