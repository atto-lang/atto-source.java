// core/mem (atto-source.java): alignment arithmetic for power-of-two alignments.
define module mem as
  pub fnc is_power_of_two(int value): bool {
    if value <= 0 then return false; fi
    return (value & (value - 1)) == 0;
  }
  pub fnc log2_floor(int value): int {
    let int k = 0;
    let int p = 1;
    loop {
      if p >= 4611686018427387904 then break; fi
      if (p <<< 1) > value then break; fi
      p = p <<< 1;
      k = k + 1;
    }
    return k;
  }
  pub fnc align_down(int value, int align): Option<int> {
    if value < 0 then return None; fi
    if !mem.is_power_of_two(align) then return None; fi
    return Some(value & (0 - align));
  }
  pub fnc align_up(int value, int align): Option<int> {
    if value < 0 then return None; fi
    if !mem.is_power_of_two(align) then return None; fi
    if value > 9223372036854775807 - (align - 1) then return None; fi
    return Some((value + align - 1) & (0 - align));
  }
  pub fnc is_aligned(int value, int align): bool {
    if value < 0 then return false; fi
    if !mem.is_power_of_two(align) then return false; fi
    return (value & (align - 1)) == 0;
  }

  // Sentinel (-1/false) layout policy, from atto-source.java#1771.
  pub fnc is_power_of_two_alignment(int alignment): bool {
    if alignment <= 0 then return false; fi
    return (alignment & (alignment - 1)) == 0;
  }

  pub fnc align_up_checked(int size_bytes, int alignment): int {
    if size_bytes < 0 then return -1; fi
    if alignment <= 0 then return -1; fi
    if (alignment & (alignment - 1)) != 0 then return -1; fi
    val int remainder = Integer.rem(size_bytes, alignment);
    if remainder == 0 then return size_bytes; fi
    val int padding = alignment - remainder;
    if size_bytes > 9223372036854775807 - padding then return -1; fi
    return size_bytes + padding;
  }

  pub fnc layout_stride(int element_bytes, int alignment): int {
    if element_bytes < 0 then return -1; fi
    if alignment <= 0 then return -1; fi
    if (alignment & (alignment - 1)) != 0 then return -1; fi
    val int remainder = Integer.rem(element_bytes, alignment);
    if remainder == 0 then return element_bytes; fi
    val int padding = alignment - remainder;
    if element_bytes > 9223372036854775807 - padding then return -1; fi
    return element_bytes + padding;
  }

  pub fnc array_bytes_checked(int count, int stride_bytes, int budget_bytes): int {
    if count < 0 then return -1; fi
    if stride_bytes < 0 then return -1; fi
    if budget_bytes < 0 then return -1; fi
    if count == 0 then return 0; fi
    if stride_bytes == 0 then return 0; fi
    if count > idiv(budget_bytes, stride_bytes) then return -1; fi
    return count * stride_bytes;
  }

  pub fnc span_fits(int region_bytes, int offset_bytes, int span_bytes): bool {
    if region_bytes < 0 then return false; fi
    if offset_bytes < 0 then return false; fi
    if span_bytes < 0 then return false; fi
    if offset_bytes > region_bytes then return false; fi
    return span_bytes <= region_bytes - offset_bytes;
  }

  // Floor division for a >= 0 and b > 0 (int/int yields float on this backend).
  fnc idiv(int a, int b): int {
    let mut int q = 0;
    let mut int r = a;
    while r >= b do
      let mut int d = b;
      let mut int m = 1;
      while d <= r - d do
        d = d + d;
        m = m + m;
      done
      r = r - d;
      q = q + m;
    done
    return q;
  }
end
