{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oreslang.dev/analysis/typed-ir-0.1.schema.json",
  "title": "Oreslang compiler-analyzer interchange IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "path", "functions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "path": {"type": "string", "minLength": 1},
    "functions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/function"}}
  },
  "$defs": {
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "actor_kind", "allows_error", "entry", "nodes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "actor_kind": {"enum": ["none", "shared", "private", "untrusted"]},
        "allows_error": {"type": "boolean"},
        "entry": {"type": "integer", "minimum": 0},
        "nodes": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/node"}},
        "matches": {"type": "array", "items": {"$ref": "#/$defs/match"}}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "line", "column", "op", "successors"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "op": {"enum": ["entry", "exit", "await", "select", "readch", "writech", "yield", "call", "defer", "return", "throw", "branch", "other"]},
        "successors": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "may_throw": {"type": "boolean"}, "handles_error": {"type": "boolean"},
        "borrowed_mut_across_suspend": {"type": "boolean"},
        "blocking_call": {"type": "boolean"},
        "select_has_cancellation": {"type": "boolean"}
      }
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "column", "closed_variants", "arms"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "closed_variants": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}},
        "arms": {"type": "array", "items": {"$ref": "#/$defs/arm"}}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["variants"],
      "properties": {
        "variants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "guarded": {"type": "boolean"}, "wildcard": {"type": "boolean"}
      }
    }
  }
}
