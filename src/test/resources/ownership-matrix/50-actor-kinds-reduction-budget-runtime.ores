define actor Shared as receive(ActorMail<String> mail): void { let count=0; for (let i=0; i<4000; i=i+1) { count=count+1; } self.send(count); self.end(); return; } end
define isoactor Private as receive(ActorMail<String> mail): void { let count=0; for (let i=0; i<4000; i=i+1) { count=count+1; } self.send(count); self.end(); return; } end
define untrusted actor Untrusted as receive(ActorMail<String> mail): void { let count=0; for (let i=0; i<128; i=i+1) { count=count+1; } self.send(count); self.end(); return; } end
pub async routine main(): void { val sharedWorker=spawn Shared(); await sharedWorker.get_ready(); sharedWorker.send("go"); val messagesharedWorker=(await sharedWorker.outputs.next()).value.unwrap(); stdio.stdout.write(messagesharedWorker.value); stdio.stdout.write("|"); await sharedWorker.get_done(); val privateWorker=spawn Private(); await privateWorker.get_ready(); privateWorker.send("go"); val messageprivateWorker=(await privateWorker.outputs.next()).value.unwrap(); stdio.stdout.write(messageprivateWorker.value); stdio.stdout.write("|"); await privateWorker.get_done(); val untrustedWorker=spawn Untrusted(); await untrustedWorker.get_ready(); untrustedWorker.send("go"); val messageuntrustedWorker=(await untrustedWorker.outputs.next()).value.unwrap(); stdio.stdout.write(messageuntrustedWorker.value); stdio.stdout.write("|"); await untrustedWorker.get_done(); return; }
