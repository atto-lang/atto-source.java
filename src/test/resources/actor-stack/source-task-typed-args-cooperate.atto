suspends fnc scalar_after_cooperate(int left, int right): int {
  rt cooperate;
  return left + right;
}

define actor ScalarWorker as
  receive(ActorMail<String> mail): void {
    if mail.value == "first"; do
      self.send("before");
      val int sum = await scalar_after_cooperate(40, 2);
      self.send(sum);
      return;
    fi
    if mail.value == "second"; do
      self.send("second");
      self.end();
      return;
    fi
    return;
  }
end

pub suspends routine main(): void {
  val worker = spawn ScalarWorker();
  await worker.get_ready();
  worker.send("first");
  worker.send("second");
  val one = (await worker.outputs.next()).value.unwrap();
  val two = (await worker.outputs.next()).value.unwrap();
  val three = (await worker.outputs.next()).value.unwrap();
  stdio.stdout.write(one.value);
  stdio.stdout.write("|");
  stdio.stdout.write(two.value);
  stdio.stdout.write("|");
  stdio.stdout.write(three.value);
  await worker.get_done();
  return;
}
