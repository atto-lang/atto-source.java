import fnc blow_stack from './actor_frame_helpers.atto';

define actor ExhaustingWorker as
  receive(ActorMail<String> mail): void {
    self.send("starting");
    val int unreachable = blow_stack(100000);
    self.send(unreachable);
    self.end();
    return;
  }
end

define actor SurvivingWorker as
  receive(ActorMail<String> mail): void {
    self.send("alive");
    self.end();
    return;
  }
end

pub suspends routine main(): void {
  val broken = spawn ExhaustingWorker();
  val healthy = spawn SurvivingWorker();
  await broken.get_ready();
  await healthy.get_ready();
  broken.send("start");
  val first = (await broken.outputs.next()).value.unwrap();
  healthy.send("run");
  val second = (await healthy.outputs.next()).value.unwrap();
  stdio.stdout.write(first.value);
  stdio.stdout.write("|");
  stdio.stdout.write(second.value);
  await healthy.get_done();
  await broken.get_done();
  return;
}
