// Compiler-owned HTTP namespace must preserve real Copy/owned semantics.
import * as web from "atto.std/http";
define class Box as
  pub let int value = 42;
end
pub fnc main(): void {
  val Box original = new Box();
  val Box transferred = rt take original;
  stdio.println(web.status_valid(200));
  stdio.println(transferred.value);
  return;
}
