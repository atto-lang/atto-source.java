// Compiler-backed hosted std/http module; every printed line must be true.
import http from "std/http.atto";
pub routine main(): void {
  stdio.println(http.status_valid(200) && !http.status_valid(99));
  stdio.println(http.status_is_success(299) && !http.status_is_success(300));
  stdio.println(http.method_valid("PATCH") && !http.method_valid("BAD METHOD"));
  stdio.println(http.method_is_safe("HEAD") && !http.method_is_safe("POST"));
  stdio.println(http.method_is_idempotent("DELETE") && !http.method_is_idempotent("PATCH"));
  stdio.println(http.header_name_valid("x-correlation-id") && !http.header_name_valid("bad:name"));
  stdio.println(http.header_value_valid("a b\t3") && !http.header_value_valid("ok\r\nInjected: yes"));
  stdio.println(http.header_line_valid("x-req", "abc", 10) && !http.header_line_valid("x-req", "abc", 9));
  stdio.println(http.origin_target_valid("/hello?a=1") && !http.origin_target_valid("https://evil.invalid/"));
  stdio.println(http.parse_request_line("GET /hello?a=1 HTTP/1.1").unwrap().target == "/hello?a=1");
  stdio.println(http.parse_request_line("GET /a HTTP/2").is_err() && http.parse_request_line("GET /#frag HTTP/1.1").is_err());
  stdio.println(!http.response_body_allowed(204, false, false) && !http.response_body_allowed(205, false, false));
  stdio.println(!http.response_body_allowed(200, true, false) && !http.response_body_allowed(200, false, true));
  stdio.println(http.response_body_allowed(404, false, false) && !http.response_body_allowed(304, false, false));
  stdio.println(!http.request_framing_allowed(true, true, true) && !http.request_framing_allowed(true, false, false));
  stdio.println(http.request_framing_allowed(true, false, true) && http.request_framing_allowed(false, true, false));
  stdio.println(http.body_bytes_allowed(1024, 1024) && !http.body_bytes_allowed(-1, 1024));
  stdio.println(http.header_budget_allowed(8192, 64, 8192, 64) && !http.header_budget_allowed(8193, 64, 8192, 64));
  stdio.println(http.header_field("X-Ok", "ok", 8).is_ok());
  stdio.println(http.header_field("Bad Name", "x", 32).is_err());
  stdio.println(http.header_field("X-Ok", "ok", 7).is_err());
  stdio.println(http.header_field("X-Ok", "a\r\nInjected: b", 100).is_err());
  stdio.println(http.request_meta("GET", "/health", -1).unwrap().method == "GET");
  stdio.println(http.request_meta("POST", "/submit", 0).unwrap().content_length == 0);
  stdio.println(http.request_meta("BAD METHOD", "/x", 0).is_err());
  stdio.println(http.request_meta("GET", "https://outside.invalid/", 0).is_err());
  stdio.println(http.request_meta("GET", "/x", -2).is_err());
  stdio.println(http.response_meta(200, false, false).unwrap().can_have_body);
  stdio.println(!http.response_meta(204, false, false).unwrap().can_have_body);
  stdio.println(!http.response_meta(200, true, false).unwrap().can_have_body);
  stdio.println(http.response_meta(600, false, false).is_err());
  stdio.println(http.parse_status_code("200").unwrap() == 200);
  stdio.println(http.parse_status_code("599").unwrap() == 599);
  stdio.println(http.parse_status_code("099").is_err());
  stdio.println(http.parse_status_code("20x").is_err());
  stdio.println(http.parse_status_code("2000").is_err());
  stdio.println(http.parse_status_line("HTTP/1.1 200 OK").unwrap() == 200);
  stdio.println(http.parse_status_line("HTTP/1.1 204 No Content").unwrap() == 204);
  stdio.println(http.parse_status_line("HTTP/2 200 OK").is_err());
  stdio.println(http.parse_status_line("HTTP/1.1 200\r\nFake").is_err());
  stdio.println(http.parse_content_length("0", 0).unwrap() == 0);
  stdio.println(http.parse_content_length("00042", 42).unwrap() == 42);
  stdio.println(http.parse_content_length("1024", 1024).unwrap() == 1024);
  stdio.println(http.parse_content_length("1025", 1024).is_err());
  stdio.println(http.parse_content_length("99999999999999999999", 1024).is_err());
  stdio.println(http.parse_content_length("+1", 1024).is_err());
  stdio.println(http.parse_content_length("", 1024).is_err());
  stdio.println(http.parse_content_length("1 ", 1024).is_err());
  stdio.println(http.parse_content_length("1", -1).is_err());
  stdio.println(http.content_length_valid("0001", 1) && !http.content_length_valid("2", 1));
  stdio.println(http.route_pattern_valid("/users/:id"));
  stdio.println(!http.route_pattern_valid("/users/:"));
  stdio.println(!http.route_pattern_valid("/users/*"));
  stdio.println(!http.route_pattern_valid("/users/:9id"));
  stdio.println(http.route_matches("/users/:id", "/users/42"));
  stdio.println(http.route_matches("/users/:id", "/users/42?page=3"));
  stdio.println(!http.route_matches("/users/:id", "/users/42/more"));
  stdio.println(!http.route_matches("/users/:id", "/users/%2F"));
  stdio.println(!http.route_matches("/users/:id", "/users/.."));
  stdio.println(!http.route_matches("/users/:id", "/users//42"));
  stdio.println(http.route_matches("/users/42", "/users/42"));
  stdio.println(!http.route_matches("/users/42", "/users/43"));
  stdio.println(http.route_matches_method("GET", "/users/:id", "GET", "/users/42"));
  stdio.println(!http.route_matches_method("GET", "/users/:id", "POST", "/users/42"));
  stdio.println(http.route_matches("/", "/"));
  stdio.println(!http.route_matches("/", "/other"));
  stdio.println(http.origin_target_valid("/resource%20name"));
  stdio.println(!http.origin_target_valid("/resource%GG"));
  stdio.println(!http.origin_target_valid("/resource%"));
  stdio.println(!http.origin_target_valid("/resource\\path"));
  stdio.println(!http.origin_target_valid("/resource#fragment"));
  return;
}
