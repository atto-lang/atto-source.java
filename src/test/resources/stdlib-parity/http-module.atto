// Compiler-backed hosted std/http module; every printed line must be true.
import * as web from "atto.std/http";
pub routine main(): void {
  stdio.println(web.status_valid(200) && !web.status_valid(99));
  stdio.println(web.status_is_success(299) && !web.status_is_success(300));
  stdio.println(web.method_valid("PATCH") && !web.method_valid("BAD METHOD"));
  stdio.println(web.method_is_safe("HEAD") && !web.method_is_safe("POST"));
  stdio.println(web.method_is_idempotent("DELETE") && !web.method_is_idempotent("PATCH"));
  stdio.println(web.header_name_valid("x-correlation-id") && !web.header_name_valid("bad:name"));
  stdio.println(web.header_value_valid("a b\t3") && !web.header_value_valid("ok\r\nInjected: yes"));
  stdio.println(web.header_line_valid("x-req", "abc", 10) && !web.header_line_valid("x-req", "abc", 9));
  stdio.println(web.origin_target_valid("/hello?a=1") && !web.origin_target_valid("https://evil.invalid/"));
  stdio.println(web.parse_request_line("GET /hello?a=1 HTTP/1.1").unwrap().target == "/hello?a=1");
  stdio.println(web.parse_request_line("GET /a HTTP/2").is_err() && web.parse_request_line("GET /#frag HTTP/1.1").is_err());
  stdio.println(!web.response_body_allowed(204, false, false) && !web.response_body_allowed(205, false, false));
  stdio.println(!web.response_body_allowed(200, true, false) && !web.response_body_allowed(200, false, true));
  stdio.println(web.response_body_allowed(404, false, false) && !web.response_body_allowed(304, false, false));
  stdio.println(!web.request_framing_allowed(true, true, true) && !web.request_framing_allowed(true, false, false));
  stdio.println(web.request_framing_allowed(true, false, true) && web.request_framing_allowed(false, true, false));
  stdio.println(web.body_bytes_allowed(1024, 1024) && !web.body_bytes_allowed(-1, 1024));
  stdio.println(web.header_budget_allowed(8192, 64, 8192, 64) && !web.header_budget_allowed(8193, 64, 8192, 64));
  stdio.println(web.header_field("X-Ok", "ok", 8).is_ok());
  stdio.println(web.header_field("Bad Name", "x", 32).is_err());
  stdio.println(web.header_field("X-Ok", "ok", 7).is_err());
  stdio.println(web.header_field("X-Ok", "a\r\nInjected: b", 100).is_err());
  stdio.println(web.request_meta("GET", "/health", -1).unwrap().method == "GET");
  stdio.println(web.request_meta("POST", "/submit", 0).unwrap().content_length == 0);
  stdio.println(web.request_meta("BAD METHOD", "/x", 0).is_err());
  stdio.println(web.request_meta("GET", "https://outside.invalid/", 0).is_err());
  stdio.println(web.request_meta("GET", "/x", -2).is_err());
  stdio.println(web.response_meta(200, false, false).unwrap().can_have_body);
  stdio.println(!web.response_meta(204, false, false).unwrap().can_have_body);
  stdio.println(!web.response_meta(200, true, false).unwrap().can_have_body);
  stdio.println(web.response_meta(600, false, false).is_err());
  stdio.println(web.parse_status_code("200").unwrap() == 200);
  stdio.println(web.parse_status_code("599").unwrap() == 599);
  stdio.println(web.parse_status_code("099").is_err());
  stdio.println(web.parse_status_code("20x").is_err());
  stdio.println(web.parse_status_code("2000").is_err());
  stdio.println(web.parse_status_line("HTTP/1.1 200 OK").unwrap() == 200);
  stdio.println(web.parse_status_line("HTTP/1.1 204 No Content").unwrap() == 204);
  stdio.println(web.parse_status_line("HTTP/2 200 OK").is_err());
  stdio.println(web.parse_status_line("HTTP/1.1 200\r\nFake").is_err());
  stdio.println(web.parse_content_length("0", 0).unwrap() == 0);
  stdio.println(web.parse_content_length("00042", 42).unwrap() == 42);
  stdio.println(web.parse_content_length("1024", 1024).unwrap() == 1024);
  stdio.println(web.parse_content_length("1025", 1024).is_err());
  stdio.println(web.parse_content_length("99999999999999999999", 1024).is_err());
  stdio.println(web.parse_content_length("+1", 1024).is_err());
  stdio.println(web.parse_content_length("", 1024).is_err());
  stdio.println(web.parse_content_length("1 ", 1024).is_err());
  stdio.println(web.parse_content_length("1", -1).is_err());
  stdio.println(web.content_length_valid("0001", 1) && !web.content_length_valid("2", 1));
  stdio.println(web.route_pattern_valid("/users/:id"));
  stdio.println(!web.route_pattern_valid("/users/:"));
  stdio.println(!web.route_pattern_valid("/users/*"));
  stdio.println(!web.route_pattern_valid("/users/:9id"));
  stdio.println(web.route_matches("/users/:id", "/users/42"));
  stdio.println(web.route_matches("/users/:id", "/users/42?page=3"));
  stdio.println(!web.route_matches("/users/:id", "/users/42/more"));
  stdio.println(!web.route_matches("/users/:id", "/users/%2F"));
  stdio.println(!web.route_matches("/users/:id", "/users/.."));
  stdio.println(!web.route_matches("/users/:id", "/users//42"));
  stdio.println(web.route_matches("/users/42", "/users/42"));
  stdio.println(!web.route_matches("/users/42", "/users/43"));
  stdio.println(web.route_matches_method("GET", "/users/:id", "GET", "/users/42"));
  stdio.println(!web.route_matches_method("GET", "/users/:id", "POST", "/users/42"));
  stdio.println(web.route_matches("/", "/"));
  stdio.println(!web.route_matches("/", "/other"));
  stdio.println(web.origin_target_valid("/resource%20name"));
  stdio.println(!web.origin_target_valid("/resource%GG"));
  stdio.println(!web.origin_target_valid("/resource%"));
  stdio.println(!web.origin_target_valid("/resource\\path"));
  stdio.println(!web.origin_target_valid("/resource#fragment"));
  stdio.println(web.client_limits(1024, 8192, 3, 5000).is_ok());
  stdio.println(web.client_limits(-1, 8192, 3, 5000).is_err());
  stdio.println(web.client_limits(1024, 511, 3, 5000).is_err());
  stdio.println(web.client_limits(1024, 8192, 17, 5000).is_err());
  stdio.println(web.client_limits(1024, 8192, 3, 0).is_err());
  stdio.println(web.server_limits(10, 4096, 8192).is_ok());
  stdio.println(web.server_limits(0, 4096, 8192).is_err());
  stdio.println(web.server_limits(10, -1, 8192).is_err());
  stdio.println(web.server_limits(10, 4096, 65537).is_err());
  stdio.println(web.redirect_candidate(301, true, 0, 3));
  stdio.println(web.redirect_candidate(308, true, 1, 3));
  stdio.println(!web.redirect_candidate(305, true, 0, 3));
  stdio.println(!web.redirect_candidate(302, false, 0, 3));
  stdio.println(!web.redirect_candidate(302, true, 3, 3));
  stdio.println(!web.redirect_candidate(302, true, -1, 3));
  stdio.println(web.retry_candidate("GET", 0, 2, false));
  stdio.println(web.retry_candidate("HEAD", 1, 2, false));
  stdio.println(!web.retry_candidate("POST", 0, 2, false));
  stdio.println(!web.retry_candidate("PUT", 0, 2, false));
  stdio.println(!web.retry_candidate("GET", 2, 2, false));
  stdio.println(!web.retry_candidate("GET", 0, 2, true));
  stdio.println(web.body_budget(0).is_ok());
  stdio.println(web.body_budget(-1).is_err());
  stdio.println(web.body_budget(1073741825).is_err());
  let mut budget = web.body_budget(8).unwrap();
  stdio.println(budget.admit(3));
  stdio.println(budget.remaining() == 5);
  stdio.println(!budget.admit(6));
  stdio.println(budget.admit(5));
  stdio.println(budget.consumed() == 8);
  stdio.println(!budget.admit(1));
  stdio.println(budget.finish());
  stdio.println(budget.is_closed());
  stdio.println(!budget.finish());
  stdio.println(!budget.admit(0));
  stdio.println(web.header_line_valid("x", "y", 4));
  stdio.println(!web.header_line_valid("x", "y", 65537));
  stdio.println(web.header_field("x", "y", 65537).is_err());
  stdio.println(!web.route_pattern_valid("/api/*more"));
  stdio.println(!web.route_pattern_valid("/foo:bar"));
  stdio.println(!web.route_pattern_valid("/users/:id*"));
  stdio.println(!web.route_pattern_valid("/users/:a:b"));
  stdio.println(web.route_pattern_valid("/users/:a_b"));
  stdio.println(!web.route_matches("/api/*more", "/api/123"));
  stdio.println(!web.route_matches("/foo:bar", "/foo:bar"));
  stdio.println(web.request_framing_fields_allowed(1, 0, false, false));
  stdio.println(web.request_framing_fields_allowed(0, 1, true, false));
  stdio.println(web.request_framing_fields_allowed(0, 0, false, false));
  stdio.println(!web.request_framing_fields_allowed(1, 1, true, false));
  stdio.println(!web.request_framing_fields_allowed(2, 0, false, false));
  stdio.println(!web.request_framing_fields_allowed(0, 2, true, false));
  stdio.println(!web.request_framing_fields_allowed(0, 1, false, false));
  stdio.println(!web.request_framing_fields_allowed(0, 1, true, true));
  stdio.println(!web.request_framing_fields_allowed(0, 0, true, false));
  stdio.println(!web.request_framing_fields_allowed(-1, 0, false, false));
  stdio.println(web.body_chunk_allowed(7, 1, 8));
  stdio.println(!web.body_chunk_allowed(7, 2, 8));
  stdio.println(!web.body_chunk_allowed(-1, 1, 8));
  stdio.println(!web.body_chunk_allowed(1, -1, 8));
  stdio.println(!web.body_chunk_allowed(0, 0, 1073741825));
  stdio.println(web.method_valid("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"));
  stdio.println(!web.method_valid("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"));
  stdio.println(web.header_name_valid("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"));
  stdio.println(!web.header_name_valid(""));
  stdio.println(!web.header_value_valid("bad\nvalue"));
  stdio.println(web.parse_content_length("000000000000000000000", 1024).is_err());
  return;
}
