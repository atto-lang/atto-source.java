import module http_wire from "std/http_wire.atto";
pub routine main(): void {
  val ok = http_wire.parse_head("GET /ok HTTP/1.1\r\nHost: localhost\r\n\r\n");
  stdio.println(ok.is_ok());
  stdio.println(ok.unwrap().target);
  stdio.println(http_wire.parse_head("POST /bad HTTP/1.1\r\nHost: localhost\r\n\r\n").is_err());
  return;
}
