import module layout_policy from "ores.std/layout_policy.atto";
pub routine main(): void {
  stdio.println(layout_policy.valid_shape(1, 3, 2, 4, 8, 1));
  stdio.println(layout_policy.byte_length(1, 3, 2, 4, 8, 1).unwrap());
  stdio.println(layout_policy.byte_offset(1, 3, 2, 4, 8, 1, 2, 1).unwrap());
  stdio.println(layout_policy.byte_length(2, 3, 2, 4, 8, 1).unwrap());
  stdio.println(layout_policy.byte_offset(2, 3, 2, 4, 8, 1, 2, 1).unwrap());
  stdio.println(layout_policy.byte_length(3, 5, 2, 4, 8, 4).unwrap());
  stdio.println(layout_policy.byte_offset(3, 5, 2, 4, 8, 4, 4, 1).unwrap());
  stdio.println(layout_policy.valid_shape(1, 5, 2, 4, 8, 2));
  stdio.println(layout_policy.byte_length(1, 1000001, 2, 4, 8, 1).is_err());
  return;
}
