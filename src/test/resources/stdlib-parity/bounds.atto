// Portable compiler-backed AttoLang stdlib parity fixture.
// Expected stdout is pinned by NativeAttoStdlibTest.
import module bounds from "ores.std/bounds";
pub routine main(): void {
  stdio.println(bounds.valid_int_bounds(3, 9));
  stdio.println(bounds.valid_int_bounds(9, 3));
  stdio.println(bounds.contains_int(9223372036854775807, 0, 9223372036854775807));
  stdio.println(bounds.contains_int(-9223372036854775807, -9223372036854775807, 0));
  stdio.println(bounds.contains_int(4, 5, 3));
  stdio.println(bounds.clamp_int(12, 0, 10).unwrap());
  stdio.println(bounds.clamp_int(-1, 0, 10).unwrap());
  stdio.println(bounds.clamp_int(3, 9, 1).is_err());
  stdio.println(bounds.overlaps_int(1, 3, 3, 9));
  stdio.println(bounds.overlaps_int(1, 2, 3, 9));
  return;
}
