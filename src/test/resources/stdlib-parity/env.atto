// Real Java backend guest fixture. Expected values pinned by NativeAttoEnvStdlibTest.
// Never depends on the host supplying a particular environmental value.
import module std_env from "std/env";
pub routine main(): void {
  stdio.println(std_env.has("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C"));
  stdio.println(std_env.get("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C").is_none());
  stdio.println(std_env.get_or("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C", "fallback"));
  stdio.println(std_env.get_required("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C").is_err());
  stdio.println(std_env.get_nonempty("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C").is_none());
  stdio.println(std_env.get_required_nonempty("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C").is_err());
  stdio.println(std_env.parse_bool("true").unwrap());
  stdio.println(std_env.parse_bool("0").unwrap());
  stdio.println(std_env.parse_bool("TRUE").is_err());
  stdio.println(std_env.parse_bool("").is_err());
  stdio.println(std_env.get_bool("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C").is_err());
  stdio.println(std_env.get_bool_or("ATTO_STDLIB_ENV_MISSING_20261122_7F1A8C", true).unwrap());
  return;
}
