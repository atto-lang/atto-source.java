import module metrics from "std/metrics";
pub routine main(): void {
  let c = metrics.counter(2);
  stdio.println(metrics.valid_name("http_requests_total"));
  stdio.println(metrics.valid_name("1bad"));
  stdio.println(c.increment());
  stdio.println(c.add(2));
  stdio.println(c.value());
  let g = metrics.gauge(-1, 3, 0);
  stdio.println(g.set(4));
  stdio.println(g.set(-1));
  stdio.println(g.value());
  let mut Array<int> bounds = new Array<int>();
  bounds.add(5);
  bounds.add(10);
  let h = metrics.histogram(bounds);
  stdio.println(h.observe(4));
  stdio.println(h.observe(7));
  stdio.println(h.observe(12));
  stdio.println(h.observe(-1));
  stdio.println(h.count());
  stdio.println(h.sum());
  stdio.println(h.bucket_count(0).unwrap());
  stdio.println(h.bucket_count(1).unwrap());
  stdio.println(h.bucket_count(2).unwrap());
  stdio.println(h.rejected_count());
  return;
}
