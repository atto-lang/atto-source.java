import module json from "std/json";
pub routine main(): void {
  let good = json.decode("{\"a\":1,\"b\":[true,null]}");
  stdio.println(good.is_ok());
  stdio.println(good.unwrap().kind());
  stdio.println(json.decode("{\"a\":1,\"\\u0061\":2}").is_err());
  stdio.println(json.decode("[1,]").is_err());
  stdio.println(json.decode("\"\\uD800\"").is_err());
  stdio.println(json.decode("{\"a\":01}").is_err());
  stdio.println(json.decode("{\"a\":1,}").is_err());
  stdio.println(json.decode("1e+4").is_ok());
  stdio.println(json.decode("\"\\uD834\\uDD1E\"").is_ok());
  stdio.println(json.decode("\"\\uDC00\"").is_err());
  stdio.println(json.decode("{\"a\":1,\"a\":2}").is_err());
  stdio.println(json.decode("1.").is_err());
  stdio.println(json.decode("1e").is_err());
  stdio.println(json.encode(json.decode("  true  ").unwrap()) == "  true  ");
  stdio.println(json.decode_int("2147483647").unwrap());
  stdio.println(json.decode_i32("2147483648").is_err());
  stdio.println(json.decode_int("00").is_err());
  stdio.println(json.parse("[]").is_ok());
  stdio.println(json.valid("{}"));
  stdio.println(!json.valid("{]"));
  stdio.println(json.stringify(json.parse("  null ").unwrap()) == "  null ");
  stdio.println(json.decode_int("9223372036854775807").is_ok());
  stdio.println(json.decode_int("-9223372036854775808").is_ok());
  stdio.println(json.decode_int("9223372036854775808").is_err());
  stdio.println(json.decode_int("-9223372036854775809").is_err());
  stdio.println(json.decode_int("-0").unwrap() == 0);
  stdio.println(json.decode_i32("-2147483648").is_ok());
  stdio.println(json.decode_i32("2147483648").is_err());
  stdio.println(json.decode_i32("-2147483649").is_err());
  stdio.println(json.decode_int("1.0").is_err());
  stdio.println(json.decode_int("+1").is_err());
  stdio.println(json.decode_int("00").is_err());
  stdio.println(json.encode_bool(true));
  return;
}
