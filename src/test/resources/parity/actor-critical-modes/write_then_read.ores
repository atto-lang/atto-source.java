// Cross-backend critical state-loan conformance case: write_then_read
// Must be compiled by a real Oreslang backend, not a Node simulator.
define actor Probe as
  state { revision: int = 0; }
  receive(ActorMail<String> mail): void {
    let String outcome = "critical-read-failed";
    self.handle_state(critical[write] |s| -> {
      s.revision = 1;
    });
    self.handle_state(critical[read] |s| -> {
      if s.revision == 1; do
        outcome = "critical-modes-ok";
      fi
    });
    stdio.stdout.write(outcome);
    self.end();
    return;
  }
end

pub async routine main(): void {
  val worker = spawn Probe();
  await worker.get_ready();
  worker.send("tick");
  await worker.get_done();
  return;
}
