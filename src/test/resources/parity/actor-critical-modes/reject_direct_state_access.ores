// Cross-backend critical state-loan conformance case: reject_direct_state_access
// Must be compiled by a real Oreslang backend, not a Node simulator.
define actor Probe as
  state { revision: int = 0; }
  receive(ActorMail<String> mail): void {
    self.revision = 12;
    self.end();
    return;
  }
end

pub async routine main(): void {
  val worker = spawn Probe();
  await worker.get_ready();
  worker.send("tick");
  await worker.get_done();
  return;
}
