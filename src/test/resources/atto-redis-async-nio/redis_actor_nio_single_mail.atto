// Optimized Atto Redis NIO2: one typed List<string> actor mail per command.
// No host KV implementation, blocking socket, stdout or stdin. Each request's
// binary key/value arrive as lowercase hex through bounded RESP2 NIO decoder.
// This variant is ephemeral and single-client; WAL/multi-client are separate.
define actor RedisKvSingleMail as
  let Map<string,string> values;

  on_start(): void {
    self.values = ~map<string,string>();
    return;
  }

  receive(ActorMail<List<string>> mail): void {
    val request = mail.value;
    if request.size == 0; do
      self.end();
      return;
    fi
    val string op = request[0];
    if op == "QUIT"; do
      self.end();
      return;
    fi
    if op == "SET" && request.size == 3; do
      self.values.set(request[1], request[2]);
      self.send("OK");
      return;
    fi
    if op == "GET" && request.size == 2; do
      val found = self.values.get_optional(request[1]);
      if found.is_none(); do
        self.send("NIL");
      else
        self.send("VALUE");
        self.send(found.unwrap());
      fi
      return;
    fi
    if op == "DEL" && request.size == 2; do
      if self.values.delete(request[1]); do
        self.send("ONE");
      else
        self.send("ZERO");
      fi
      return;
    fi
    self.send("ERR");
    return;
  }
end

pub async routine main(): void {
  val worker = spawn RedisKvSingleMail();
  await worker.get_ready();
  val listener = await network.listen_async("127.0.0.1", __PORT__);
  val socket = await listener.accept_async();

  loop {
    val request = await socket.read_resp2_hex_async();
    if request.size == 0; do
      await socket.close_async();
      await listener.close_async();
      worker.send(request);
      await worker.get_done();
      return;
    fi
    val string op = request[0];
    if op == "QUIT" && request.size == 1; do
      await socket.write_resp2_hex_async("OK", "");
      await socket.close_async();
      await listener.close_async();
      worker.send(request);
      await worker.get_done();
      return;
    fi
    if op == "PING" && request.size == 1; do
      await socket.write_resp2_hex_async("PONG", "");
    elseif (op == "SET" && request.size == 3)
        || ((op == "GET" || op == "DEL") && request.size == 2); do
      worker.send(request);
      val output = (await worker.outputs.next()).value.unwrap();
      let string payload = "";
      if output.value == "VALUE"; do
        val value = (await worker.outputs.next()).value.unwrap();
        payload = value.value;
      fi
      await socket.write_resp2_hex_async(output.value, payload);
    else
      await socket.write_resp2_hex_async("ERR", "");
    fi
  }
}
