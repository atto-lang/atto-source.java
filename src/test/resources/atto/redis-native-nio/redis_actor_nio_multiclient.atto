// Concurrent Atto Redis experiment: one KV actor owns the Map for all clients.
// NIO2 accept/read/write/close stay callback-driven; guest never blocks carriers.
// Every command carries an explicit bounded Channel<Reply> Send capability.
// No independently scheduled task captures a mutable Array of channel handles.
// Finite client-count fixture: not WAL, TTL, replication or production durability.
define actor FramedNioSharedKvActor as
  let Map<string,string> values;

  on_start(): void {
    self.values = ~map<string,string>();
    return;
  }

  receive(ActorMail<Tuple[int,string,string,Channel<Tuple[string,string]>>> mail): void {
    const Tuple[int,string,string,Channel<Tuple[string,string]>] command = mail.value;
    const int kind = command[0];
    const string key = command[1];
    const string value = command[2];
    const Channel<Tuple[string,string]> reply_channel = command[3];
    if kind == 5; do self.end(); return; fi
    if kind == 3; do
      self.values.set(key, value);
      await nb writech reply_channel, ("OK", "");
      return;
    fi
    if kind == 2; do
      val found = self.values.get_optional(key);
      if found.is_none(); do
        await nb writech reply_channel, ("NIL", "");
      else
        await nb writech reply_channel, ("VALUE", found.unwrap());
      fi
      return;
    fi
    if kind == 4; do
      if self.values.delete(key); do
        await nb writech reply_channel, ("ONE", "");
      else
        await nb writech reply_channel, ("ZERO", "");
      fi
      return;
    fi
    await nb writech reply_channel, ("ERR", "");
    return;
  }
end

pub async routine main(): void {
  const int client_count = 8;
  val worker = spawn FramedNioSharedKvActor();
  await worker.get_ready();
  val listener = await network.listen_async("127.0.0.1", 16401);
  val Array<Channel<Tuple[string,string>>> reply_channels = new Array<Channel<Tuple[string,string]>>();
  for (let int i = 0; i < client_count; i = i + 1) {
    reply_channels.add(Channel.new<Tuple[string,string]>(1));
  }

  val Array<Future<void>> sessions = new Array<Future<void>>();
  for (let int i = 0; i < client_count; i = i + 1) {
    val socket = await listener.accept_async();
    const Channel<Tuple[string,string]> inbox = reply_channels.get(i);
    val Future<void> session = task {
      loop {
        val frame = await socket.read_resp2_hex_async();
        if frame.size == 0; do
          await socket.close_async();
          return;
        fi
        const string op = frame[0];
        if op == "QUIT" && frame.size == 1; do
          await socket.write_resp2_hex_async("OK", "");
          await socket.close_async();
          return;
        fi
        if op == "PING" && frame.size == 1; do
          await socket.write_resp2_hex_async("PONG", "");
        else
          let int kind = 0;
          if op == "GET" && frame.size == 2 then kind = 2; fi
          if op == "SET" && frame.size == 3 then kind = 3; fi
          if op == "DEL" && frame.size == 2 then kind = 4; fi
          let string key = "";
          let string value = "";
          if frame.size >= 2 then key = frame[1]; fi
          if frame.size >= 3 then value = frame[2]; fi
          worker.send((kind, key, value, inbox));
          const Tuple[string,string] response = await nb readch inbox;
          await socket.write_resp2_hex_async(response[0], response[1]);
        fi
      }
    };
    sessions.add(session);
  }

  for (let int i = 0; i < client_count; i = i + 1) {
    await sessions.get(i);
  }
  await listener.close_async();
  worker.send((5, "", "", reply_channels.get(0)));
  await worker.get_done();
  return;
}
