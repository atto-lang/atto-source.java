// Atto-owned incremental RESP2 + binary-safe actor KV, native asynchronous NIO2.
// Requires Java compiler async NIO PR #2894 + Redis guest integration PR #2897.
// No host RESP parser, stdio pipe, host-side KV, blocking socket, or Rust fallback.
// Current wire limit: three args, command <=16, key <=4096, value <=16384;
// 256 distinct live keys, one loopback client, no persistence or supervision.
// Binary values/keys use List<int> (0..255); owned Bytes still needs a runtime type.

define class KvCommand as
  pub final int kind = 0;
  pub final List<int> key = [];
  pub final List<int> value = [];
end

define class KvReply as
  pub final int kind = 0;
  pub final List<int> value = [];
end

define class KvEntry as
  pub final List<int> key = [];
  pub final List<int> value = [];
  pub final bool live = false;
end

define class RespReader as
  pub let int phase = 0;
  pub let int argc = 0;
  pub let int argc_digits = 0;
  pub let int arg_index = 0;
  pub let int bulk_length = 0;
  pub let int bulk_digits = 0;
  pub let int body_read = 0;
  pub let int bytes_total = 0;
  pub let mut List<int> body = [];
  pub let mut List<List<int>> args = [];
end

pub fnc copy_bytes(borrow List<int> bytes): List<int> {
  let mut List<int> copied = [];
  let int i = 0;
  loop {
    if i == bytes.size then return copied; fi
    copied.add(bytes.get(i));
    i = i + 1;
  }
}

pub fnc same_bytes(borrow List<int> left, borrow List<int> right): bool {
  if left.size != right.size then return false; fi
  let int i = 0;
  loop {
    if i == left.size then return true; fi
    if left.get(i) != right.get(i) then return false; fi
    i = i + 1;
  }
}

pub fnc ascii_command(borrow List<int> input, List<int> canonical): bool {
  if input.size != canonical.size then return false; fi
  let int i = 0;
  loop {
    if i == input.size then return true; fi
    let int value = input.get(i);
    if value >= 97 && value <= 122 then value = value - 32; fi
    if value != canonical.get(i) then return false; fi
    i = i + 1;
  }
}

// Output: 0 unknown/invalid arity, 1 PING, 2 GET, 3 SET, 4 DEL, 5 QUIT.
// This only accepts exactly the supported arities, never a partial command.
pub fnc command_kind(borrow List<List<int>> args): int {
  val command = args.get(0);
  if args.size == 1; do
    if ascii_command(rt borrow command, [80, 73, 78, 71]) then return 1; fi
    if ascii_command(rt borrow command, [81, 85, 73, 84]) then return 5; fi
    return 0;
  fi
  if args.size == 2; do
    if ascii_command(rt borrow command, [71, 69, 84]) then return 2; fi
    if ascii_command(rt borrow command, [68, 69, 76]) then return 4; fi
    return 0;
  fi
  if args.size == 3; do
    if ascii_command(rt borrow command, [83, 69, 84]) then return 3; fi
  fi
  return 0;
}

// The parser is a genuine byte-by-byte Atto state machine. It never treats
// bulk payload CR/LF, NUL or invalid UTF-8 as delimiters and it never allocates
// a declared oversized bulk body. Returns 0=incomplete, 1=frame, -1=invalid.
pub fnc feed_resp2(borrow mut RespReader r, int b): int {
  if b < 0 || b > 255 then return -1; fi
  r.bytes_total = r.bytes_total + 1;
  if r.bytes_total > 20576 then return -1; fi

  if r.phase == 0; do
    if b != 42 then return -1; fi
    r.phase = 1;
    return 0;
  fi
  if r.phase == 1; do
    if b == 13; do
      if r.argc_digits != 1 || r.argc < 1 || r.argc > 3 then return -1; fi
      r.phase = 2;
      return 0;
    fi
    if r.argc_digits != 0 || b < 49 || b > 51 then return -1; fi
    r.argc = b - 48;
    r.argc_digits = 1;
    return 0;
  fi
  if r.phase == 2; do
    if b != 10 then return -1; fi
    r.phase = 3;
    return 0;
  fi
  if r.phase == 3; do
    if b != 36 then return -1; fi
    r.bulk_digits = 0;
    r.bulk_length = 0;
    r.body_read = 0;
    r.body = [];
    r.phase = 4;
    return 0;
  fi
  if r.phase == 4; do
    if b == 13; do
      if r.bulk_digits == 0 then return -1; fi
      r.phase = 5;
      return 0;
    fi
    if b < 48 || b > 57 || r.bulk_digits >= 5 then return -1; fi
    if r.bulk_digits > 0 && r.bulk_length == 0 then return -1; fi
    r.bulk_length = r.bulk_length * 10 + (b - 48);
    r.bulk_digits = r.bulk_digits + 1;
    if r.arg_index == 0 && r.bulk_length > 16 then return -1; fi
    if r.arg_index == 1 && r.bulk_length > 4096 then return -1; fi
    if r.arg_index == 2 && r.bulk_length > 16384 then return -1; fi
    return 0;
  fi
  if r.phase == 5; do
    if b != 10 then return -1; fi
    if r.bulk_length == 0 then r.phase = 7; else r.phase = 6; fi
    return 0;
  fi
  if r.phase == 6; do
    r.body.add(b);
    r.body_read = r.body_read + 1;
    if r.body_read == r.bulk_length then r.phase = 7; fi
    return 0;
  fi
  if r.phase == 7; do
    if b != 13 then return -1; fi
    r.phase = 8;
    return 0;
  fi
  if r.phase == 8; do
    if b != 10 then return -1; fi
    r.args.add(r.body);
    r.arg_index = r.arg_index + 1;
    if r.arg_index == r.argc then return 1; fi
    r.phase = 3;
    return 0;
  fi
  return -1;
}

pub fnc reset_resp2(borrow mut RespReader r): void {
  r.phase = 0;
  r.argc = 0;
  r.argc_digits = 0;
  r.arg_index = 0;
  r.bulk_length = 0;
  r.bulk_digits = 0;
  r.body_read = 0;
  r.bytes_total = 0;
  r.body = [];
  r.args = [];
  return;
}

// No String decoding for keys or values. A bounded actor-owned array of
// immutable byte snapshots is the interim storage index until the real
// owned Bytes hashing primitive replaces this O(256) scan.
define actor BinaryKvActor as
  let mut List<KvEntry> entries;
  on_start(): void {
    self.entries = [];
    return;
  }

  receive(ActorMail<KvCommand> mail): void {
    val cmd = mail.value;
    if cmd.kind == 5; do self.end(); return; fi
    if cmd.kind == 1; do
      self.send(new KvReply(5, []));
      return;
    fi
    if cmd.kind == 0; do
      self.send(new KvReply(6, []));
      return;
    fi

    let int match_index = -1;
    let int free_index = -1;
    let int i = 0;
    loop {
      if i == self.entries.size then break; fi
      val entry = self.entries.get(i);
      if !entry.live && free_index == -1 then free_index = i; fi
      if same_bytes(rt borrow entry.key, rt borrow cmd.key); do
        match_index = i;
        break;
      fi
      i = i + 1;
    }

    if cmd.kind == 2; do
      if match_index == -1; do self.send(new KvReply(0, [])); return; fi
      val found = self.entries.get(match_index);
      if !found.live; do self.send(new KvReply(0, [])); return; fi
      self.send(new KvReply(2, copy_bytes(rt borrow found.value)));
      return;
    fi

    if cmd.kind == 3; do
      val replacement = new KvEntry(copy_bytes(rt borrow cmd.key), copy_bytes(rt borrow cmd.value), true);
      if match_index >= 0; do
        self.entries.set(match_index, replacement);
      elseif free_index >= 0; do
        self.entries.set(free_index, replacement);
      elseif self.entries.size < 256; do
        self.entries.add(replacement);
      else
        self.send(new KvReply(6, []));
        return;
      fi
      self.send(new KvReply(1, []));
      return;
    fi

    if cmd.kind == 4; do
      if match_index == -1; do self.send(new KvReply(4, [])); return; fi
      val existing = self.entries.get(match_index);
      if !existing.live; do self.send(new KvReply(4, [])); return; fi
      self.entries.set(match_index, new KvEntry(copy_bytes(rt borrow existing.key), [], false));
      self.send(new KvReply(3, []));
      return;
    fi

    self.send(new KvReply(6, []));
    return;
  }
end

// RESP bulk encoding in Atto: decimal length with no host itoa, UTF-8 or
// parser shortcuts. The initial v1 byte API is still List<int>, not Bytes.
pub fnc encode_bulk(borrow List<int> value): List<int> {
  let mut List<int> out = [36];
  let int left = value.size;
  let int divisor = 10000;
  let bool started = false;
  loop {
    let int digit = 0;
    loop {
      if left < divisor then break; fi
      left = left - divisor;
      digit = digit + 1;
    }
    if digit > 0 || started || divisor == 1; do
      out.add(48 + digit);
      started = true;
    fi
    if divisor == 1 then break; fi
    if divisor == 10000 then divisor = 1000;
    elseif divisor == 1000 then divisor = 100;
    elseif divisor == 100 then divisor = 10;
    else divisor = 1; fi
  }
  out.add(13);
  out.add(10);
  let int i = 0;
  loop {
    if i == value.size then break; fi
    out.add(value.get(i));
    i = i + 1;
  }
  out.add(13);
  out.add(10);
  return out;
}

pub fnc encode_reply(KvReply reply): List<int> {
  if reply.kind == 0 then return [36, 45, 49, 13, 10]; fi
  if reply.kind == 1 then return [43, 79, 75, 13, 10]; fi
  if reply.kind == 2 then return encode_bulk(rt borrow reply.value); fi
  if reply.kind == 3 then return [58, 49, 13, 10]; fi
  if reply.kind == 4 then return [58, 48, 13, 10]; fi
  if reply.kind == 5 then return [43, 80, 79, 78, 71, 13, 10]; fi
  return [45, 69, 82, 82, 32, 117, 110, 115, 117, 112, 112, 111, 114, 116, 101, 100, 13, 10];
}

pub async routine main(): void {
  val worker = spawn BinaryKvActor();
  await worker.get_ready();
  val listener = await network.listen_async("127.0.0.1", 16399);
  val socket = await listener.accept_async();
  val reader = new RespReader();
  loop {
    val chunk = await socket.read_bytes_async(1024);
    if chunk.size == 0; do
      await socket.close_async();
      await listener.close_async();
      worker.send(new KvCommand(5, [], []));
      await worker.get_done();
      return;
    fi

    let int i = 0;
    loop {
      if i == chunk.size then break; fi
      val int state = feed_resp2(rt mut borrow reader, chunk.get(i));
      if state == -1; do
        await socket.write_bytes_async([45, 69, 82, 82, 32, 112, 114, 111, 116, 111, 99, 111, 108, 13, 10]);
        await socket.close_async();
        await listener.close_async();
        worker.send(new KvCommand(5, [], []));
        await worker.get_done();
        return;
      fi
      if state == 1; do
        val int kind = command_kind(rt borrow reader.args);
        if kind == 5; do
          await socket.write_bytes_async([43, 79, 75, 13, 10]);
          await socket.close_async();
          await listener.close_async();
          worker.send(new KvCommand(5, [], []));
          await worker.get_done();
          return;
        fi
        let List<int> key = [];
        let List<int> value = [];
        if reader.args.size >= 2 then val selected_key = reader.args.get(1); key = copy_bytes(rt borrow selected_key); fi
        if reader.args.size >= 3 then val selected_value = reader.args.get(2); value = copy_bytes(rt borrow selected_value); fi
        worker.send(new KvCommand(kind, key, value));
        val output = (await worker.outputs.next()).value.unwrap();
        await socket.write_bytes_async(encode_reply(output.value));
        reset_resp2(rt mut borrow reader);
      fi
      i = i + 1;
    }
  }
}
