// Experimental, compiler-backed Atto actor with binary Bytes KV storage.
// Production physical TCP I/O is NIO2 CompletionHandler only.
// Java NIO2 frames RESP2 into immutable owned Bytes; Atto alone owns Map.
// One client, memory-only; no blocking socket, stdio, WAL or host-owned KV.
define actor OwnedBytesNioKvActor implements StreamOperator<Tuple[int, Bytes, Bytes], Tuple[string, Bytes]> as
  let Map<Bytes,Bytes> values;

  on_start(): void {
    self.values = ~map<Bytes,Bytes>();
    return;
  }

  receive(ActorMail<Tuple[int, Bytes, Bytes]> mail): void {
    const tuple = mail.value;
    const int kind = tuple[0];
    const Bytes key = tuple[1];
    const Bytes value = tuple[2];

    if kind == 5; do self.end(); return; fi
    if kind == 3; do
      self.values.set(key, value);
      self.send(("OK", value));
      return;
    fi
    if kind == 2; do
      val found = self.values.get_optional(key);
      if found.is_none(); do
        self.send(("NIL", key));
      else
        self.send(("VALUE", found.unwrap()));
      fi
      return;
    fi
    if kind == 4; do
      if self.values.delete(key); do
        self.send(("ONE", key));
      else
        self.send(("ZERO", key));
      fi
      return;
    fi
    self.send(("ERR", key));
    return;
  }
end

// Buffered-only batching: await the first frame, then consume at most 15
// additional *already received* complete frames. Never wait for a full batch.
// Every SET/GET/DEL is still executed by the Atto-owned Map<Bytes,Bytes> actor.
// All responses remain in wire order, including PING, errors and QUIT.
// One connection, bounded 1..64 command batches, no WAL/replication.
// Collect ordered Atto-owned replies and serialize once with NIO2 per batch.
pub async routine main(): void {
  val worker = spawn OwnedBytesNioKvActor();
  await worker.get_ready();
  val listener = await network.listen_async("127.0.0.1", 16399);
  val socket = await listener.accept_async();

  loop {
    val frames = await socket.read_resp2_binary_batch_async(16);
    let int accepted = 0;
    let int i = 0;
    // Admit each valid data command before waiting for any reply. This is
    // intentionally NOT a second Java-side KV engine or an extra actor.
    loop {
      if i == frames.size then break; fi
      const Tuple[int,string,Bytes,Bytes] frame = frames.get(i);
      const int kind = frame[0];
      accepted = accepted + 1;
      if kind == 0 || kind == 5 then break; fi
      if kind != 1; do
        worker.send((kind, frame[2], frame[3]));
      fi
      i = i + 1;
    }

    // Exactly one Atto actor stream owns the replies. Collect up to 16
    // already-executed commands in wire order; do NOT introduce host KV.
    let mut List[Tuple[string, Bytes]] replies = [];
    let int j = 0;
    loop {
      if j == accepted then break; fi
      const Tuple[int,string,Bytes,Bytes] frame = frames.get(j);
      const int kind = frame[0];
      if kind == 0 || kind == 5; do
        if kind == 5; do
          replies.add(("OK", frame[3]));
        fi
        if replies.size > 0; do
          await socket.write_resp2_binary_batch_async(replies);
        fi
        await socket.close_async();
        await listener.close_async();
        worker.send((5, frame[2], frame[3]));
        await worker.get_done();
        return;
      fi
      if kind == 1; do
        replies.add(("PONG", frame[3]));
      else
        val output = (await worker.outputs.next()).value.unwrap();
        const Tuple[string,Bytes] reply = output.value;
        replies.add(reply);
      fi
      j = j + 1;
    }
    // One NIO2 completion and Future per *reply batch*, not per reply.
    // Immutable Bytes are detached during Java transport serialization.
    if replies.size > 0; do
      await socket.write_resp2_binary_batch_async(replies);
    fi
  }
}
