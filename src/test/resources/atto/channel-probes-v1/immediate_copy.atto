// Atomic immediate channel probes are distinct from waiting/async operations.
pub routine main(): void {
  val Channel<int> channel = Channel.new<int>(1);
  val bool first = try writech channel, 41;
  val bool full = try writech channel, 42;
  val Option<int> received = try readch channel;
  val Option<int> empty = try readch channel;
  val bool retried = try writech channel, 42;
  if first && !full && received.is_some() && empty.is_none() && retried then
    stdio.stdout.write(received.unwrap());
    stdio.stdout.write(readch channel);
  else
    stdio.stdout.write("unexpected");
  fi
  return;
}
