// Typed immediate probes: Accepted, Full, and successful retry.
pub routine main(): void {
  val Channel<int> channel = Channel.new<int>(1);
  val TryWriteResult<int> first_result = try writech channel, 41;
  val TryWriteResult<int> full = try writech channel, 42;
  val Option<int> received = try readch channel;
  val Option<int> empty = try readch channel;
  val TryWriteResult<int> retried = try writech channel, 42;
  do match first_result over
    on Accepted -> { }
    on Full(n) -> { stdio.stdout.write("unexpected-first-full"); }
    on Closed(n) -> { stdio.stdout.write("unexpected-first-closed"); }
  end
  do match full over
    on Accepted -> { stdio.stdout.write("unexpected-full-accepted"); }
    on Full(n) -> {
      if received.is_some() && empty.is_none() && n == 42 then
        stdio.stdout.write(received.unwrap());
      else
        stdio.stdout.write("unexpected-read");
      fi
    }
    on Closed(n) -> { stdio.stdout.write("unexpected-full-closed"); }
  end
  do match retried over
    on Accepted -> { stdio.stdout.write(readch channel); }
    on Full(n) -> { stdio.stdout.write("unexpected-retry-full"); }
    on Closed(n) -> { stdio.stdout.write("unexpected-retry-closed"); }
  end
  return;
}
