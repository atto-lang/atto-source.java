// Capacity-zero channels reject unmatched immediate writes without waiter registration.
pub routine main(): void {
  val Channel<int> channel = Channel.new<int>(0);
  val TryWriteResult<int> result = try writech channel, 17;
  do match result over
    on Accepted -> { stdio.stdout.write("unexpected-accepted"); }
    on Full(value) -> { stdio.stdout.write(value); }
    on Closed(value) -> { stdio.stdout.write("unexpected-closed"); }
  end
  return;
}
