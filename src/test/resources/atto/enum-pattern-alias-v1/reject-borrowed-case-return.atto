define enum WorkerMsg {
    Run { job_id: int, payload: Bytes },
    Stop
}

fnc bad_escape(WorkerMsg msg, &Bytes fallback): &Bytes {
    do match msg over
        on Run { job_id, payload } as r -> {
            return r.payload;
        }
        on Stop -> {
            return fallback;
        }
    end
}
