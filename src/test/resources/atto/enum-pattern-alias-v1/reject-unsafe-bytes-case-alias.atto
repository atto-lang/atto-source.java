define enum WorkerMsg {
    Run { job_id: int, payload: Bytes },
    Stop
}
fnc bad(WorkerMsg msg): int {
    return match msg over {
        on Run { job_id, payload } as r {
            // Non-Copy field is borrowed: rt take cannot reclaim ownership.
            val stolen = rt take r.payload;
            return job_id;
        }
        on Stop { return 0; }
    };
}
