// Owned Bytes require borrow-safe case-field lowering, not implicit copying.
define enum WorkerMsg {
    Run { job_id: int, payload: Bytes },
    Stop
}
fnc bad(WorkerMsg msg): int {
    return match msg over {
        on Run { job_id, payload } as r { return r.job_id; }
        on Stop { return 0; }
    };
}
