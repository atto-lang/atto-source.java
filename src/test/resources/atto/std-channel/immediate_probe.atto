// expect-stdout: accepted:full:2:1
import module channel from "std/channel";

pub async routine main(): void {
  val Channel<int> ch = channel.bounded<int>(1);
  val TryWriteResult<int> probe = channel.try_send<int>(ch, 1);
  val TryWriteResult<int> second = channel.try_send<int>(ch, 2);
  do match probe over
    on Accepted -> { stdio.out.write("accepted"); }
    on Full(value) -> { stdio.out.write("unexpected-probe-full"); }
    on Closed(value) -> { stdio.out.write("unexpected-probe-closed"); }
  end
  do match second over
    on Accepted -> { stdio.out.write("unexpected-second-accepted"); }
    on Full(value) -> {
      stdio.out.write(":full:");
      stdio.out.write(value);
    }
    on Closed(value) -> { stdio.out.write("unexpected-second-closed"); }
  end
  stdio.out.write(":");
  stdio.out.write(await channel.receive<int>(ch));
  channel.close<int>(ch);
  return;
}
