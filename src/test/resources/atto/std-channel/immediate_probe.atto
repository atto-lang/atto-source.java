// expect-stdout: accepted:full:2:1
import module channel from "std/channel";

pub routine main(): void {
  val Channel<int> ch = channel.bounded<int>(1);
  val TryWriteResult<int> first = channel.try_send<int>(ch, 1);
  val TryWriteResult<int> second = channel.try_send<int>(ch, 2);
  do match first over
    on Accepted -> { stdio.stdout.write("accepted"); }
    on Full(value) -> { stdio.stdout.write("unexpected-first-full"); }
    on Closed(value) -> { stdio.stdout.write("unexpected-first-closed"); }
  end
  do match second over
    on Accepted -> { stdio.stdout.write("unexpected-second-accepted"); }
    on Full(value) -> {
      stdio.stdout.write(":full:");
      stdio.stdout.write(value);
    }
    on Closed(value) -> { stdio.stdout.write("unexpected-second-closed"); }
  end
  stdio.stdout.write(":");
  stdio.stdout.write(channel.receive<int>(ch));
  channel.close<int>(ch);
  return;
}
