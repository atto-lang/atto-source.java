// Compiler-owned ores.core source.
// This module has no OS, Java, filesystem, network, process, actor-scheduler,
// or ambient project dependency.

define module numeric as

  pub fnc min_int(int left, int right): int {
    if left < right; do
      return left;
    fi
    return right;
  }

  pub fnc max_int(int left, int right): int {
    if left > right; do
      return left;
    fi
    return right;
  }

  pub fnc clamp_int(int value, int lower, int upper): int {
    if lower > upper; do
      return lower;
    fi
    if value < lower; do
      return lower;
    fi
    if value > upper; do
      return upper;
    fi
    return value;
  }

  // Native Oreslang wrappers around the Java backend's sealed named
  // intrinsics. Other backends must independently implement the same contract
  // before claiming support; do not fall back to Java interoperability.
  pub fnc rem_int(int dividend, int divisor): int {
    return Integer.rem(dividend, divisor);
  }

  pub fnc mod_int(int dividend, int divisor): int {
    return Integer.mod(dividend, divisor);
  }

  // No caret syntax is necessary for native guest bitwise XOR.
  pub fnc bit_xor_int(int left, int right): int {
    return (left & ~right) | (~left & right);
  }

end
