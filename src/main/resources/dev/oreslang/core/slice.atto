// Freestanding checked scalar arithmetic for contiguous borrowed slices.
// This is a pure preflight library: no allocation, backing pointer, owner token,
// or borrow authority is created by importing it.
// The compiler must enforce Slice<T> provenance, mutability and suspension gates.
define module slice as

  // -1 means invalid. Every successful index is in [0, length).
  // Compare against -length before adding length: even MIN_INT is safe.
  pub fnc normalize_index(int index, int length): int {
    if length <= 0; do return -1; fi
    if index >= 0; do
      if index < length; do return index; fi
      return -1;
    fi
    if index < -length; do return -1; fi
    return length + index;
  }

  // A raw index is already normalized and must be nonnegative.
  // This matches the sibling core/slice logical-window convention.
  pub fnc valid_index(int index, int length): bool {
    return index >= 0 && length >= 0 && index < length;
  }

  // Candidate collection indexing accepts -len <= index < len.
  // Distinct from valid_index to avoid overloading the meaning of "valid".
  pub fnc valid_signed_index(int index, int length): bool {
    return normalize_index(index, length) >= 0;
  }

  pub fnc is_empty(int count): bool {
    return count == 0;
  }

  pub fnc can_split_at(int count, int middle): bool {
    return count >= 0 && middle >= 0 && middle <= count;
  }

  // Explicit half-open endpoints permit [0,length], including an empty
  // container. Omitted negative-stride end (-1 sentinel) is NOT represented.
  pub fnc normalize_bound(int bound, int length): int {
    if length < 0; do return -1; fi
    if bound >= 0; do
      if bound <= length; do return bound; fi
      return -1;
    fi
    if bound < -length; do return -1; fi
    return length + bound;
  }

  pub fnc valid_endpoints(int start, int end_bound, int length): bool {
    return normalize_bound(start, length) >= 0 &&
           normalize_bound(end_bound, length) >= 0;
  }

  // Canonical logical window meaning, aligned with sibling core/slice PR.
  pub fnc valid_range(int offset, int count, int length): bool {
    return valid_window(offset, count, length);
  }

  // Positive-step range element count, 0 for a valid empty/reversed interval,
  // and -1 for an invalid explicit bound. No unchecked addition/multiplication.
  pub fnc range_len(int start, int end_bound, int length): int {
    val int first = normalize_bound(start, length);
    val int last = normalize_bound(end_bound, length);
    if first < 0 || last < 0; do return -1; fi
    if first >= last; do return 0; fi
    return last - first;
  }

  // A view is [offset, offset + count). Subtract only after bounds validation.
  pub fnc valid_window(int offset, int count, int length): bool {
    if offset < 0 || count < 0 || length < 0; do return false; fi
    if offset > length; do return false; fi
    return count <= length - offset;
  }

  // This scalar helper supports only positive stride. Reverse/strided view
  // constructors must remain compiler-gated until their representation ships.
  pub fnc valid_strided_window(int offset, int stride, int count, int length): bool {
    if stride <= 0 || count < 0; do return false; fi
    if !valid_window(offset, 0, length); do return false; fi
    if count == 0; do return true; fi
    if offset >= length; do return false; fi
    return count - 1 <= idiv((length - 1 - offset), stride);
  }

  // Local-only helpers for copyable integer elements. Array<int>.get_copy()
  // is checked by the language's named-owner and Copy<int> rules.
  // The caller passes rt borrow array; the helper never consumes the Array owner.
  // No borrowed element or pointer is returned, even when index is invalid.
  pub fnc get_copy_int(borrow Array<int> values, int offset,
                       int count, int index): Option<int> {
    if !valid_window(offset, count, values.size); do
      return None;
    fi
    val int relative = normalize_index(index, count);
    if relative < 0; do return None; fi
    return values.get_copy(offset + relative);
  }

  pub fnc first_copy_int(borrow Array<int> values, int offset,
                         int count): Option<int> {
    if !valid_window(offset, count, values.size); do return None; fi
    if count == 0; do return None; fi
    return values.get_copy(offset);
  }

  pub fnc last_copy_int(borrow Array<int> values, int offset,
                        int count): Option<int> {
    if !valid_window(offset, count, values.size); do return None; fi
    if count == 0; do return None; fi
    // Validation establishes offset + count - 1 < values.size without overflow.
    return values.get_copy(offset + count - 1);
  }

  // Validated nested window origin; invalid ranges never compute offset + sub.
  // This arithmetic receipt cannot be used after the backing array is moved,
  // deallocated or mutated without separately proving its current lifetime.
  pub fnc subslice_offset(int offset, int count, int length,
                          int relative_offset, int relative_count): Option<int> {
    if !valid_window(offset, count, length); do return None; fi
    if !valid_window(relative_offset, relative_count, count); do return None; fi
    return Some(offset + relative_offset);
  }

  // Negative-stride arithmetic preflight. MIN_INT is treated specially so
  // negating the signed stride never overflows. A zero-count window is legal
  // only when its offset is in [0,length]; this helper is not a view ctor.
  pub fnc valid_reverse_window(int offset, int stride,
                               int count, int length): bool {
    if stride >= 0 || count < 0; do return false; fi
    if !valid_window(offset, 0, length); do return false; fi
    if count == 0; do return true; fi
    if offset >= length; do return false; fi
    if stride == -9223372036854775808; do
      return count == 1;
    fi
    return count - 1 <= idiv(offset, 0 - stride);
  }

  // Array-view search/compare helpers (from atto-source.java#1772).
  // Option distinguishes an absent element (including an invalid span)
  // from the integer zero. Returned integers are independent values.
  pub fnc get_int(Array<int> values, int offset, int count,
                  int index): Option<int> {
    if !valid_range(offset, count, values.size); do
      return None;
    fi
    if !valid_index(index, count); do
      return None;
    fi
    return Some(values.get(offset + index));
  }

  pub fnc first_int(Array<int> values, int offset,
                    int count): Option<int> {
    return get_int(values, offset, count, 0);
  }

  pub fnc last_int(Array<int> values, int offset,
                   int count): Option<int> {
    if count <= 0; do
      return None;
    fi
    return get_int(values, offset, count, count - 1);
  }

  // Returns the first relative index, not the absolute array index.
  pub fnc find_int(Array<int> values, int offset, int count,
                   int needle): Option<int> {
    if !valid_range(offset, count, values.size); do
      return None;
    fi
    for (let int i = 0; i < count; i = i + 1) {
      if values.get(offset + i) == needle; do
        return Some(i);
      fi
    }
    return None;
  }

  pub fnc contains_int(Array<int> values, int offset,
                       int count, int needle): bool {
    return find_int(values, offset, count, needle).is_some();
  }

  pub fnc count_int(Array<int> values, int offset,
                    int count, int needle): Option<int> {
    if !valid_range(offset, count, values.size); do
      return None;
    fi
    let int found = 0;
    for (let int i = 0; i < count; i = i + 1) {
      if values.get(offset + i) == needle; do
        found = found + 1;
      fi
    }
    return Some(found);
  }

  pub fnc equal_int(Array<int> left, int left_offset, int left_count,
                    Array<int> right, int right_offset, int right_count): bool {
    if !valid_range(left_offset, left_count, left.size) ||
       !valid_range(right_offset, right_count, right.size); do
      return false;
    fi
    if left_count != right_count; do
      return false;
    fi
    for (let int i = 0; i < left_count; i = i + 1) {
      if left.get(left_offset + i) != right.get(right_offset + i); do
        return false;
      fi
    }
    return true;
  }

  pub fnc starts_with_int(Array<int> values, int offset, int count,
                          Array<int> prefix, int prefix_offset,
                          int prefix_count): bool {
    if !valid_range(offset, count, values.size) ||
       !valid_range(prefix_offset, prefix_count, prefix.size); do
      return false;
    fi
    if prefix_count > count; do
      return false;
    fi
    for (let int i = 0; i < prefix_count; i = i + 1) {
      if values.get(offset + i) != prefix.get(prefix_offset + i); do
        return false;
      fi
    }
    return true;
  }

  pub fnc ends_with_int(Array<int> values, int offset, int count,
                        Array<int> suffix, int suffix_offset,
                        int suffix_count): bool {
    if !valid_range(offset, count, values.size) ||
       !valid_range(suffix_offset, suffix_count, suffix.size); do
      return false;
    fi
    if suffix_count > count; do
      return false;
    fi
    let int tail = offset + (count - suffix_count);
    for (let int i = 0; i < suffix_count; i = i + 1) {
      if values.get(tail + i) != suffix.get(suffix_offset + i); do
        return false;
      fi
    }
    return true;
  }

  // Floor division for a >= 0 and b > 0 (int/int yields float on this backend).
  fnc idiv(int a, int b): int {
    let mut int q = 0;
    let mut int r = a;
    while r >= b do
      let mut int d = b;
      let mut int m = 1;
      while d <= r - d do
        d = d + d;
        m = m + m;
      done
      r = r - d;
      q = q + m;
    done
    return q;
  }
end
