// AttoLang core/result (Java/Graal): source-owned, no host interop.
// Ok/Err are values; callbacks cannot silently catch throw/raise/panic.
// Result operations consume their receiver; compiler must prove exact drops.
define module result as
  pub fnc flatten<T, E>(
    Result<Result<T, E>, E> input
  ): Result<T, E> {
    return match input over
      on Ok(inner) -> inner,
      on Err(error) -> Err(error),
    end;
  }

  pub fnc map<T, U, E>(
    Result<T, E> input, Fnc<U(T)> transform
  ): Result<U, E> {
    return match input over
      on Ok(value) -> Ok(transform(value)),
      on Err(error) -> Err(error),
    end;
  }

  pub fnc and_then<T, U, E>(
    Result<T, E> input, Fnc<Result<U, E>(T)> next
  ): Result<U, E> {
    return match input over
      on Ok(value) -> next(value),
      on Err(error) -> Err(error),
    end;
  }

  pub fnc map_err<T, E, F>(
    Result<T, E> input, Fnc<F(E)> transform
  ): Result<T, F> {
    return match input over
      on Ok(value) -> Ok(value),
      on Err(error) -> Err(transform(error)),
    end;
  }

  pub fnc or_else<T, E, F>(
    Result<T, E> input, Fnc<Result<T, F>(E)> recover
  ): Result<T, F> {
    return match input over
      on Ok(value) -> Ok(value),
      on Err(error) -> recover(error),
    end;
  }

  pub fnc unwrap_or_else<T, E>(
    Result<T, E> input, Fnc<T(E)> recover
  ): T {
    return match input over
      on Ok(value) -> value,
      on Err(error) -> recover(error),
    end;
  }

  pub fnc to_option<T, E>(Result<T, E> input): Option<T> {
    return match input over
      on Ok(value) -> Some(value),
      on Err(_) -> None,
    end;
  }

  pub fnc err_option<T, E>(Result<T, E> input): Option<E> {
    return match input over
      on Ok(_) -> None,
      on Err(error) -> Some(error),
    end;
  }

  pub fnc transpose<T, E>(
    Result<Option<T>, E> input
  ): Option<Result<T, E>> {
    return match input over
      on Err(error) -> Some(Err(error)),
      on Ok(inner) -> match inner over
        on Some(value) -> Some(Ok(value)),
        on None -> None,
      end,
    end;
  }

  pub fnc merge<T>(Result<T, T> input): T {
    return match input over
      on Ok(value) -> value,
      on Err(error) -> error,
    end;
  }
end
