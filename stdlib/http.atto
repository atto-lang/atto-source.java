// AttoLang hosted std/http — Java/GraalVM implementation (v1).
// Source-owned HTTP/1.1 message policy only; NEVER grants network authority.
// Transport owns permissions, DNS/TLS, byte-bounded reads, cancel, ownership,
// redirects, decompression, body streams, timeout and header normalization.
use namespace http;

  // Typed, validated HTTP metadata only. Raw bytes and privileged I/O are
  // owned by the transport; these values are not network capabilities.
  pub define class HeaderField as
    pub val String name;
    pub val String value;
    pub constructor(String name, String value) {
      if !header_line_valid(name, value, 65536) then
        rt fail("invalid HTTP header construction");
      fi
      self.name = name;
      self.value = value;
    }
  end

  pub define class RequestMeta as
    pub val String method;
    pub val String target;
    // -1 means unspecified, NOT zero and NOT an admitted stream length.
    pub val int content_length;
    pub constructor(String method, String target, int content_length) {
      if !method_valid(method) || !origin_target_valid(target) ||
         content_length < -1 || content_length > 1073741824 then
        rt fail("invalid HTTP request metadata construction");
      fi
      self.method = method;
      self.target = target;
      self.content_length = content_length;
    }
  end

  pub define class ResponseMeta as
    pub val int status;
    pub val bool can_have_body;
    pub constructor(int status, bool is_head, bool is_connect) {
      if !status_valid(status) then
        rt fail("invalid HTTP response status construction");
      fi
      self.status = status;
      self.can_have_body = response_body_allowed(status, is_head, is_connect);
    }
  end

  pub define class RequestLine as
    pub val String method;
    pub val String target;
  end

  fnc is_alpha(int c): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
  }

  fnc is_digit(int c): bool {
    return c >= 48 && c <= 57;
  }

  fnc is_hex_digit(int c): bool {
    return is_digit(c) || (c >= 65 && c <= 70) ||
           (c >= 97 && c <= 102);
  }

  // RFC 9110 tchar; no whitespace, separators, controls, or Unicode.
  fnc is_token_char(int c): bool {
    if is_alpha(c) || is_digit(c) then return true; fi
    return c == 33 || c == 35 || c == 36 || c == 37 ||
           c == 38 || c == 39 || c == 42 || c == 43 ||
           c == 45 || c == 46 || c == 94 || c == 95 ||
           c == 96 || c == 124 || c == 126;
  }

  pub fnc method_valid(String method): bool {
    val points = method.codepoints();
    if points.size == 0 then return false; fi
    for (let int i = 0; i < points.size; i = i + 1) {
      if !is_token_char(points.get(i)) then return false; fi
    }
    return true;
  }

  pub fnc method_is_safe(String method): bool {
    return method == "GET" || method == "HEAD" ||
           method == "OPTIONS" || method == "TRACE";
  }

  pub fnc method_is_idempotent(String method): bool {
    return method_is_safe(method) || method == "PUT" || method == "DELETE";
  }

  pub fnc header_name_valid(String name): bool {
    return method_valid(name);
  }

  // Deliberately narrower than all RFC-valid field values: US-ASCII SP,
  // HTAB or visible ASCII only. This is a strict safe subset, not an
  // internationalized header codec. CR, LF, NUL and DEL fail closed.
  pub fnc header_value_valid(String value): bool {
    val points = value.codepoints();
    for (let int i = 0; i < points.size; i = i + 1) {
      val int c = points.get(i);
      if c != 9 && (c < 32 || c > 126) then return false; fi
    }
    return true;
  }

  // Limits apply to the exact ASCII field wire line "name: value".
  // A transport must independently enforce aggregate byte and field budgets.
  pub fnc header_line_valid(String name, String value, int max_bytes): bool {
    if max_bytes < 2 then return false; fi
    if !header_name_valid(name) || !header_value_valid(value) then return false; fi
    val int name_bytes = name.codepoints().size;
    val int value_bytes = value.codepoints().size;
    if name_bytes > max_bytes - 2 then return false; fi
    return value_bytes <= max_bytes - name_bytes - 2;
  }

  // Origin-form only: disallow absolute/authority-form, fragments and ASCII
  // whitespace. Raw %-escape decoding, URL normalization and host admission
  // remain transport responsibilities, never implicit network authorization.
  pub fnc origin_target_valid(String target): bool {
    if !target.starts_with("/") || target.starts_with("//") then return false; fi
    val points = target.codepoints();
    if points.size == 0 || points.size > 8192 then return false; fi
    for (let int i = 0; i < points.size; i = i + 1) {
      val int c = points.get(i);
      if c < 33 || c > 126 || c == 35 || c == 92 then return false; fi
      // Require valid pct-encoded octets; byte decoding/route admission must
      // still happen in the transport before a path can be dispatched.
      if c == 37 then
        if i + 2 >= points.size then return false; fi
        if !is_hex_digit(points.get(i + 1)) ||
           !is_hex_digit(points.get(i + 2)) then return false; fi
      fi
    }
    return true;
  }

  // Single already-separated request line only, never a wire read/parser.
  pub fnc parse_request_line(String line): Result<RequestLine, String> {
    val points = line.codepoints();
    if points.size == 0 || points.size > 8192 then
      return Err("request line size out of bounds");
    fi
    val parts = line.split_literal(" ");
    if parts.size != 3 then return Err("invalid request line"); fi
    val String method = parts.get(0);
    val String target = parts.get(1);
    if !method_valid(method) then return Err("invalid method token"); fi
    if !origin_target_valid(target) then return Err("invalid origin target"); fi
    if parts.get(2) != "HTTP/1.1" then return Err("unsupported HTTP version"); fi
    return Ok(new RequestLine(method, target));
  }

  pub fnc status_valid(int status): bool {
    return status >= 100 && status <= 599;
  }

  pub fnc status_is_success(int status): bool {
    return status >= 200 && status <= 299;
  }

  // HEAD and successful CONNECT never deliver an HTTP message body; CONNECT
  // bytes thereafter belong to the tunnel, NOT the HTTP response body.
  // 205 is a no-content status, like 204, regardless of Content-Length.
  pub fnc response_body_allowed(int status, bool is_head, bool is_connect): bool {
    if !status_valid(status) || is_head then return false; fi
    if status < 200 || status == 204 || status == 205 || status == 304 then return false; fi
    if is_connect && status_is_success(status) then return false; fi
    return true;
  }

  // HTTP/1.1 conservative framing policy. Reject TE+CL smuggling and reject
  // non-final chunked encodings. Caller parses exact field names and values,
  // duplicate Content-Length, trailer fields, and connection retirement.
  pub fnc request_framing_allowed(bool has_transfer_encoding, bool has_content_length,
                                  bool final_transfer_is_chunked): bool {
    if has_transfer_encoding && has_content_length then return false; fi
    if has_transfer_encoding then return final_transfer_is_chunked; fi
    return true;
  }

  // Subtraction-free length admission: no untrusted offset+length addition.
  pub fnc body_bytes_allowed(int bytes, int max_body_bytes): bool {
    if bytes < 0 || max_body_bytes < 0 then return false; fi
    return bytes <= max_body_bytes;
  }

  pub fnc header_budget_allowed(int head_bytes, int fields,
                                int max_head_bytes, int max_fields): bool {
    if head_bytes < 0 || fields < 0 then return false; fi
    if max_head_bytes < 0 || max_fields < 0 then return false; fi
    return head_bytes <= max_head_bytes && fields <= max_fields;
  }

  // Header fields are constructed through a checked factory, not by
  // interpreting unbounded line input or silently normalizing values.
  pub fnc header_field(String name, String value, int max_line_bytes): Result<HeaderField, String> {
    if !header_line_valid(name, value, max_line_bytes) then
      return Err("invalid or oversized header field");
    fi
    return Ok(new HeaderField(name, value));
  }

  pub fnc request_meta(String method, String target,
                       int content_length): Result<RequestMeta, String> {
    if !method_valid(method) || !origin_target_valid(target) then
      return Err("invalid HTTP request metadata");
    fi
    if content_length < -1 || content_length > 1073741824 then
      return Err("request length is out of bounds");
    fi
    return Ok(new RequestMeta(method, target, content_length));
  }

  pub fnc response_meta(int status, bool is_head,
                        bool is_connect): Result<ResponseMeta, String> {
    if !status_valid(status) then return Err("invalid response status"); fi
    return Ok(new ResponseMeta(status, is_head, is_connect));
  }

  // Strictly parse *three* ASCII decimal digits. An HTTP status line's reason
  // phrase is advisory, so this routine does not interpret it.
  pub fnc parse_status_code(String digits): Result<int, String> {
    val points = digits.codepoints();
    if points.size != 3 then return Err("status must have three digits"); fi
    let int status = 0;
    for (let int i = 0; i < 3; i = i + 1) {
      val int c = points.get(i);
      if c < 48 || c > 57 then return Err("invalid status digit"); fi
      status = status * 10 + c - 48;
    }
    if !status_valid(status) then return Err("HTTP status out of range"); fi
    return Ok(status);
  }

  // This only validates a complete, pre-bounded ASCII HTTP/1.1 status line;
  // it does not read a socket or accept HTTP/2 pseudo-headers.
  pub fnc parse_status_line(String line): Result<int, String> {
    val points = line.codepoints();
    if points.size < 12 || points.size > 1024 then
      return Err("status line size out of bounds");
    fi
    if !header_value_valid(line) || line.contains_literal("\t") then
      return Err("invalid status line controls");
    fi
    val parts = line.split_literal(" ");
    if parts.size < 2 then return Err("invalid status line"); fi
    if parts.get(0) != "HTTP/1.1" then return Err("unsupported HTTP version"); fi
    return parse_status_code(parts.get(1));
  }

  // Overflow-safe decimal Content-Length. Callers MUST reject duplicate or
  // conflicting framing headers, even if individually well-formed.
  pub fnc parse_content_length(String raw, int max_body_bytes): Result<int, String> {
    if max_body_bytes < 0 || max_body_bytes > 1073741824 then
      return Err("invalid Content-Length budget");
    fi
    val points = raw.codepoints();
    if points.size == 0 || points.size > 20 then
      return Err("invalid Content-Length digit count");
    fi
    let int value = 0;
    for (let int i = 0; i < points.size; i = i + 1) {
      val int c = points.get(i);
      if c < 48 || c > 57 then return Err("non-decimal Content-Length"); fi
      val int digit = c - 48;
      if digit > max_body_bytes then return Err("Content-Length exceeds budget"); fi
      if value > (max_body_bytes - digit) / 10 then
        return Err("Content-Length exceeds budget");
      fi
      value = value * 10 + digit;
    }
    return Ok(value);
  }

  pub fnc content_length_valid(String raw, int max_body_bytes): bool {
    return parse_content_length(raw, max_body_bytes).is_ok();
  }

  fnc route_parameter_valid(String segment): bool {
    val points = segment.codepoints();
    if points.size < 2 || points.get(0) != 58 then return false; fi
    val int first = points.get(1);
    if !is_alpha(first) && first != 95 then return false; fi
    for (let int i = 2; i < points.size; i = i + 1) {
      if !is_alpha(points.get(i)) && !is_digit(points.get(i)) &&
         points.get(i) != 95 then return false; fi
    }
    return true;
  }

  // Only literal and :named segments are supported. Wildcards, percent-
  // escaped paths, dot-segments and repeated separators need the future
  // canonical URL/router layer, and are deliberately denied here.
  pub fnc route_pattern_valid(String pattern): bool {
    if !origin_target_valid(pattern) || pattern.contains_literal("?") ||
       pattern.contains_literal("%") || pattern.contains_literal("//") then
      return false;
    fi
    if pattern == "/" then return true; fi
    val points = pattern.codepoints();
    if points.size > 8192 then return false; fi
    val segments = pattern.split_literal("/");
    if segments.size > 65 then return false; fi
    for (let int i = 1; i < segments.size; i = i + 1) {
      val String segment = segments.get(i);
      if segment == "" || segment == "." || segment == ".." then return false; fi
      if segment.starts_with(":") && !route_parameter_valid(segment) then
        return false;
      fi
      if segment == "*" then return false; fi
    }
    return true;
  }

  // Query is not part of the route. The returned bool carries NO authority:
  // host admission, endpoint permissions and body limits still apply.
  pub fnc route_matches(String pattern, String target): bool {
    if !route_pattern_valid(pattern) || !origin_target_valid(target) then
      return false;
    fi
    val target_parts = target.split_literal("?");
    val String path = target_parts.get(0);
    if pattern == "/" then return path == "/"; fi
    val path_points = path.codepoints();
    if path_points.size > 8192 then return false; fi
    if path.contains_literal("%") || path.contains_literal("//") then
      return false;
    fi
    val route_parts = pattern.split_literal("/");
    val path_parts = path.split_literal("/");
    if route_parts.size != path_parts.size then return false; fi
    for (let int i = 1; i < route_parts.size; i = i + 1) {
      val String expected = route_parts.get(i);
      val String actual = path_parts.get(i);
      if actual == "" || actual == "." || actual == ".." then return false; fi
      if expected.starts_with(":") then
        if !route_parameter_valid(expected) then return false; fi
      elif expected != actual then
        return false;
      fi
    }
    return true;
  }

  pub fnc route_matches_method(String expected_method, String pattern,
                                String request_method, String target): bool {
    if !method_valid(expected_method) || !method_valid(request_method) then
      return false;
    fi
    return expected_method == request_method && route_matches(pattern, target);
  }

  // Stream admission accounting owned by a single request/response reader.
  // Does not read, allocate, decompress, or issue host network operations.
  // Call admit() BEFORE allocating/copying any inbound transport chunk.
  pub define class BodyBudget as
    let int max_bytes;
    let mut int consumed_bytes = 0;
    let mut bool closed = false;

    pub constructor(int max_bytes) {
      if max_bytes < 0 || max_bytes > 1073741824 then
        rt fail("invalid HTTP body budget");
      fi
      self.max_bytes = max_bytes;
    }

    pub admit(mut self)(int chunk_bytes): bool {
      if self.closed || chunk_bytes < 0 then return false; fi
      if chunk_bytes > self.max_bytes - self.consumed_bytes then
        return false;
      fi
      self.consumed_bytes = self.consumed_bytes + chunk_bytes;
      return true;
    }

    pub finish(mut self)(): bool {
      if self.closed then return false; fi
      self.closed = true;
      return true;
    }

    pub is_closed(): bool {
      return self.closed;
    }

    pub consumed(): int {
      return self.consumed_bytes;
    }

    pub remaining(): int {
      return self.max_bytes - self.consumed_bytes;
    }
  end

  pub fnc body_budget(int max_bytes): Result<BodyBudget, String> {
    if max_bytes < 0 || max_bytes > 1073741824 then
      return Err("body budget out of bounds");
    fi
    return Ok(new BodyBudget(max_bytes));
  }

  // Resource ceilings only; not a token, grant or authenticated network
  // capability. The transport intersects stronger private actor/tenant limits.
  pub define class ClientLimits as
    pub val int max_body_bytes;
    pub val int max_header_bytes;
    pub val int max_redirects;
    pub val int timeout_ms;

    pub constructor(int max_body_bytes, int max_header_bytes,
                    int max_redirects, int timeout_ms) {
      if max_body_bytes < 0 || max_body_bytes > 1073741824 ||
         max_header_bytes < 512 || max_header_bytes > 65536 ||
         max_redirects < 0 || max_redirects > 16 ||
         timeout_ms < 1 || timeout_ms > 600000 then
        rt fail("invalid HTTP client limits construction");
      fi
      self.max_body_bytes = max_body_bytes;
      self.max_header_bytes = max_header_bytes;
      self.max_redirects = max_redirects;
      self.timeout_ms = timeout_ms;
    }
  end

  pub fnc client_limits(int max_body_bytes, int max_header_bytes,
                        int max_redirects, int timeout_ms): Result<ClientLimits, String> {
    if max_body_bytes < 0 || max_body_bytes > 1073741824 then
      return Err("client body ceiling invalid");
    fi
    if max_header_bytes < 512 || max_header_bytes > 65536 then
      return Err("client header ceiling invalid");
    fi
    if max_redirects < 0 || max_redirects > 16 then
      return Err("client redirect ceiling invalid");
    fi
    if timeout_ms < 1 || timeout_ms > 600000 then
      return Err("client timeout invalid");
    fi
    return Ok(new ClientLimits(max_body_bytes, max_header_bytes,
                               max_redirects, timeout_ms));
  }

  pub define class ServerLimits as
    pub val int max_connections;
    pub val int max_request_body_bytes;
    pub val int max_header_bytes;

    pub constructor(int max_connections, int max_request_body_bytes,
                    int max_header_bytes) {
      if max_connections < 1 || max_connections > 65536 ||
         max_request_body_bytes < 0 || max_request_body_bytes > 1073741824 ||
         max_header_bytes < 512 || max_header_bytes > 65536 then
        rt fail("invalid HTTP server limits construction");
      fi
      self.max_connections = max_connections;
      self.max_request_body_bytes = max_request_body_bytes;
      self.max_header_bytes = max_header_bytes;
    }
  end

  pub fnc server_limits(int max_connections, int max_request_body_bytes,
                        int max_header_bytes): Result<ServerLimits, String> {
    if max_connections < 1 || max_connections > 65536 then
      return Err("server connection ceiling invalid");
    fi
    if max_request_body_bytes < 0 || max_request_body_bytes > 1073741824 then
      return Err("server request-body ceiling invalid");
    fi
    if max_header_bytes < 512 || max_header_bytes > 65536 then
      return Err("server header ceiling invalid");
    fi
    return Ok(new ServerLimits(max_connections, max_request_body_bytes,
                               max_header_bytes));
  }

  // Pure structural redirect candidate only. The transport MUST perform
  // new egress/DNS/TLS/IP/credential authorization on every hop. A caller
  // cannot confer permissions by passing true to a public Atto function.
  pub fnc redirect_candidate(int status, bool has_location,
                             int completed_hops, int max_hops): bool {
    if !has_location || completed_hops < 0 || max_hops < 0 then return false; fi
    if completed_hops >= max_hops then return false; fi
    return status == 301 || status == 302 || status == 303 ||
           status == 307 || status == 308;
  }

  // A retry recommendation is never an execution decision. The privileged
  // transport must independently determine whether a request was sent,
  // whether the request body can be replayed, and if auth remains valid.
  // Conservative default: only GET/HEAD, only before response is observed.
  pub fnc retry_candidate(String method, int prior_retries,
                          int max_retries, bool response_started): bool {
    if method != "GET" && method != "HEAD" then return false; fi
    if prior_retries < 0 || max_retries < 0 || max_retries > 8 then return false; fi
    if response_started || prior_retries >= max_retries then return false; fi
    return true;
  }
