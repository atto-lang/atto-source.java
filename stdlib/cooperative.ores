// Cooperative collection algorithms. Each callback is invoked sequentially;
// only the compiler-owned for-loop back-edge may suspend the owning task.
define module cooperative as
  pub fnc map<T, R>(Array<T> values, Fnc<T, R> transform): Array<R> {
    let mut Array<R> output = new Array<R>();
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      output.add(transform(values.get(i)));
    }
    return output;
  }

  pub fnc filter<T>(Array<T> values, Fnc<T, bool> predicate): Array<T> {
    let mut Array<T> output = new Array<T>();
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      val item = values.get(i);
      if predicate(item); do
        output.add(item);
      fi
    }
    return output;
  }

  pub fnc reduce<T, R>(Array<T> values, R initial, Fnc<R, T, R> combine): R {
    let result = initial;
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      result = combine(result, values.get(i));
    }
    return result;
  }

  pub fnc forEach<T>(Array<T> values, Fnc<T, void> action): void {
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      action(values.get(i));
    }
    return;
  }
  // Short-circuit operators preserve the predicate's side effects, and stop
  // without a gratuitous handoff after a decisive result.
  pub fnc any<T>(Array<T> values, Fnc<T, bool> predicate): bool {
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      if predicate(values.get(i)); do
        return true;
      fi
    }
    return false;
  }

  pub fnc all<T>(Array<T> values, Fnc<T, bool> predicate): bool {
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      if !predicate(values.get(i)); do
        return false;
      fi
    }
    return true;
  }

  // Both dimensions use the same task-local loop cooperation engine, rather
  // than spawning a Future per callback or per nested element.
  pub fnc flatMap<T, R>(Array<T> values, Fnc<T, Array<R>> transform): Array<R> {
    let mut Array<R> output = new Array<R>();
    val count = values.size;
    rt cooperative for let i = 0; i < count; i++ {
      val chunk = transform(values.get(i));
      val n = chunk.size;
      rt cooperative for let j = 0; j < n; j++ {
        output.add(chunk.get(j));
      }
    }
    return output;
  }
end
