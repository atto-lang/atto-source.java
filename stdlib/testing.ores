define module testing as
// Oreslang-native test framework.
//
// The framework intentionally contains no Java implementation code.
// Compiler/runtime hosts execute ordinary Oreslang; test definitions,
// assertions, filtering, reporting, and failure policy live here.

type TestBody = () => TestOutcome;
type IntProperty = (int) => TestOutcome;

pub define class TestOutcome as
  pub val bool passed;
  pub val String message;
end

pub define class TestCase as
  pub val String name;
  pub val TestBody body;
  pub val bool skipped;
  pub val String skip_reason;
end

pub define class TestSuite as
  pub val String name;
  pub val List<TestCase> tests;
end

pub define class TestOptions as
  // Empty means run all. Names are exact hierarchical names:
  // "suite/test" (and property/table cases should use slash-separated names).
  pub val String only;
  pub val bool fail_fast;
  pub val bool machine;
end

pub define class RunSummary as
  pub val int total;
  pub val int passed;
  pub val int failed;
  pub val int skipped;
  pub val int filtered;
end

pub fnc pass(): TestOutcome {
  return new TestOutcome(true, "");
}

pub fnc fail(String message): TestOutcome {
  return new TestOutcome(false, message);
}

pub fnc expect_true(bool actual, String message): TestOutcome {
  if actual; do
    return pass();
  else
    return fail(message);
  fi
}

pub fnc expect_false(bool actual, String message): TestOutcome {
  if !actual; do
    return pass();
  else
    return fail(message);
  fi
}

pub fnc expect_equal_int(int actual, int expected, String message): TestOutcome {
  if actual == expected; do
    return pass();
  else
    return fail(message);
  fi
}

pub fnc expect_equal_float(float actual, float expected, String message): TestOutcome {
  if actual == expected; do
    return pass();
  else
    return fail(message);
  fi
}

pub fnc expect_equal_string(String actual, String expected, String message): TestOutcome {
  if actual == expected; do
    return pass();
  else
    return fail(message);
  fi
}

pub fnc expect_near_float(
  float actual,
  float expected,
  float tolerance,
  String message
): TestOutcome {
  let float delta = actual - expected;
  if delta < 0.0; do
    delta = 0.0 - delta;
  fi

  if delta <= tolerance; do
    return pass();
  else
    return fail(message);
  fi
}

fnc selected(String full_name, String only): bool {
  if only == ""; do
    return true;
  fi

  return full_name == only;
}

fnc emit_status(String status, String full_name, String detail, bool machine): void {
  if machine; do
    stdio.stdout.write("ORES_TEST|");
    stdio.stdout.write(status);
    stdio.stdout.write("|");
    stdio.stdout.write(full_name);
    stdio.stdout.write("|");
    stdio.stdout.println(detail);
    return;
  fi

  stdio.stdout.write(status);
  stdio.stdout.write(" ");
  stdio.stdout.write(full_name);
  if detail != ""; do
    stdio.stdout.write(" -- ");
    stdio.stdout.write(detail);
  fi
  stdio.stdout.println("");
  return;
}

fnc emit_summary(borrow RunSummary summary, bool machine): void {
  let int total = summary.total;
  let int passed_count = summary.passed;
  let int failed_count = summary.failed;
  let int skipped_count = summary.skipped;
  let int filtered_count = summary.filtered;

  if machine; do
    stdio.stdout.write("ORES_TEST|SUMMARY|total=");
    stdio.stdout.write(total);
    stdio.stdout.write("|passed=");
    stdio.stdout.write(passed_count);
    stdio.stdout.write("|failed=");
    stdio.stdout.write(failed_count);
    stdio.stdout.write("|skipped=");
    stdio.stdout.write(skipped_count);
    stdio.stdout.write("|filtered=");
    stdio.stdout.println(filtered_count);
    return;
  fi

  stdio.stdout.write("test result: ");
  if failed_count == 0; do
    stdio.stdout.write("ok");
  else
    stdio.stdout.write("FAILED");
  fi
  stdio.stdout.write(". ");
  stdio.stdout.write(passed_count);
  stdio.stdout.write(" passed; ");
  stdio.stdout.write(failed_count);
  stdio.stdout.write(" failed; ");
  stdio.stdout.write(skipped_count);
  stdio.stdout.write(" skipped; ");
  stdio.stdout.write(filtered_count);
  stdio.stdout.println(" filtered");
  return;
}

pub fnc run_suite(borrow TestSuite suite, borrow TestOptions options): RunSummary {
  let int total = 0;
  let int passed_count = 0;
  let int failed_count = 0;
  let int skipped_count = 0;
  let int filtered_count = 0;
  // Keep borrowed member types explicit at this module boundary.
  let String suite_name = suite.name;
  let List<TestCase> tests = suite.tests;
  let String only = options.only;
  let bool fail_fast = options.fail_fast;
  let bool machine = options.machine;

  for const test_case of tests do
    let String full_name = suite_name + "/" + test_case.name;

    if !selected(full_name, only); do
      filtered_count = filtered_count + 1;
      continue;
    fi

    total = total + 1;

    if test_case.skipped; do
      skipped_count = skipped_count + 1;
      emit_status("SKIP", full_name, test_case.skip_reason, machine);
      continue;
    fi

    let TestOutcome outcome = test_case.body();

    if outcome.passed; do
      passed_count = passed_count + 1;
      emit_status("PASS", full_name, "", machine);
    else
      failed_count = failed_count + 1;
      emit_status("FAIL", full_name, outcome.message, machine);

      if fail_fast; do
        let RunSummary early = new RunSummary(
          total,
          passed_count,
          failed_count,
          skipped_count,
          filtered_count
        );
        emit_summary(rt borrow early, machine);
        return early;
      fi
    fi
  done

  let RunSummary summary = new RunSummary(
    total,
    passed_count,
    failed_count,
    skipped_count,
    filtered_count
  );
  emit_summary(rt borrow summary, machine);
  return summary;
}

pub fnc require_success(borrow RunSummary summary): void {
  let int failed_count = summary.failed;
  if failed_count > 0; do
    val Result<bool, String> failure = Err("one or more Oreslang tests failed");
    failure.expect("native Oreslang test suite failed");
  fi
  return;
}

// Deterministic table/property helper. The caller owns the exact cases,
// which makes failures reproducible by construction.
pub fnc check_int_cases(
  String property_name,
  List<int> cases,
  IntProperty property
): TestOutcome {
  for const value of cases do
    let TestOutcome outcome = property(value);
    if !outcome.passed; do
      if outcome.message == ""; do
        return fail("property failed: " + property_name);
      else
        return outcome;
      fi
    fi
  done

  return pass();
}

// ---------------------------------------------------------------------------
// Seeded property-based testing with deterministic shrinking (prop v1).
//
// Pure AttoLang: no Java interop, no wall clock, no hidden global RNG.
// A failure report always carries the seed and run index, so every
// counterexample is replayable by construction. Generation is MINSTD
// (Park-Miller) so every intermediate product fits in a signed i64 and
// no checked-arithmetic trap can occur inside the generator itself.
//
// Shrinking is greedy and bounded: the failing value moves toward the
// simplest in-range target (0 when admitted, otherwise the nearest bound)
// by power-of-two steps, keeping a step only while the property still
// fails. AttoLang int `/` yields float, so no division is used.
// ---------------------------------------------------------------------------

type IntPredicate = (int) => TestOutcome;

pub define class IntConfig as
  pub val int seed;
  pub val int runs;
  pub val int lo;
  pub val int hi;
  pub val int max_shrinks;
end

// Normalize any i64 seed into the MINSTD state space [1, 2^31 - 2].
pub fnc seed_state(int seed): int {
  return Integer.mod(seed, 2147483646) + 1;
}

pub fnc next_state(int state): int {
  return Integer.mod(state * 48271, 2147483647);
}

// Uniform-ish draw in [lo, hi] from a MINSTD state. Span is bounded so
// the draw never silently wraps; callers validate the config first.
pub fnc draw_int(int state, int lo, int hi): int {
  val int span = hi - lo + 1;
  return lo + Integer.mod(state, span);
}

pub fnc shrink_target(int lo, int hi): int {
  if lo <= 0 && hi >= 0; do
    return 0;
  fi
  if lo > 0; do
    return lo;
  fi
  return hi;
}

fnc distance(int a, int b): int {
  if a >= b; do
    return a - b;
  fi
  return b - a;
}

fnc largest_power_at_most(int limit): int {
  if limit < 1; do
    return 0;
  fi
  let mut int p = 1;
  while p <= limit - p; do
    p = p + p;
  done
  return p;
}

fnc toward(int value, int target, int step): int {
  if value > target; do
    return value - step;
  fi
  return value + step;
}

fnc config_error(borrow IntConfig config): String {
  if config.lo > config.hi; do
    return "prop: lo must be <= hi";
  fi
  if config.hi - config.lo >= 2147483646; do
    return "prop: hi - lo must be < 2147483646";
  fi
  if config.runs < 1 || config.runs > 100000; do
    return "prop: runs must be in [1, 100000]";
  fi
  if config.max_shrinks < 0 || config.max_shrinks > 4096; do
    return "prop: max_shrinks must be in [0, 4096]";
  fi
  return "";
}

// Edge cases come first (lo, hi, shrink target), then seeded draws.
fnc candidate_for_run(borrow IntConfig config, int run, int state): int {
  if run == 0; do
    return config.lo;
  fi
  if run == 1; do
    return config.hi;
  fi
  if run == 2; do
    return shrink_target(config.lo, config.hi);
  fi
  return draw_int(state, config.lo, config.hi);
}

// Runs edge cases then seeded draws; on the first failure, greedily shrinks
// toward shrink_target by power-of-two steps. The property is invoked only
// from this function body (never forwarded), matching check_int_cases.
pub fnc check_int(String property_name, IntConfig config, IntPredicate property): TestOutcome {
  val String invalid = config_error(rt borrow config);
  if invalid != ""; do
    return fail(invalid);
  fi
  let mut int state = seed_state(config.seed);
  let mut bool found = false;
  let mut int failing_run = 0;
  let mut int original = 0;
  for let mut int run = 0; run < config.runs && !found; run = run + 1 do
    state = next_state(state);
    val int value = candidate_for_run(rt borrow config, run, state);
    let TestOutcome outcome = property(value);
    if !outcome.passed; do
      found = true;
      failing_run = run;
      original = value;
    fi
  done
  if !found; do
    return pass();
  fi

  val int target = shrink_target(config.lo, config.hi);
  let mut int best = original;
  let mut int accepted = 0;
  let mut int step = largest_power_at_most(distance(best, target));
  for let mut int probes = 0; step >= 1 && accepted < config.max_shrinks && probes < 65536; probes = probes + 1 do
    val int candidate = toward(best, target, step);
    let TestOutcome shrunk_outcome = property(candidate);
    if !shrunk_outcome.passed; do
      best = candidate;
      accepted = accepted + 1;
      val int remaining = distance(best, target);
      if step > remaining; do
        step = largest_power_at_most(remaining);
      fi
    else
      step = largest_power_at_most(step - 1);
    fi
  done

  return fail("property " + property_name
    + " falsified: seed=" + to_string(config.seed)
    + " run=" + to_string(failing_run)
    + " original=" + to_string(original)
    + " shrunk=" + to_string(best)
    + " shrink_steps=" + to_string(accepted));
}

end
