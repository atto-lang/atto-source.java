// Native Oreslang pull Observable adapter.
// A channel has ONE consumer per delivered item; this is not a broadcast bus.
// The generator does not run or register an input read until a consumer pulls.
define module Observable as
  pub generator fnc from_ch<T>(Channel<T> source): Iterator<T> {
    for const item of source {
      yield item;
    }
    return;
  }

  // Adapt an existing native pull ReadableStream without adding a pump,
  // prefetcher, hidden guest thread or broadcast semantics. The stream keeps
  // its own one-consumer / EOF / backpressure behavior and is touched only
  // when this iterator is pulled.
  pub generator fnc from_stream<T>(ReadableStream<T> source): Iterator<T> {
    for const item of source {
      yield item;
    }
    return;
  }
end
