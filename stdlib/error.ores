// Canonical source for the std/error nominal type taxonomy (catalog v1).
// Codes are durable identifiers; never reuse or renumber an existing code.
// These are ordinary guest data types, NOT control effects. In particular,
// throw/raise/panic/cancellation and host-fatal failures are NOT implemented here.
// No Java interop, privileged runtime operations, mutable state or resources.
//
// Import examples:
//   import class Error from "std/error";
//   import class FileNotFoundError from "std/error";
//
// The manifest in contracts/v1/error-catalog.json must match this source.
// This initial schema intentionally has no user-provided message/cause fields:
// transport, ownership and diagnostic redaction require a separate parity gate.
// Abstract category classes are not constructible; interfaces express
// cross-cutting behavior without adding concrete inheritance edges.

pub define interface CodedError as
  fnc code() => int;
end

// Advisory contract only: never auto-retry non-idempotent operations.
pub define interface RetryAdvisory extends CodedError as
  fnc retry_hint() => bool;
end

pub define abstract class Error implements CodedError as
  pub code(): int;
end

pub define abstract class ArgumentError extends Error as
  pub code(): int { return 1000; }
end

pub define class InvalidArgumentError extends ArgumentError as
  pub code(): int { return 1001; }
end

pub define class MissingArgumentError extends ArgumentError as
  pub code(): int { return 1002; }
end

pub define class UnexpectedArgumentError extends ArgumentError as
  pub code(): int { return 1003; }
end

pub define class ArityError extends ArgumentError as
  pub code(): int { return 1004; }
end

pub define class TypeMismatchError extends ArgumentError as
  pub code(): int { return 1005; }
end

pub define class CastError extends ArgumentError as
  pub code(): int { return 1006; }
end

pub define class RangeError extends ArgumentError as
  pub code(): int { return 1007; }
end

pub define class IndexError extends ArgumentError as
  pub code(): int { return 1008; }
end

pub define abstract class StateError extends Error as
  pub code(): int { return 2000; }
end

pub define class InvalidStateError extends StateError as
  pub code(): int { return 2001; }
end

pub define class AlreadyInitializedError extends StateError as
  pub code(): int { return 2002; }
end

pub define class NotInitializedError extends StateError as
  pub code(): int { return 2003; }
end

pub define class ClosedError extends StateError as
  pub code(): int { return 2004; }
end

pub define class ReadOnlyError extends StateError as
  pub code(): int { return 2005; }
end

pub define class ImmutableError extends StateError as
  pub code(): int { return 2006; }
end

pub define class ConcurrentModificationError extends StateError as
  pub code(): int { return 2007; }
end

pub define class StaleHandleError extends StateError as
  pub code(): int { return 2008; }
end

pub define abstract class IOError extends Error as
  pub code(): int { return 3000; }
end

pub define abstract class FileSystemError extends IOError as
  pub code(): int { return 3090; }
end

pub define class FileNotFoundError extends FileSystemError as
  pub code(): int { return 3001; }
end

pub define class FileAlreadyExistsError extends FileSystemError as
  pub code(): int { return 3002; }
end

pub define class NotDirectoryError extends FileSystemError as
