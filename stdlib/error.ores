end

pub define class ConnectionResetError extends NetworkError implements RetryAdvisory as
  pub code(): int { return 4003; }
  pub retry_hint(): bool { return true; }
end

pub define class ConnectionAbortedError extends NetworkError as
  pub code(): int { return 4004; }
end

pub define class HostUnreachableError extends NetworkError as
