  pub retry_hint(): bool { return true; }
end

pub define class RetryLimitExceededError extends TimingError as
  pub code(): int { return 5004; }
end

pub define class BackpressureError extends TimingError implements RetryAdvisory as
  pub code(): int { return 5005; }
  pub retry_hint(): bool { return true; }
end

pub define class RateLimitedError extends TimingError implements RetryAdvisory as
  pub code(): int { return 5006; }
  pub retry_hint(): bool { return true; }
end

pub define class TimerConfigurationError extends TimingError as
