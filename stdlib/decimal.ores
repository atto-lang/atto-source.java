// Exact base-ten scalar operations. Source-first Oreslang stdlib; no host bridge.
// Decimal addition/subtraction/multiplication preserve all input digits.
// Division at the operator level uses deterministic decimal128 HALF_EVEN.
define module decimal as

  pub fnc sum(Array<decimal> values): decimal {
    let decimal total = 0d;
    for const value of values do
      total = total + value;
    done
    return total;
  }

  pub fnc pow_nonnegative(decimal value, int exponent): Result<decimal, String> {
    if exponent < 0 || exponent > 128; do
      return Err("decimal exponent must be between 0 and 128");
    fi
    let decimal result = 1d;
    let decimal base = value;
    let int n = exponent;
    for (let i = 0; i < n; i = i + 1) {
      result = result * base;
    }
    return Ok(result);
  }

  pub fnc horner(Array<decimal> descending_coefficients, decimal x): decimal {
    let decimal value = 0d;
    for const coefficient of descending_coefficients do
      value = value * x + coefficient;
    done
    return value;
  }

  // Explicit per-call MathContext. The VM owns the same closed intrinsic on
  // every backend; no ambient mutable precision or Java interop is exposed.
  // Supported rounding strings: HALF_EVEN, HALF_UP, HALF_DOWN, UP, DOWN,
  // CEILING, FLOOR, UNNECESSARY. Precision must be 1..4096.
  pub fnc divide(decimal numerator, decimal denominator, int precision, String rounding): decimal {
    return DecimalOps.divide(numerator, denominator, precision, rounding);
  }

  pub fnc round(decimal value, int precision, String rounding): decimal {
    return DecimalOps.round(value, precision, rounding);
  }

  pub fnc sqrt(decimal value, int precision, String rounding): decimal {
    return DecimalOps.sqrt(value, precision, rounding);
  }

end
