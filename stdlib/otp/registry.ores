// Oreslang-native bounded registry protocol.
//
// FIRST EXECUTABLE SOURCE SLICE ONLY. This module does not provide global
// mutable storage or distributed naming. Runtime/library integration must own
// the actual table and ActorRef lifecycle; entries remain incarnation fenced.
define module OtpRegistry as

  pub define class Entry<Name, TargetRef> as
    pub val Name name;
    pub val TargetRef actor_ref;
    pub val int incarnation;
  end

  pub fnc entry<Name, TargetRef>(
    Name name,
    TargetRef actor_ref,
    int incarnation
  ): Result<Entry<Name, TargetRef>, String> {
    if incarnation <= 0; do
      return Err("registry incarnation must be positive");
    fi
    return Ok(new Entry<Name, TargetRef>(name, actor_ref, incarnation));
  }

  // Local comparison ONLY; an incarnation integer by itself is not an
  // actor identity or an authentication token. Do not use to authorize lookups.
  pub fnc same_incarnation(
    int expected,
    int actual
  ): bool {
    return expected > 0 && expected == actual;
  }

  // Compare the whole runtime-validated registration tuple. A generation
  // collision across distinct actor IDs or registry scopes MUST NOT alias.
  // These integer tags are policy metadata, NOT self-authenticating leases:
  // trusted actor/registry code must derive them from opaque capabilities and
  // enforce atomically before lookup, delivery, teardown or revocation.
  pub fnc registration_matches(
    int expected_scope,
    int expected_actor,
    int expected_incarnation,
    int actual_scope,
    int actual_actor,
    int actual_incarnation
  ): bool {
    return expected_scope > 0
        && expected_actor > 0
        && expected_incarnation > 0
        && expected_scope == actual_scope
        && expected_actor == actual_actor
        && expected_incarnation == actual_incarnation;
  }

  pub fnc capacity_allows(
    int registered,
    int capacity
  ): Result<bool, String> {
    if registered < 0; do
      return Err("registered count cannot be negative");
    fi
    if capacity < 1 || capacity > 65536; do
      return Err("registry capacity must be 1..65536");
    fi
    if registered > capacity; do
      return Err("registered count exceeds configured capacity");
    fi
    return Ok(registered < capacity);
  }
end
