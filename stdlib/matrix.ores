// Row-major high-precision decimal matrices.
// Dimensions are checked before products/indices to prevent i64 overflow.
// Each cell accumulation is exact: decimal add and multiply never round.
define module matrix as

  pub fnc dot(Array<decimal> left, Array<decimal> right): Result<decimal, String> {
    if left.size != right.size; do
      return Err("dot vector lengths must match");
    fi
    if left.size > 16384; do
      return Err("dot vector exceeds supported element budget");
    fi
    let decimal result = 0d;
    for (let i = 0; i < left.size; i = i + 1) {
      result = result + left.get(i) * right.get(i);
    }
    return Ok(result);
  }

  pub fnc add(int rows, int cols, Array<decimal> left, Array<decimal> right): Result<Array<decimal>, String> {
    if rows <= 0 || cols <= 0 || rows > 128 || cols > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    if left.size != rows * cols || right.size != rows * cols; do
      return Err("matrix element count does not match dimensions");
    fi
    let mut Array<decimal> result = new Array<decimal>();
    for (let i = 0; i < left.size; i = i + 1) {
      result.add(left.get(i) + right.get(i));
    }
    return Ok(result);
  }

  pub fnc transpose(int rows, int cols, Array<decimal> values): Result<Array<decimal>, String> {
    if rows <= 0 || cols <= 0 || rows > 128 || cols > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    if values.size != rows * cols; do
      return Err("matrix element count does not match dimensions");
    fi
    let mut Array<decimal> result = new Array<decimal>();
    for (let j = 0; j < cols; j = j + 1) {
      for (let i = 0; i < rows; i = i + 1) {
        result.add(values.get(i * cols + j));
      }
    }
    return Ok(result);
  }

  pub fnc multiply(int rows, int shared, int cols, Array<decimal> left, Array<decimal> right): Result<Array<decimal>, String> {
    if rows <= 0 || shared <= 0 || cols <= 0 || rows > 128 || shared > 128 || cols > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    if left.size != rows * shared || right.size != shared * cols; do
      return Err("matrix element count does not match dimensions");
    fi
    // Explicit work cap: decimal cells can contain up to a million digits.
    // Even a shape within 128x128 can otherwise require millions of
    // allocation-heavy exact multiply/add operations per guest call.
    if rows * shared * cols > 65536; do
      return Err("matrix multiplication exceeds exact-operation work budget");
    fi
    let mut Array<decimal> result = new Array<decimal>();
    for (let i = 0; i < rows; i = i + 1) {
      for (let j = 0; j < cols; j = j + 1) {
        let decimal cell = 0d;
        for (let k = 0; k < shared; k = k + 1) {
          cell = cell + left.get(i * shared + k) * right.get(k * cols + j);
        }
        result.add(cell);
      }
    }
    return Ok(result);
  }

  pub fnc identity(int dimension): Result<Array<decimal>, String> {
    if dimension <= 0 || dimension > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    let mut Array<decimal> result = new Array<decimal>();
    for (let i = 0; i < dimension; i = i + 1) {
      for (let j = 0; j < dimension; j = j + 1) {
        if i == j; do
          result.add(1d);
        else
          result.add(0d);
        fi
      }
    }
    return Ok(result);
  }

  pub fnc trace(int dimension, Array<decimal> values): Result<decimal, String> {
    if dimension <= 0 || dimension > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    if values.size != dimension * dimension; do
      return Err("matrix element count does not match dimensions");
    fi
    let decimal result = 0d;
    for (let i = 0; i < dimension; i = i + 1) {
      result = result + values.get(i * dimension + i);
    }
    return Ok(result);
  }

  // Sum-of-squares accumulates exactly. sqrt rounds once with the caller's
  // explicit precision context; no binary64 intermediate is introduced.
  pub fnc frobenius_norm(
    int rows,
    int cols,
    Array<decimal> values,
    int precision,
    String rounding
  ): Result<decimal, String> {
    if rows <= 0 || cols <= 0 || rows > 128 || cols > 128; do
      return Err("matrix dimensions must be within 1..128");
    fi
    if values.size != rows * cols; do
      return Err("matrix element count does not match dimensions");
    fi
    if precision <= 0 || precision > 4096; do
      return Err("decimal norm precision must be within 1..4096");
    fi
    let decimal squares = 0d;
    for const value of values do
      squares = squares + value * value;
    done
    return Ok(DecimalOps.sqrt(squares, precision, rounding));
  }

end
