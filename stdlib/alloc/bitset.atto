// atto.alloc/bitset: compact, actor-owned, bounded 63-bit word bitset.
// The sign bit is intentionally unused: (1 << offset) remains nonnegative
// for offsets 0..62 with AttoLang checked signed integer arithmetic.
// This module owns its Array<int>; no host language, background GC or OS API.
define module bitset as
  pub define class BitSet as
    let mut Array<int> words = new Array<int>();
    let int bits;

    pub constructor(int bit_count) {
      if bit_count < 0 || bit_count > 1048576; do
        rt fail("bitset: bit_count outside 0..1048576");
      fi
      self.bits = bit_count;
      let int word_count = (bit_count + 62) / 63;
      for (let int i = 0; i < word_count; i = i + 1) {
        self.words.add(0);
      }
    }

    pub len(): int { return self.bits; }
    pub is_empty(): bool { return self.bits == 0; }

    pub get(int index): Option<bool> {
      if index < 0 || index >= self.bits; do
        return None;
      fi
      let int word = self.words.get(index / 63);
      let int mask = 1 << (index % 63);
      return Some((word & mask) != 0);
    }

    // Returns the previous bit; all validation happens before mutation.
    pub try_set(mut self)(int index, bool value): Result<bool, String> {
      if index < 0 || index >= self.bits; do
        return Err("IndexOutOfBounds");
      fi
      let int slot = index / 63;
      let int mask = 1 << (index % 63);
      let int before = self.words.get(slot);
      let bool old = (before & mask) != 0;
      if value; do
        self.words.set(slot, before | mask);
      else
        self.words.set(slot, before & ~mask);
      fi
      return Ok(old);
    }

    pub clear_all(mut self)(): void {
      for (let int i = 0; i < self.words.size; i = i + 1) {
        self.words.set(i, 0);
      }
      return;
    }

    pub count_ones(): int {
      let mut int count = 0;
      for (let int i = 0; i < self.words.size; i = i + 1) {
        let mut int word = self.words.get(i);
        // Kernighan's bit-count loop, with no extra allocation.
        for (let int bit = 0; bit < 63; bit = bit + 1) {
          if word == 0; do
            return self.count_prefix_ones(i, count);
          fi
          word = word & (word - 1);
          count = count + 1;
        }
      }
      return count;
    }

    // count_ones already includes all prior nonzero words; no re-scan needed.
    pub count_prefix_ones(int ignored, int count): int { return count; }

    pub first_set(): Option<int> {
      for (let int i = 0; i < self.bits; i = i + 1) {
        if (self.words.get(i / 63) & (1 << (i % 63))) != 0; do
          return Some(i);
        fi
      }
      return None;
    }

    pub try_union_with(mut self)(BitSet other): Result<int, String> {
      if self.bits != other.bits; do
        return Err("LengthMismatch");
      fi
      for (let int i = 0; i < self.words.size; i = i + 1) {
        self.words.set(i, self.words.get(i) | other.words.get(i));
      }
      return Ok(self.count_ones());
    }

    pub try_intersect_with(mut self)(BitSet other): Result<int, String> {
      if self.bits != other.bits; do
        return Err("LengthMismatch");
      fi
      for (let int i = 0; i < self.words.size; i = i + 1) {
        self.words.set(i, self.words.get(i) & other.words.get(i));
      }
      return Ok(self.count_ones());
    }
  end

  pub fnc new_bitset(int length): BitSet {
    return new BitSet(length);
  }
end
