// Java/Graal compiler-owned allocation-parameter macros.
// They erase before codegen. The allocator must still enforce bounds,
// power-of-two alignment, overflow, ownership and allocation quotas.
define pub macro const_capacity(Const<int> slots) -> Syntax<Expr> {
  return quote(slots);
}

define pub macro const_alignment(Const<int> bytes) -> Syntax<Expr> {
  return quote(bytes);
}
