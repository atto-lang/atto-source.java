// atto.alloc/map: bounded, actor-owned integer-key integer-value hash map.
// This V1 intentionally avoids host Maps and unsafe pointers. It uses open
// addressing with linear probing and tombstones. Capacity is explicit and
// fixed: allocations finish in the constructor, so updates do not allocate.
// Generic K/V + user Hash/Eq will follow compiler ownership/trait admission.
define module map as
  pub define class Map as
    let mut Array<int> keys = new Array<int>();
    let mut Array<int> values = new Array<int>();
    // 0: never used; 1: occupied; 2: tombstone.
    let mut Array<int> states = new Array<int>();
    let int limit;
    let mut int count = 0;

    pub constructor(int capacity) {
      if capacity < 1 || capacity > 1048576; do
        rt fail("map: capacity outside 1..1048576");
      fi
      self.limit = capacity;
      for (let int i = 0; i < capacity; i = i + 1) {
        self.keys.add(0);
        self.values.add(0);
        self.states.add(0);
      }
    }

    pub len(): int { return self.count; }
    pub capacity(): int { return self.limit; }
    pub is_empty(): bool { return self.count == 0; }

    // Signed remainder can be negative; the adjustment makes it a valid slot.
    start_slot(int key): int {
      let mut int start = key % self.limit;
      if start < 0; do
        start = start + self.limit;
      fi
      return start;
    }

    pub get(int key): Option<int> {
      let int start = self.start_slot(key);
      for (let int probe = 0; probe < self.limit; probe = probe + 1) {
        let int slot = (start + probe) % self.limit;
        let int state = self.states.get(slot);
        if state == 0; do
          return None;
        fi
        if state == 1 && self.keys.get(slot) == key; do
          return Some(self.values.get(slot));
        fi
      }
      return None;
    }

    // Convenience for scalar callers. Use get() to distinguish a missing key
    // from a stored value equal to the supplied fallback.
    pub get_or(int key, int fallback): int {
      let int start = self.start_slot(key);
      for (let int probe = 0; probe < self.limit; probe = probe + 1) {
        let int slot = (start + probe) % self.limit;
        let int state = self.states.get(slot);
        if state == 0; do
          return fallback;
        fi
        if state == 1 && self.keys.get(slot) == key; do
          return self.values.get(slot);
        fi
      }
      return fallback;
    }

    pub contains_key(int key): bool {
      let int start = self.start_slot(key);
      for (let int probe = 0; probe < self.limit; probe = probe + 1) {
        let int slot = (start + probe) % self.limit;
        let int state = self.states.get(slot);
        if state == 0; do
          return false;
        fi
        if state == 1 && self.keys.get(slot) == key; do
          return true;
        fi
      }
      return false;
    }

    // Returns old value on replacement, None for new insertion.
    // On CapacityExceeded, no existing key/value/state has changed.
    pub try_insert(mut self)(int key, int value): Result<Option<int>, String> {
      let int start = self.start_slot(key);
      let mut int first_deleted = -1;
      for (let int probe = 0; probe < self.limit; probe = probe + 1) {
        let int slot = (start + probe) % self.limit;
        let int state = self.states.get(slot);
        if state == 1; do
          if self.keys.get(slot) == key; do
            let int previous = self.values.get(slot);
            self.values.set(slot, value);
            return Ok(Some(previous));
          fi
        else
          if state == 2; do
            if first_deleted == -1; do
              first_deleted = slot;
            fi
          else
            let mut int target = slot;
            if first_deleted != -1; do
              target = first_deleted;
            fi
            self.keys.set(target, key);
            self.values.set(target, value);
            self.states.set(target, 1);
            self.count = self.count + 1;
            return Ok(None);
          fi
        fi
      }
      if first_deleted != -1; do
        self.keys.set(first_deleted, key);
        self.values.set(first_deleted, value);
        self.states.set(first_deleted, 1);
        self.count = self.count + 1;
        return Ok(None);
      fi
      return Err("CapacityExceeded");
    }

    pub remove(mut self)(int key): Option<int> {
      let int start = self.start_slot(key);
      for (let int probe = 0; probe < self.limit; probe = probe + 1) {
        let int slot = (start + probe) % self.limit;
        let int state = self.states.get(slot);
        if state == 0; do
          return None;
        fi
        if state == 1 && self.keys.get(slot) == key; do
          let int previous = self.values.get(slot);
          // Erase the old value before releasing the slot.
          self.keys.set(slot, 0);
          self.values.set(slot, 0);
          self.states.set(slot, 2);
          self.count = self.count - 1;
          return Some(previous);
        fi
      }
      return None;
    }

    pub clear(mut self)(): void {
      for (let int i = 0; i < self.limit; i = i + 1) {
        self.keys.set(i, 0);
        self.values.set(i, 0);
        self.states.set(i, 0);
      }
      self.count = 0;
      return;
    }
  end

  pub fnc new_map(int capacity): Map {
    return new Map(capacity);
  }
end
