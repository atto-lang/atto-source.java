// Allocator-backed JSON library boundary.
//
// This module is the canonical namespace capability for allocator-backed JSON.
// Compiler-owned static lowering may bind members such as Json.stringify only
// when this exact packaged module identity is imported. Keeping the source
// facade minimal prevents owned JSON from becoming an ambient core builtin;
// typed codecs remain statically checked/generated rather than reflective.
define module Json as
end
