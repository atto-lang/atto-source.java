// Oreslang-owned core-library smoke module.
//
// Core stdlib semantics live in Oreslang source. Host Java may load this file,
// but Java interop is forbidden inside packaged std/* modules.

define module core as

  // Named key/value product. The alias has no runtime constructor or tag.
  define pub type Entry<K, V> = record { key: K, value: V };
  define pub type alias Pair<K, V> as Entry<K, V>;

  // A positional two-slot tuple intentionally differs from Entry.
  define pub type alias Two<A, B> as Tuple[A, B];

  pub fnc min_int(int left, int right): int {
    if left < right; do
      return left;
    else
      return right;
    fi
  }

  pub fnc max_int(int left, int right): int {
    if left > right; do
      return left;
    else
      return right;
    fi
  }

  pub fnc clamp_int(int value, int lower, int upper): int {
    if lower > upper; do
      return lower;
    fi

    if value < lower; do
      return lower;
    else
      if value > upper; do
        return upper;
      else
        return value;
      fi
    fi
  }

end
