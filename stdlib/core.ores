// Legacy std/core compatibility facade.
//
// The canonical implementation is ores.core/numeric. Keep only forwarding
// functions here: Java and other backends must not maintain a second version
// of min_int, max_int, or clamp_int.
import module numeric from "ores.core/numeric";

define module core as

  pub fnc min_int(int left, int right): int {
    return numeric.min_int(left, right);
  }

  pub fnc max_int(int left, int right): int {
    return numeric.max_int(left, right);
  }

  pub fnc clamp_int(int value, int lower, int upper): int {
    return numeric.clamp_int(value, lower, upper);
  }

end
