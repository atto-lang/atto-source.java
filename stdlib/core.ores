// Oreslang-owned core-library smoke module.
//
// Core stdlib semantics live in Oreslang source. Host Java may load this file,
// but Java interop is forbidden inside packaged std/* modules.

define module core as

  pub fnc min_int(int left, int right): int {
    if left < right; do
      return left;
    else
      return right;
    fi
  }

  pub fnc max_int(int left, int right): int {
    if left > right; do
      return left;
    else
      return right;
    fi
  }

  pub fnc clamp_int(int value, int lower, int upper): int {
    if lower > upper; do
      return lower;
    fi

    if value < lower; do
      return lower;
    else
      if value > upper; do
        return upper;
      else
        return value;
      fi
    fi
  }


  // Boolean collection reducers live in Oreslang source. Scalar And/Or/Xor
  // calls are compiler-lowered directly to &&, || and ^^ and do not call these.
  // Identities follow standard folds: all([])=true, any([])=false, parity([])=false.
  pub fnc all_bool(Array<bool> values): bool {
    for const value of values do
      if !value then
        return false;
      fi
    done
    return true;
  }

  pub fnc any_bool(Array<bool> values): bool {
    for const value of values do
      if value then
        return true;
      fi
    done
    return false;
  }

  pub fnc xor_parity_bool(Array<bool> values): bool {
    let bool parity = false;
    for const value of values do
      if value then
        parity = !parity;
      fi
    done
    return parity;
  }


  // The public source-level unary overloads. Arity=1 always selects the
  // List<bool> reducer; scalar arity>=2 is a compiler-owned intrinsic family.
  // Keep this module explicit until the trusted builtin-to-core link is ready.
  pub fnc And(List<bool> values): bool {
    return all_bool(values);
  }

  pub fnc Or(List<bool> values): bool {
    return any_bool(values);
  }

  pub fnc Xor(List<bool> values): bool {
    return xor_parity_bool(values);
  }

  // The standard-library scalar overloads are genuine Oreslang functions.
  // Ordinary function arguments are eager; unqualified trusted builtins use
  // compiler lowering to preserve lazy/short-circuit scalar And and Or.
  pub fnc And(bool a, bool b, rest ...bool): bool {
    if !a or !b then
      return false;
    fi
    for const value of rest do
      if !value then
        return false;
      fi
    done
    return true;
  }

  pub fnc Or(bool a, bool b, rest ...bool): bool {
    if a or b then
      return true;
    fi
    for const value of rest do
      if value then
        return true;
      fi
    done
    return false;
  }

  // XOR is binary as an operator and scalar function; collection parity uses
  // the distinct one-argument List<bool> overload.
  pub fnc Xor(bool a, bool b): bool {
    return a xor b;
  }

end
