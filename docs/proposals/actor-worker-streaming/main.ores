// Canonical Oreslang actor-class acceptance fixture.
//
// Actor source defines typed public endpoints. It does NOT define receive(),
// dispatch(), a mailbox run-loop, or a constructor. The compiler/runtime owns
// exactly one hidden mailbox dispatcher for each actor type.
//
// Important invariants:
// - Actor constructors are forbidden; initialize actor-local state with fields
//   and the reserved on_start() hook.
// - Anonymous function implementations use the slim arrow ->, never =>.
// - Ordinary classes/modules keep normal same-file lexical scope.
// - Actor classes are lexical isolation boundaries: actor code may use its own
//   members, inherited actor members, explicit imports, locals/parameters, and
//   capability-approved builtins; it cannot ambiently reach sibling file code.
// - Same-OresVM actors reuse one immutable loaded code image. Actor state,
//   mailboxes, fairness cursors and lifecycle state remain actor-owned.
// - worker.send.endpoint(...) is one-way typed mailbox dispatch.
// - worker.call.endpoint(...) is typed request/reply and returns Future<R>.
// - worker.endpoint(...) is never actor dispatch.
// - self.send(value) is actor -> parent/subscriber output, not self-mail.

define actor Worker as

  let int jobs_processed;

  on_start(): void {
    self.jobs_processed = 0;
    return;
  }

  // One-way endpoint because it returns void.
  pub run(Job job): void {
    self.jobs_processed = self.jobs_processed + 1;

    self.send("hello");
    rt cooperate;

    self.send("world");
    rt cooperate;

    self.send("!");

    process(job);
    return;
  }

  // Request/reply endpoint.
  pub status(): int {
    return self.jobs_processed;
  }

  pub shutdown(): void {
    self.end();
    return;
  }

end

pub async routine main(): void {
  const create = async || -> {
    const worker = spawn Worker();
    await worker.ready;
    return worker;
  };

  const workers = await Future.all([
    create(),
    create(),
    create()
  ]);

  workers[0].send.run(job);
  workers[1].send.run(job);
  workers[2].send.run(job);

  const count0 = await workers[0].call.status();
  const count1 = await workers[1].call.status();
  const count2 = await workers[2].call.status();

  stdio.println(count0, count1, count2);

  // Each output is tagged with actor_id + per-actor sequence.
  // Merge order across workers is nondeterministic; per-worker order is FIFO.
  const merged = Stream.merge([
    workers[0].outputs,
    workers[1].outputs,
    workers[2].outputs
  ]);

  for await const event of merged do
    stdio.println(event.actor_id, event.sequence, event.value);
  done

  workers[0].send.shutdown();
  workers[1].send.shutdown();
  workers[2].send.shutdown();

  await Future.all([
    workers[0].done,
    workers[1].done,
    workers[2].done
  ]);

  return;
}
