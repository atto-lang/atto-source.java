import class BigIntValue from '../stdlib/bigint';
import fnc from_int, mul from '../stdlib/bigint';

pub routine main(): void {
  let List<int> limbs = new List<int>();
  for (let int i = 0; i < 257; i = i + 1) {
    limbs.add(1);
  }
  val BigIntValue oversized = new BigIntValue(1, 257, limbs);
  val BigIntValue one = from_int(1);
  val BigIntValue impossible = mul(&oversized, &one);
  stdio.stdout.write(impossible.signum());
  rt fail("bigint resource policy unexpectedly admitted oversized multiplication");
}
