import class DecimalValue from '../stdlib/decimal';
import fnc from_scaled_int, div_exact from '../stdlib/decimal';

pub routine main(): void {
  val DecimalValue one = from_scaled_int(1, 0);
  val DecimalValue three = from_scaled_int(3, 0);
  val DecimalValue impossible = div_exact(&one, &three);
  stdio.stdout.write(impossible.scale);
  rt fail("decimal nonterminating exact division unexpectedly returned");
}
