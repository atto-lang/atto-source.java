// No stdio/process/Observable imports: built-in namespaces and native prelude.
pub gen* read_stdin(): Iterator<String> {
  for const line of process.stdin {
    yield line;
  }
  return;
}

pub routine main(): void {
  // Both names refer to one context-owned descriptor:
  // process.stdin === stdio.in === stdin.in.
  val ReadableStream<String> input = stdin.in.stream();
  for const line of input {
    writech stdio.out, line + "\n";
  }
  writech process.stderr, "stdin closed\n";
  return;
}
