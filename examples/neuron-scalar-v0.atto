// Canonical AttoLang protected neuron-state schema. Parser/AST fixture only.
// NOT executable until critical state-loan MIR is integrated.
define neuron actor LinearNeuron as
  state {
    let float weight;
    let float bias;
  }

  pub forward(float input): float {
    // Placeholder. Eventually read weight/bias through a critical-read loan,
    // never by treating them as self.weight/self.bias flat actor fields.
    return input;
  }

  receive(ActorMail<float> mail): void {
    self.send(self.forward(mail.value));
    self.end();
    return;
  }
end
