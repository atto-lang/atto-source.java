import fnc {actor_label} from "./actor-isolation-support.ores";

// Canonical Oreslang pre-1.0 actor state: all persistent actor-owned data
// resides in the single sealed state aggregate. No direct self.<field> access.
shared actor SharedCounter {
  state { local_count: int = 0; }

  pub fnc increment(): bool with state.read, state.write {
    using state.write(critical |s| -> {
      s.local_count = s.local_count + 1;
    });
    return true;
  }

  pub fnc local_value(): int with state.read {
    return using state.read(|s| -> s.local_count);
  }

  pub fnc actor_kind(): String {
    return actor_label(true);
  }
}

// PRIVATE actors use the same sealed state syntax but retain their isolated
// actor-owned memory and restricted access to shared-memory capabilities.
isoactor PrivateCounter {
  state { value: int = 10; }

  pub fnc increment(): void with state.read, state.write {
    using state.write(critical |s| -> { s.value = s.value + 1; });
    return;
  }

  pub fnc current(): int with state.read {
    return using state.read(|s| -> s.value);
  }

  pub fnc actor_kind(): String {
    return actor_label(false);
  }
}

// SharedMutex<T> is an explicit inter-actor resource, not an implicit mutable
// actor field. It must be acquired through its own capability and proven
// safe under the shared actor's admission policy. Private actors must not
// regain SHARED_MEMORY through imports, nested closures or state slots.
