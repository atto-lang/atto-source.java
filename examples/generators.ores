async fnc later(int value): int {
  return value;
}

gen* ids(): Iterator<int> {
  yield 10;
  yield 20;
  yield 30;
  return;
}

async gen* async_ids(): AsyncIterator<int> {
  yield await later(40);
  yield await later(50);
  return;
}

pub async fnc main(): void {
  for const id of ids() do
    stdio.println(id);
  done

  for await const id of async_ids() do
    stdio.println(id);
  done
  return;
}
