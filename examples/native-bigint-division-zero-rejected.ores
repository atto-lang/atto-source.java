import class BigIntValue, BigIntDivRem from '../stdlib/bigint';
import fnc from_int, div_rem from '../stdlib/bigint';

pub routine main(): void {
  val BigIntValue one = from_int(1);
  val BigIntValue zero = from_int(0);
  val BigIntDivRem impossible = div_rem(&one, &zero);
  stdio.stdout.write(impossible.quotient.signum());
  rt fail("bigint division by zero unexpectedly returned");
}
