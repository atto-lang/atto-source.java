define enum Light as
    Red
    Green
    Yellow
end

fnc next(Light value): Light {
    return match value over
        on Light.Red -> { return Light.Green; }
        on Light.Green -> { return Light.Yellow; }
        on Light.Yellow -> { return Light.Red; }
    end
}

pub fnc main(): void {
    stdio.println(next(Light.Red) == Light.Green);
    stdio.println(next(Light.Green) == Light.Yellow);
    stdio.println(next(Light.Yellow) == Light.Red);
    return;
}
