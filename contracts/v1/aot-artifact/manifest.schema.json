{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oreslang:aot-artifact:v1",
  "title": "Oreslang AOT artifact admission manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler",
    "source_sha256",
    "expanded_sha256",
    "generated_ast_sha256",
    "artifact",
    "policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "oreslang.aot-artifact.v1"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "version",
        "git_commit"
      ],
      "properties": {
        "backend": {
          "enum": [
            "java-graalvm",
            "llvm"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expanded_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_ast_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "size_bytes",
        "format",
        "target_triple",
        "abi"
      ],
      "properties": {
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "native-executable",
            "static-library",
            "wasm-module"
          ]
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_macro_expansion",
        "runtime_annotation_generation",
        "runtime_guest_compilation",
        "required_capabilities"
      ],
      "properties": {
        "runtime_macro_expansion": {
          "const": false
        },
        "runtime_annotation_generation": {
          "const": false
        },
        "runtime_guest_compilation": {
          "const": false
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_id",
        "signature"
      ],
      "properties": {
        "builder_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "value_base64"
          ],
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "value_base64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            }
          }
        }
      }
    }
  }
}
