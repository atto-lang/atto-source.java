{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ores-truffle-oreslang.github.io/contracts/v1/actor-cleanup/cleanup.schema.json",
  "title": "ActorCleanupTransition",
  "description": "Data-only conformance/telemetry record. Authorizes no CONTROL ticket by itself; runtime requires exact host-issued identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "actor_id",
    "incarnation",
    "source_task_id",
    "receive_generation",
    "phase",
    "ticket_role",
    "outcome"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "incarnation": {
      "type": "string",
      "minLength": 1
    },
    "source_task_id": {
      "type": "integer",
      "minimum": 1
    },
    "receive_generation": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "running",
        "cleanup_requested",
        "cleanup_pending",
        "terminal"
      ]
    },
    "ticket_role": {
      "enum": [
        "source_task",
        "source_completion"
      ]
    },
    "outcome": {
      "enum": [
        "pending",
        "success",
        "incomplete",
        "failed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "terminal"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "success",
              "incomplete",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "success"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "terminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "cleanup_requested",
              "cleanup_pending"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "pending"
          }
        }
      }
    }
  ]
}
