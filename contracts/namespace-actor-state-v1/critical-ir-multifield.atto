use namespace foo;

// Staged, compiler-internal typed critical IR fixture. This is not yet
// a source-executable Graal guest or a RabbitMQ broker.
declare actor Probe;

define state on actor Probe as {
    let int received: 0;
    let int budget: 10000;
}

external mtd (Probe p) init(): void {
    return;
}

critical mtd (Probe p) add(int delta): void {
    p.state.received = p.state.received + delta;
}

critical mtd (Probe p) debit(int delta): void {
    p.state.budget = p.state.budget - delta;
}

external mtd (Probe p) receive(ActorMail<int> mail): void {
    p.add(mail.value);
    p.debit(mail.value);
    return;
}
