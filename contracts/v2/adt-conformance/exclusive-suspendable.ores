pub async routine main(): void {
    match true
        true -> { stdio.println("true"); }
        false -> { stdio.println("wrong"); }
    end
    match 5
        x when x < 0 -> { stdio.println("negative"); }
        x when x >= 0 -> { stdio.println("positive"); }
        else -> { stdio.println("fallback"); }
    end
    match false
        true -> { stdio.println("wrong"); }
        else -> { stdio.println("fallback"); }
    end
    return;
}
